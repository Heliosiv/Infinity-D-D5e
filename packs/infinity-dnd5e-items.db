"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.qcYitWoSMTnKkzM1","folderPathKey":"spells/level-6","folderLabels":["Spells","Level 6"],"primaryMode":"usable","activityTypes":["heal"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.specialty","lootWeight":0.14,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":7500,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-6","sectionLabel":"Level 6","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-6","label":"Level 6","sort":4160}],"pathLabels":["Spells","Level 6"],"pathKeys":["spells","level-6"],"pathKey":"spells/level-6"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["heal"],"primaryActivityType":"heal","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/heal-qcYitWoSMTnKkzM1","plannedPath":"assets/item-art/unique/heal-qcYitWoSMTnKkzM1.webp","fallbackIcon":"icons/magic/life/heart-cross-strong-flame-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/life/heart-cross-strong-flame-green.webp","effects":[],"folder":"0pdesvXqKd55VOh2","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","