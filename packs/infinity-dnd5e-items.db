spell","tier":"tier.t3","rarityNormalized":"rare","gpValue":5000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.Pyzmm8R7rVsNAPsd","folderPathKey":"spells/level-5","folderLabels":["Spells","Level 5"],"primaryMode":"usable","activityTypes":["heal"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.336,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":2500,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-5","sectionLabel":"Level 5","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-5","label":"Level 5","sort":4150}],"pathLabels":["Spells","Level 5"],"pathKeys":["spells","level-5"],"pathKey":"spells/level-5"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["heal"],"primaryActivityType":"heal","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/mass-cure-wounds-Pyzmm8R7rVsNAPsd","plannedPath":"assets/item-art/unique/mass-cure-wounds-Pyzmm8R7rVsNAPsd.webp","fallbackIcon":"icons/magic/life/heart-cross-strong-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/life/heart-cross-strong-green.webp","effects":[],"folder":"bG9QTayc46rfNkv2","_stats":{"duplicateSou