ffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"dnd5e":{"riders":{"activity":[],"effect":[]}},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.spell-scrolls","folder.section.spell-scrolls","foundryType.consumable","loot","loot.scroll","magic.bonus","merchant.arcana","merchant.consumable","merchant.loot","merchant.magic","merchant.scroll","merchant.spell","price.gp","prop.material","prop.somatic","prop.vocal","rarity.very-rare","sale.specialty","sale.standard","source.class.curated","source.class.generated","source.curated","source.dnd5e.spells","source.infinity-dnd5e.spell-scrolls","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.level.6","spell.school.evo","subtype.scroll","tier.t4","value.high","value.v4","weight.none"],"lootType":"loot.scroll","tier":"tier.t4","rarityNormalized":"very-rare","gpValue":1280,"valueBand":"value.v4","taggedAt":"2026-05-30T00:00:00.000Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.4smlOvpF5AQHcyg1","folderPathKey":"spells/spell-scrolls","folderLabels":["Spells","Spell Scrolls"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"spell-scroll-template","priceDenomination":"gp","merchantCategories":["arcana","consumable","loot","magic","scroll","spell"],"saleLiquidity":"sale.standard","lootWeight":0.007580645161,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":640,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"spell-scrolls","sectionLabel":"Spell Scrolls","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"spell-scrolls","label":"Spell Scrolls","sort":4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-sealed-red-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"4smlOvpF5AQHcyg1","sourceSpellName":"Contingency","sourceSpellUuid":"Compendium.dnd5e.spells.Item.4smlOvpF5AQHcyg1","spellLevel":6,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"4smlOvpF5AQHcyg1","spellName":"Contingency","spellLevel":6,"school":"evo","sourceUuid":"Compendium.dnd5e.spells.Item.4smlOvpF5AQHcyg1"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.4smlOvpF5AQHcyg1","duplicateSource":"4smlOvpF5AQHcyg1","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"O6p0fTth1qctNDx9","name":"Spell Scroll: Create Undead","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-sealed-red-green.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"O6p0fTth1qctNDx9\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Create Undead</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Create Undead (6th-level nec).</p><hr /><p>You can cast this spell only at night. Choose up to three corpses of Medium or Small humanoids within range. Each corpse becomes a ghoul under your control. (The DM has game statistics for these creatures.)</p><p>As a bonus action on each of your turns, you can mentally command any creature you animated with this spell if the creature is within 120 feet of you (if you control multiple creatures, you can command any or all of them at the same time, issuing the same command to each one). You decide what action the creature will take and where it will move during its next turn, or you can issue a general command, such as to guard a particular chamber or corridor. If you issue no commands, the creature only defends itself against hostile creatures. Once given an order, the creature continues to follow it until its task is complete.</p><p>The creature is under your control for 24 hours, after which it stops obeying any command you have given it. To maintain control of the creature for another 24 hours, you must cast this spell on the creature before the current 24-hour period ends. This use of the spell reasserts your control over up to three creatures you have animated with this spell, rather than animating new ones.</p><p><strong>Higher Levels. </strong>When you cast this spell using a 7th-level spell slot, you can animate or reassert control over four ghouls. When you cast this spell using an 8th-level spell slot, you can animate or reassert control over five ghouls or two ghasts or wights. When you cast this spell using a 9th-level spell slot, you can animate or reassert control over six ghouls, three ghasts or wights, or two mummies.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Very Rare</li><li>Value: 1,280 gp</li><li>1 use(s)</li><li>Stored spell: Create Undead</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Create Undead</strong></p><p>A consumable spell scroll containing Create Undead, a 6th-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":1280,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"veryRare","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"O6p0fTth1qctNDx9\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"summon","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster's spell list."},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Create Undead from a spell scroll."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"bonuses":{"ac":"","hd":"","hp":"","attackDamage":"","saveDamage":"","healing":""},"creatureSizes":[],"creatureTypes":[],"match":{"attacks":false,"proficiency":false,"saves":false},"profiles":[{"count":"@item.level - 6","name":"","_id":"GGQa2fXx4sJFOhCv","uuid":"Compendium.dnd5e.monsters.Actor.IyIybE5t2adMEVUM","level":{"min":8,"max":null},"types":[]},{"count":"@item.level - 3","name":"","_id":"439tNP7qngefOmVd","uuid":"Compendium.dnd5e.monsters.Actor.OBujQLLPSmlJiZnL","level":{"min":null,"max":null},"types":[]},{"count":"@item.level - 7","name":"","_id":"8377f4szK4aEYLqD","uuid":"Compendium.dnd5e.monsters.Actor.t8WYD7ak07X7xpx8","level":{"min":9,"max":null},"types":[]},{"count":"@item.level - 6","name":"","_id":"1wXs9fpxffiMlT1j","uuid":"Compendium.dnd5e.monsters.Actor.rbyp54px2D0ql4QK","level":{"min":8,"max":null},"types":[]}],"summon":{"identifier":"","mode":"","pr