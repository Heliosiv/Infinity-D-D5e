{"_id":"dG7iFak1YH1nXRpC","name":"Vicious Battleaxe","type":"weapon","img":"icons/weapons/polearms/halberd-crescent-engraved-steel.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"dG7iFak1YH1nXRpC\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Vicious Battleaxe</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A stout crescent blade mounted on a thick shaft wrapped in a sturdy grip. This axe is large enough to be wielded with two hands and is adorned with spikes upon the back-side of the blade and the top of the shaft.</p>\n<p>When you roll a 20 on your attack roll with this magic weapon, your critical hit deals an extra 2d6 damage of the weapon's type.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Weapon, Battleaxe</li><li>Rarity: Rare</li><li>Value: 750 gp</li><li>Activities: Attack</li></ul></aside></section>","chat":"<p><strong>Vicious Battleaxe</strong></p><p>A stout crescent blade mounted on a thick shaft wrapped in a sturdy grip. This axe is large enough to be wielded with two hands and is adorned with spikes upon the back-side of...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":4,"units":"lb"},"price":{"value":750,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"range":{"value":null,"long":null,"units":"ft","reach":null},"uses":{"max":"","recovery":[],"spent":0},"damage":{"versatile":{"number":1,"denomination":10,"bonus":"","types":[],"custom":{"enabled":false,"formula":""},"scaling":{"mode":"","number":null,"formula":""}},"base":{"number":1,"denomination":8,"bonus":"","types":["slashing"],"custom":{"enab