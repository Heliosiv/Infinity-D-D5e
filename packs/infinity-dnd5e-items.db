ane Consumables"],"pathKeys":["consumables","arcane-consumables"],"pathKey":"consumables/arcane-consumables"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":["space"],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-consumables-arcane-consumables","plannedPath":"assets/item-art/shared/consumable-consumables-arcane-consumables.webp","fallbackIcon":"icons/commodities/biological/legs-insect-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.s2kQs21J3cFg7ZSs","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"s4fR8bxQGSt4wbH7","name":"Cube of Force","type":"consumable","img":"icons/sundries/gaming/dice-runed-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"s4fR8bxQGSt4wbH7\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Cube of Force</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item, (requires attunement)</em></p>\n<p>This cube is about an inch across. Each face has a distinct marking on it that can be pressed. The cube starts with 36 charges, and it regains 1d20 expended charges daily at dawn.</p>\n<p>You can use an action to press one of the cube's faces, expending a number of charges based on the chosen face, as shown in the Cube of Force Faces table. Each face has a different effect. If the cube has insufficient charges remaining, nothing happens. Otherwise, a barrier of invisible force springs into existence, forming a cube 15 feet on a side. The barrier is centered on you, moves with you, and lasts for 1 minute, until you use an action to press the cube's sixth face, or the cube runs out of charges. You can change the barrier's effect by pressing a different face of the cube and expending the requisite number of charges, resetting the duration.</p>\n<p>If your movement causes the barrier to come into contact with a solid object that can't pass through the cube, you can't move any closer to that object as long as the barrier remains.</p>\n<table border=\"1\">\n<tbody>\n<tr>\n<td><strong>Face</strong></td>\n<td><strong>Charges</strong></td>\n<td><strong>Effect</strong></td>\n</tr>\n<tr>\n<td>1</td>\n<td>1</td>\n<td>Gases, wind, and fog can't pass through the barrier.</td>\n</tr>\n<tr>\n<td>2</td>\n<td>2</td>\n<td>Nonliving matter can't pass through the barrier. Walls, floors, and ceilings can pass through at your discretion.</td>\n</tr>\n<tr>\n<td>3</td>\n<td>3</td>\n<td>Living matter can't pass through the barrier.</td>\n</tr>\n<tr>\n<td>4</td>\n<td>4</td>\n<td>Spell effects can't pass through the barrier.</td>\n</tr>\n<tr>\n<td>5</td>\n<td>5</td>\n<td>Nothing can pass through the barrier. Walls, floors, and ceilings can pass through at your discretion.</td>\n</tr>\n<tr>\n<td>6</td>\n<td>0</td>\n<td>The barrier deactivates.</td>\n</tr>\n</tbody>\n</table>\n<p>The cube loses charges when the barrier is targeted by certain spells or comes into contact with certain spell or magic item effects, as shown in the table below.</p>\n<table border=\"1\">\n<tbody>\n<tr>\n<td><strong>Spell or Item</strong></td>\n<td><strong>Charges Lost</strong></td>\n</tr>\n<tr>\n<td>@Compendium[dnd5e.spells.HBHbOGKNVVprSlwn]{Disintegrate}</td>\n<td>1d12</td>\n</tr>\n<tr>\n<td>@Compendium[dnd5e.items.t7GfyRp3dB3lqS9i]{Horn of Blasting}</td>\n<td>1d10</td>\n</tr>\n<tr>\n<td>@Compendium[dnd5e.spells.d9MwcXi7Il3HROXd]{Passwall}</td>\n<td>1d6</td>\n</tr>\n<tr>\n<td>@Compendium[dnd5e.spells.eGMhwmuleAM46C6L]{Prismatic Spray}</td>\n<td>1d20</td>\n</tr>\n<tr>\n<td>@Compendium[dnd5e.spells.X3DrXgxjwI2dvkD6]{Wall of Fire}</td>\n<td>1d4</td>\n</tr>\n</tbody>\n</table></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Cube</li><li>Rarity: Rare</li><li>Value: 16,000 gp</li><li>Requires attunement</li><li>36 use(s), recovers lr</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Cube of Force</strong></p><p>Wondrous item, (requires attunement) This cube is about an inch across. Each face has a distinct marking on it that can be pressed. The cube starts with 36 charges, and it regai...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0.1,"units":"lb"},"price":{"value":16000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"uses":{"max":"36","recovery":[{"period":"lr","type":"formula","formula":"1d20"}],"autoDestroy":false,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"s4fR8bxQGSt4wbH7\"><p><em>A worked cube awaiting identification.</em></p><p>This worked cube is described by craftsmanship, condition, and hidden marks. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Worked Cube</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"trinket","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"Must have enough charges for the face pressed otherwise the Action is lost.","override":false},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Cube of Force."},"duration":{"concentration":false,"value":"1","units":"minute","special":"","override":false},"effects":[],"range":{"units":"self","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"cube","size":"15","width":"","height":"","units":"ft"},"affects":{"count":"","type":"","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"roll":{"formula":"","name":"","prompt":false,"visible":false},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","macroData":{"name":