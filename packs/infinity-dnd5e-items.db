riceDenomination":"gp","merchantCategories":["tool","tools"],"saleLiquidity":"sale.standard","lootWeight":1.2,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":17.5,"folder":{"schema":"po-loot-folder-v1","familyKey":"tools","familyLabel":"Tools","sectionKey":"musical-instruments","sectionLabel":"Musical Instruments","leafKey":"","leafLabel":"","path":[{"key":"tools","label":"Tools","sort":5000},{"key":"musical-instruments","label":"Musical Instruments","sort":5200}],"pathLabels":["Tools","Musical Instruments"],"pathKeys":["tools","musical-instruments"],"pathKey":"tools/musical-instruments"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["check"],"primaryActivityType":"check","activationTypes":["special"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/tool-lute","plannedPath":"assets/item-art/shared/tool-lute.webp","fallbackIcon":"icons/tools/instruments/lute-gold-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.qBydtUUIkv520DT7","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"qGH7YqWhi0tHisMi","name":"Luck Blade Rapier","type":"weapon","img":"icons/magic/light/projectile-beam-yellow.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"qGH7YqWhi0tHisMi\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Luck Blade Rapier</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>(Requires attunement)</em></p>\n<p>You gain a +1 bonus to attack and damage rolls made with this magic weapon. While the sword is on your person, you also gain a +1 bonus to saving throws.</p>\n<p><strong>Luck</strong>. If the sword is on your person, you can call on its luck (no action required) to reroll one attack roll, ability check, or saving throw you dislike. You must use the second roll. This property can't be used again until the next dawn.</p>\n<p><strong>Wish</strong>. The sword has 1d4 – 1 charges. While holding it, you can use an action to expend 1 charge and cast the @Compendium[dnd5e.spells.3okM6Gn63zzEULkz]{Wish} spell from it. This property can't be used again until the next dawn. The sword loses this property if it has no charges.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Weapon, Rapier</li><li>Rarity: Legendary</li><li>Value: 210,000 gp</li><li>Requires attunement</li><li>3 use(s)</li><li>Activities: Attack</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Luck Blade Rapier</strong></p><p>(Requires attunement) You gain a +1 bonus to attack and damage rolls made with this magic weapon. While the sword is on your person, you also gain a +1 bonus to saving throws. L...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":3,"units":"lb"}