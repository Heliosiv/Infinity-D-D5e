ootWeight":0.336,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":2500,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-5","sectionLabel":"Level 5","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-5","label":"Level 5","sort":4150}],"pathLabels":["Spells","Level 5"],"pathKeys":["spells","level-5"],"pathKey":"spells/level-5"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/scrying-fVbCxFRaORalHB20","plannedPath":"assets/item-art/unique/scrying-fVbCxFRaORalHB20.webp","fallbackIcon":"icons/magic/perception/eye-ringed-glow-angry-large-teal.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/perception/eye-ringed-glow-angry-large-teal.webp","effects":[],"folder":"bG9QTayc46rfNkv2","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037362252,"modifiedTime":1725992721833,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"rare"}
{"_id":"fkREcytuZ8sngWtC","name":"Planar Ally","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"fkREcytuZ8sngWtC\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Planar Ally</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You beseech an otherworldly entity for aid. The being must be known to you: a god, a Primordial, a demon prince, or some other being of cosmic power. That entity sends a Celestial, an elemental, or a fiend loyal to it to aid you, making the creature appear in an unoccupied space within range. If you know a specific creature's name, you can speak that name when you cast this spell to request that creature, though you might get a different creature anyway (DM's choice).</p><p>When the creature appears, it is under no Compulsion to behave in any particular way. You can ask the creature to perform a service in exchange for payment, but it isn't obliged to do so. The requested task could range from simple (fly us across the chasm, or help us fight a battle) to complex (spy on our enemies, or protect us during our foray into the dungeon). You must be able to communicate with the creature to bargain for its Services.</p><p>Payment can take a variety of forms. A Celestial might require a sizable donation of gold or Magic Items to an allied Temple, while a fiend might demand a living sacrifice or a gift of Treasure. Some creatures might exchange their service for a quest undertaken by you.</p><p>As a rule of thumb, a task that can be measured in minutes requires a payment worth 100 gp per minute. A task measured in hours requires 1,000 gp per hour. And a task measured in days (up to 10 days) requires 10,000 gp per day. The DM can adjust these payments based on the circumstances under which you cast the spell. If the task is aligned with the creature's ethos, the payment might be halved or even waived. Nonhazardous tasks typically require only half the suggested payment, while especially dangerous tasks might require a greater gift. Creatures rarely accept tasks that seem suicidal.</p><p>After the creature completes the task, or when the agreed-upon Duration of service expires, the creature returns to its home plane after reporting back to you, if appropriate to the task and if possible. If you are unable to agree on a price for the creature's service, the creature immediately returns to its home plane.</p><p>A creature enlisted to join your group counts as a member of it, receiving a full share of Experience Points awarded.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Planar Ally</li><li>Rarity: Very Rare</li><li>Value: 15,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Planar Ally</strong></p><p>You beseech an otherworldly entity for aid. The being must be known to you: a god, a Primordial, a demon prince, or some other being of cosmic power. That entity sends a Celesti...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"minute","condition":"","value":10},"duration":{"value":"","units":"inst"},"target":{"affects":{"type":"space","choice":false},"template":{"units":"any","contiguous":false}},"range":{"value":"60","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":6,"school":"con","materials":{"value":"","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Planar Ally."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"planar-ally","price":{"value":15000,"denomination":"gp"},"rarity":"veryRare","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"fkREcytuZ8sngWtC\"><p><em>An inscribed spell formula awaiting identification.</em></p><p>This inscribed spell formula is described by craftsmanship, condition, and hidden marks. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.fkREcytuZ8sngWtC"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-6","folder.section.level-6","foundryType.spell","loot","loot.spell","magic.bonus","merchant.arcana","merchant.curio","merchant.magic","merchant.spell","price.gp","prop.somatic","prop.vocal","rarity.very-rare","sale.specialty","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.level.6","spell.school.con","tier.t4","value.high","value.v5","weight.none"],"lootType":"loot.spell","tier":"tier.t4","rarityNormalized":"very-rare","gpValue":15000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.fkREcytuZ8sngWtC","folderPathKey":"spells/level-6","folderLabels":["Spells","Level 6"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","curio","magic","spell"],"saleLiquidity":"sale.specialty","lootWeight":0.14,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":7500,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-6","sectionLabel":"Level 6","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-6","label":"Level 6","sort":4160}],"pathLabels":["Spells","Level 6"],"pathKeys":["spells","level-6"],"pathKey":"spells/level-6"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/planar-ally-fkREcytuZ8sngWtC","plannedPath":"assets/item-art/unique/planar-ally-fkREcytuZ8sngWtC.webp","fallbackIcon":"icons/magic/symbols/runes-star-pentagon-magenta.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/symbols/runes-star-pentagon-magenta.webp","effects":[],"folder":"0pdesvXqKd55VOh2","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037362319,"modifiedTime":1725992721868,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"very-rare"}
{"_id":"fzZnVKLmBMo2f5up","name":"Wall of Ice","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"fzZnVKLmBMo2f5up\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Wall of Ice</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You create a wall of ice on a solid surface within range. You can form it into a hemispherical dome or a sphere with a radius of up to 10 feet, or you can shape a flat surface made up of ten 10-foot-square panels. Each panel must be contiguous with another panel. In any form, the wall is 1 foot thick and lasts for the Duration.</p><p>If the wall cuts through a creature's space when it appears, the creature within its area is pushed to one side of the wall and must make a Dexterity saving throw. On a failed save, the creature takes 10d6 cold damage, or half as much damage on a successful save.</p><p>The wall is an object that can be damaged and thus breached. It has AC 12 and 30 hit points per 10-foot section, and it is vulnerable to fire damage. Reducing a 10-foot section of wall to 0 hit points destroys it and leaves behind a sheet of frigid air in the space the wall occupied. A creature moving through the sheet of frigid air for the first time on a turn must make a Constitution saving throw. That creature takes 5d6 cold damage on a failed save, or half as much damage on a successful one.</p><p>At Higher Levels. When you cast this spell using a spell slot of 7th level or higher, the damage the wall deals when it appears increases by 2d6, and the damage from passing through the sheet of frigid air increases by 1d6, for each slot level above 6th.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Wall Of Ice</li><li>Rarity: Very Rare</li><li>Value: 15,000 gp</li><li>Activities: Save, Damage</li></ul></aside></section>","chat":"<p><strong>Wall of Ice</strong></p><p>You create a wall of ice on a solid surface within range. You can form it into a hemispherical dome or a sphere with a radius of up to 10 feet, or you can shape a flat surface m...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"wall","size":"100","contiguous":false}},"range":{"value":"120","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":6,"school":"evo","materials":{"value":"A small piece of quartz","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material","concentration"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Wall of Ice; resolve the target save."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"damage":{"onSave":"half","parts":[{"number":10,"denomination":6,"bonus":"","types":["cold"],"custom":{"enabled":false,"formula":""},"scaling":{"mode":"whole","number":2,"formula":""}}]},"save":{"ability":"dex","dc":{"calculation":"spellcasting","formula":""}},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditio