{"_id":"JyYwliYiWEw2g0yJ","name":"Ring of Feather Falling","type":"equipment","img":"icons/equipment/finger/ring-cabochon-silver-gold-red.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"JyYwliYiWEw2g0yJ\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Ring of Feather Falling</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>(Requires attunement)</em></p>\n<p>When you fall while wearing this ring, you descend 60 feet per round and take no damage from falling.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Ring</li><li>Rarity: Rare</li><li>Value: 2,000 gp</li><li>Requires attunement</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Ring of Feather Falling</strong></p><p>(Requires attunement) When you fall while wearing this ring, you descend 60 feet per round and take no damage from falling.</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":2000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"JyYwliYiWEw2g0yJ\"><p><em>A ring equipment awaiting identification.</em></p><p>This ring equipment is described by facete