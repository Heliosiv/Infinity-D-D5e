ier.t2","value.v3","weight.none"],"lootType":"loot.spell","tier":"tier.t2","rarityNormalized":"uncommon","gpValue":250,"valueBand":"value.v3","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.5eh2HFbS13078Y3H","folderPathKey":"spells/level-2","folderLabels":["Spells","Level 2"],"primaryMode":"usable","activityTypes":["summon"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.9,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":125,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-2","sectionLabel":"Level 2","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-2","label":"Level 2","sort":4120}],"pathLabels":["Spells","Level 2"],"pathKeys":["spells","level-2"],"pathKey":"spells/level-2"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["summon"],"primaryActivityType":"summon","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-con-level-2","plannedPath":"assets/item-art/shared/spell-con-level-2.webp","fallbackIcon":"icons/magic/nature/wolf-paw-glow-teal-blue.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/nature/wolf-paw-glow-teal-blue.webp","effects":[],"folder":"Qi4Se3we69ukl