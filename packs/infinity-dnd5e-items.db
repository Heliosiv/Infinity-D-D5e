storage","label":"Storage Gear","sort":6110}],"pathLabels":["Sundries","Containers & Packs","Storage Gear"],"pathKeys":["sundries","containers-packs","storage"],"pathKey":"sundries/containers-packs/storage"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/container-container","plannedPath":"assets/item-art/shared/container-container.webp","fallbackIcon":"icons/containers/bags/pouch-leather-pink.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.aDHRuUs29SrumWfq","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"TZggpdbOYqOCG7mY","name":"Alchemy Jug","type":"consumable","img":"icons/containers/kitchenware/jug-terracotta-orange.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"TZggpdbOYqOCG7mY\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Alchemy Jug</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><div><em>Wondrous item</em></div>\n<div> </div>\n<div>This ceramic jug appears to be able to hold a gallon of liquid and weighs 12 pounds whether full or empty. Sloshing sounds can be heard from within the jug when it is shaken, even if the jug is empty.</div>\n<div> </div>\n<div>You can use an action and name one liquid from the table below to cause the jug to produce the chosen liquid. Afterward, you can uncork the jug as an action and pour that liquid out, up to 2 gallons per minute. The maximum amount of liquid the jug can produce depends on the liquid you named. </div>\n<div> </div>\n<div>Once the jug starts producing a liquid, it can't produce a different one, or more of one that has reached its maximum, until the next dawn. </div>\n<div><br />\n<table>\n<tbody>\n<tr>\n<th>Liquid</th>\n<th>Max Amount</th>\n</tr>\n<tr>\n<td>Acid</td>\n<td>8 ounces</td>\n</tr>\n<tr>\n<td>Basic poison</td>\n<td>1/2 ounce</td>\n</tr>\n<tr>\n<td>Beer</td>\n<td>4 gallons</td>\n</tr>\n<tr>\n<td>Honey</td>\n<td>1 gallon</td>\n</tr>\n<tr>\n<td>Mayonnaise</td>\n<td>2 gallons</td>\n</tr>\n<tr>\n<td>Oil</td>\n<td>1 quart</td>\n</tr>\n<tr>\n<td>Vinegar</td>\n<td>2 gallons</td>\n</tr>\n<tr>\n<td>Water, fresh</td>\n<td>8 gallons</td>\n</tr>\n<tr>\n<td>Water, salt</td>\n<td>12 gallons</td>\n</tr>\n<tr>\n<td>Wine</td>\n<td>1 gallon</td>\n</tr>\n</tbody>\n</table>\n</div></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Trinket</li><li>Rarity: Uncommon</li><li>Value: 2,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Alchemy Jug</strong></p><p>Wondrous item This ceramic jug appears to be able to hold a gallon of liquid and weighs 12 pounds whether full or empty. Sloshing sounds can be heard from within the jug when it...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":12,"units":"lb"},"price":{"value":2000,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"uses":{"max":"","recovery":[],"autoDestroy":false,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"TZggpdbOYqOCG7mY\"><p><em>A trinket awaiting identification.</em></p><p>This trinket is described by craftsmanship, condition, and hidden marks. Small details imply more value than a quick glance can confirm.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Trinket</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"trinket","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Alchemy Jug."},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[],"range":{"units":"self","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","