{"folder":"9LJujCqZ6IrLO0Ai","name":"Sapphire","type":"loot","_id":"MgBcW83MBYjAbuLZ","img":"icons/commodities/gems/gem-oval-blue.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"MgBcW83MBYjAbuLZ\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Sapphire</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A blue sapphire with a cool, disciplined brilliance and a cut that favors clarity over flash.</p><p>It carries the polished authority of royal jewelry, temple offerings, and private fortunes meant to look respectable.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Treasure</li><li>Value: 250 gp</li></ul></aside></section>","chat":"<p><strong>Sapphire</strong></p><p>A blue sapphire with a cool, disciplined brilliance and a cut that favors clarity over flash. It carries the polished authority of royal jewelry, temple offerings, and private f...</p>"},"source":{"rules":"2014","revision":1},"quantity":1,"weight":{"value":0.1,"units":"lb"},"price":{"value":250,"denomination":"gp"},"rarity":"","identified":true,"type":{"value":"","subtype":""},"identifier":"sapphire","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"MgBcW83MBYjAbuLZ\"><p><em>A cut stone awaiting identification.</em></p><p>This cut stone is described by faceted surfaces and reflected light. Its practical use is apparent, but exact value and special details still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Cut Stone</li><li>Inspection cues: faceted surfaces and reflected light</li><li>Identification state: Unidentified</li></ul></section>"},"container":null,"properties":[],"activities":{}},"effects":[],"flags":{"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"core":{"sourceId":"Compendium.infinity-dnd5e.infinity-dnd5e-items.Item.MgBcW83MBYjAbuLZ"},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.sundries","folder.leaf.gemstones","folder.path.sundries.gems-jewelry.gemstones","folder.section.gems-jewelry","foundryType.loot","loot","loot.loot","loot.variable","loot.variable.gem","merchant.gem","merchant.loot","merchant.luxury","merchant.treasure","price.gp","rarity.none","sale.luxury","source.class.curated","source.curated","source.party.operations.party.operations.loot.manifest","source.policy.normal","tier.t2","treasure.gem","value.v3","weight.light"],"lootType":"loot.loot","tier":"tier.t2","rarityNormalized":"","gpValue":250,"valueBand":"value.v3","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"loot","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.party-operations.party-operations-loot-manifest.Item.MgBcW83MBYjAbuLZ","folderPathKey":"sundries/gems-jewelry/gemstones","folderLabels":["Sundries","Gems & Jewelry","Gemstones"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["gem","loot","luxury","treasure"],"saleLiquidity":"sale.luxury","lootWeight":1.44,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":125,"folder":{"schema":"po-loot-folder-v1","familyKey":"sundries","familyLabel":"Sundries","sectionKey":"gems-jewelry","sectionLabel":"Gems & Jewelry","leafKey":"gemstones","leafLabel":"Gemstones","path":[{"key":"sundries","label":"Sundries","sort":6000},{"key":"gems-jewelry","label":"Gems & Jewelry","sort":6200},{"key":"gemstones","label":"Gemstones","sort":6210}],"pathLabels":["Sundries","Gems & Jewelry","Gemstones"],"pathKeys":["sundries","gems-jewelry","gemstones"],"pathKey":"sundries/gems-jewelry/gemstones"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"variableTreasureKind":"gem","sourceClass":"curated","sourcePolicy":"normal","curationScore":9,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/gemstone-blue-gemstone","plannedPath":"assets/item-art/shared/gemstone-blue-gemstone.webp","fallbackIcon":"icons/commodities/gems/gem-oval-blue.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3},"variableTreasureKind":"gem"}
{"_id":"Minr6xegwoHFvAjG","name":"Figurine of Wondrous Power (Golden Lions)","type":"consumable","img":"icons/commodities/claws/claw-bear-brown-grey.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"Minr6xegwoHFvAjG\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Figurine of Wondrous Power (Golden Lions)</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item</em></p>\n<p>A <em>figurine of wondrous power</em> is a statuette of a beast small enough to fit in a pocket. If you use an action to speak the command word and throw the figurine to a point on the ground within 60 feet of you, the figurine becomes a living creature. If the space where the creature would appear is occupied by other creatures or objects, or if there isn't enough space for the creature, the figurine doesn't become a creature.</p>\n<p>The creature is friendly to you and your companions. It understands your languages and obeys your spoken commands. If you issue no commands, the creature defends itself but takes no other actions.</p>\n<p>The creature exists for a duration specific to each figurine. At the end of the duration, the creature reverts to its figurine form. It reverts to a figurine early if it drops to 0 hit points or if you use an action to speak the command word again while touching it. When the creature becomes a figurine again, its property can't be used again until a certain amount of time has passed, as specified in the figurine's description.</p>\n<p><strong>Golden Lions</strong>. These gold statuettes of lions are always created in pairs. You can use one figurine or both simultaneously. Each can become a @Compendium[dnd5e.monsters.hjhERRzafCiFFVLA]{Lion} for up to 1 hour. Once a lion has been used, it can't be used again until 7 days have passed.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Figurine</li><li>Rarity: Rare</li><li>Value: 1,200 gp</li><li>2 use(s)</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Figurine of Wondrous Power (Golden Lions)</strong></p><p>Wondrous item A figurine of wondrous power is a statuette of a beast small enough to fit in a pocket. If you use an action to speak the command word and throw the figurine to a...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0.1,"units":"lb"},"price":{"value":1200,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"uses":{"max":"2","recovery":[],"autoDestroy":false,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"Minr6xegwoHFvAjG\"><p><em>A small figure awaiting identification.</em></p><p>This small figure is described by craftsmanship, condition, and hidden marks. Small details imply more value than a quick glance can confirm.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Small Figure</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"trinket","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFla