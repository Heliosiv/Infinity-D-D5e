{"_id":"WzvJ7G3cqvIubsLk","name":"Greater Restoration","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"WzvJ7G3cqvIubsLk\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Greater Restoration</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You imbue a creature you touch with positive energy to undo a debilitating effect. You can reduce the target's Exhaustion level by one, or end one of the following Effects on the target:</p>\n<ul>\n<li>One effect that Charmed or Petrified the target</li>\n<li>One curse, including the target's Attunement to a cursed magic item</li>\n<li>Any reduction to one of the target's Ability Scores</li>\n<li>One effect reducing the target's hit point maximum</li>\n</ul></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Greater Restoration</li><li>Rarity: Rare</li><li>Value: 5,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Greater Restoration</strong></p><p>You imbue a creature you touch with positive energy to undo a debilitating effect. You can reduce the target&#39;s Exhaustion level by one, or end one of the following Effects on th...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"","units":"inst"},"target":{"affects":{"type":"creature","count":"1","choice":false},"template":{"units":"","contiguous":false}},"range":{"units":"touch"},"uses":{"max":"","recovery":[],"spent":0},"level":5,"school":"abj","materials":{"value":"diamond dust worth at least 100gp, which the spell consumes","consumed":true,"cost":100,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Greater Restoration."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"greater-restoration","price":{"value":5000,"denomination":"gp"},"rarity":"rare","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"WzvJ7G3cqvIubsLk\"><p><e