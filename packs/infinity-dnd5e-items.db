},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-sealed-red-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"mgFqi0ev8f7Ut19y","sourceSpellName":"Heroes' Feast","sourceSpellUuid":"Compendium.dnd5e.spells.Item.mgFqi0ev8f7Ut19y","spellLevel":6,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"mgFqi0ev8f7Ut19y","spellName":"Heroes' Feast","spellLevel":6,"school":"con","sourceUuid":"Compendium.dnd5e.spells.Item.mgFqi0ev8f7Ut19y"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.mgFqi0ev8f7Ut19y","duplicateSource":"mgFqi0ev8f7Ut19y","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"rLo6YwErzBdHViBn","name":"Spell Scroll: Instant Summons","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-sealed-red-green.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"rLo6YwErzBdHViBn\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Instant Summons</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Instant Summons (6th-level con).</p><hr /><p>You touch an object weighing 10 pounds or less whose longest dimension is 6 feet or less. The spell leaves an Invisible mark on its surface and invisibly inscribes the name of the item on the sapphire you use as the material component. Each time you cast this spell, you must use a different sapphire.</p><p>At any time thereafter, you can use your action to speak the item's name and crush the sapphire. The item instantly appears in your hand regardless of physical or planar distances, and the spell ends.</p><p>If another creature is holding or carrying the item, crushing the sapphire doesn't transport the item to you, but instead you learn who the creature possessing the object is and roughly where that creature is located at that moment.</p><p>Dispel Magic or a similar effect successfully applied to the sapphire ends this spell's effect.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Very Rare</li><li>Value: 1,280 gp</li><li>1 use(s)</li><li>Stored spell: Instant Summons</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Instant Summons</strong></p><p>A consumable spell scroll containing Instant Summons, a 6th-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":1280,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"veryRare","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"rLo6YwErzBdHViBn\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster's spell list."},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Instant Summons from a spell scroll."},"duration":{"units":"inst