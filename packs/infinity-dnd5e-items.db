{"folder":"IpoLYdVARuoNHWDg","name":"Potion of Lucidity","type":"consumable","_id":"F5DoWePxzhxfhtK8","img":"icons/consumables/potions/bottle-bulb-corked-labeled-blue.webp","system":{"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Drink the Essence of Lucidity."},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[{"_id":"tGtm1onrIw2YOmxi"}],"range":{"units":"touch","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":"ft"},"affects":{"count":"1","type":"willing","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"roll":{"formula":"","name":"","prompt":false,"visible":false},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"isOverTimeFlag":false,"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""},"otherActivityId":"none","name":"Drink Potion of Lucidity"}},"uses":{"spent":0,"recovery":[],"autoDestroy":true,"max":"1"},"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"F5DoWePxzhxfhtK8\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Potion of Lucidity</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><strong>Description:</strong><br />The <em>Essence of Lucidity</em> is a rare, alchemical tincture that grants heightened clarity and perception. This golden liquid, carefully sealed and preserved, shimmers as if it holds light within. When imbibed, it sharpens the senses and clears the mind, allowing the drinker to perceive details and connections that might otherwise go unnoticed. The essence bestows advantage on Wisdom checks for one hour, making it invaluable for those seeking insight or navigating dangerous situations. However, the tincture is volatile; uncorking it may release a harmless but pungent smoke, alerting nearby creatures.</p><p><strong>Effect:</strong></p><ul><li>Grants <strong>advantage on all Wisdom checks</strong> for 1 hour.</li><li><strong>Risk</strong>: 25% chance of releasing a harmless smoke upon opening, potentially alerting nearby creatures sensitive to scent.</li></ul><p><strong>Common Table Ruling:</strong> When opened, the potion may release a harmless but pungent smoke that can alert nearby creatures.</p><!-- po-ruling:lucidity-smoke --></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Potion</li><li>Rarity: Rare</li><li>Value: 350 gp</li><li>1 use(s)</li><li>Activities: Utility</li><li>Automated effects: 1 applied</li></ul></aside></section>","chat":"<p><strong>Potion of Lucidity</strong></p><p>Description: The Essence of Lucidity is a rare, alchemical tincture that grants heightened clarity and perception. This golden liquid, carefully sealed and preserved, shimmers a...</p>"},"identifi