ds":["activation.action","automation.activity","automation.activity.save","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.spell-scrolls","folder.section.spell-scrolls","foundryType.consumable","loot","loot.scroll","magic.bonus","merchant.arcana","merchant.consumable","merchant.loot","merchant.magic","merchant.scroll","merchant.spell","price.gp","prop.somatic","prop.vocal","rarity.uncommon","sale.standard","source.class.curated","source.class.generated","source.curated","source.dnd5e.spells","source.infinity-dnd5e.spell-scrolls","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.level.2","spell.school.enc","subtype.scroll","tier.t2","value.v2","weight.none"],"lootType":"loot.scroll","tier":"tier.t2","rarityNormalized":"uncommon","gpValue":120,"valueBand":"value.v2","taggedAt":"2026-05-30T00:00:00.000Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.30ZgXtijJVCxQk5N","folderPathKey":"spells/spell-scrolls","folderLabels":["Spells","Spell Scrolls"],"primaryMode":"usable","activityTypes":["save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"spell-scroll-template","priceDenomination":"gp","merchantCategories":["arcana","consumable","loot","magic","scroll","spell"],"saleLiquidity":"sale.standard","lootWeight":0.02,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":60,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"spell-scrolls","sectionLabel":"Spell Scrolls","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"spell-scrolls","label":"Spell Scrolls","sort":4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loo