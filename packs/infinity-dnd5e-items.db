{"_id":"9v0TPDXNa9S7aNB4","name":"Periapt of Health","type":"equipment","img":"icons/equipment/neck/pendant-faceted-red.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"9v0TPDXNa9S7aNB4\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Periapt of Health</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item</em></p>\n<p>You are immune to contracting any disease while you wear this pendant. If you are already infected with a disease, the effects of the disease are suppressed while you wear the pendant.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Jewelry</li><li>Rarity: Uncommon</li><li>Value: 2,000 gp</li><li>Activities: Utility</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Periapt of Health</strong></p><p>Wondrous item You are immune to contracting any disease while you wear this pendant. If you are already infected with a disease, the effects of the disease are suppressed you wh...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0.01,"units":"lb"},"price":{"value":2000,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"9v0T