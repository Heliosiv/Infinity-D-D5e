":true,"coreSourceId":"Compendium.dnd5e.spells.Item.ODhLKBxLnvvLOnw1","folderPathKey":"spells/level-2","folderLabels":["Spells","Level 2"],"primaryMode":"usable","activityTypes":["attack","save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.9,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":125,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-2","sectionLabel":"Level 2","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-2","label":"Level 2","sort":4120}],"pathLabels":["Spells","Level 2"],"pathKeys":["spells","level-2"],"pathKey":"spells/level-2"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":2,"activityTypes":["attack","save"],"primaryActivityType":"attack","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-nec-level-2","plannedPath":"assets/item-art/shared/spell-nec-level-2.webp","fallbackIcon":"icons/magic/light/beam-rays-teal.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/light/beam-rays-teal.webp","effects":[],"folder":"Qi4Se3we69ukl2V9","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037355219,"modifiedTime":1725992719534,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"uncommon"}
{"_id":"OVikYmSdHliAG2YD","name":"Insect Plague","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"OVikYmSdHliAG2YD\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Insect Plague</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>Swarming, biting locusts fill a 20-foot-radius Sphere centered on a point you choose within range. The sphere spreads around corners. The sphere remains for the Duration, and its area is lightly obscured. The sphere's area is difficult terrain.</p><p>When the area appears, each creature in it must make a Constitution saving throw. A creature takes 4d10 piercing damage on a failed save, or half as much damage on a successful one. A creature must also make this saving throw when it enters the spell's area for the first time on a turn or ends its turn there.</p><p><strong>At Higher Levels.</strong> When you cast this spell using a spell slot of 6th level or higher, the damage increases by 1d10 for each slot level above 5th.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Insect Plague</li><li>Rarity: Rare</li><li>Value: 5,000 gp</li><li>Activities: Save</li></ul></aside></section>","chat":"<p><strong>Insect Plague</strong></p><p>Swarming, biting locusts fill a 20-foot-radius Sphere centered on a point you choose within range. The sphere spreads around corners. The sphere remains for the Duration, and it...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","