{"_id":"HLhFCDGfI8EK7uV9","name":"Boots of Levitation","type":"equipment","img":"icons/equipment/feet/boots-collared-rounded-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"HLhFCDGfI8EK7uV9\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Boots of Levitation</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item, (requires attunement)</em></p>\n<p>While you wear these boots, you can use an action to cast the <em>@Compendium[dnd5e.spells.MRxldJd6C4bsBo3O]{Levitate}</em> spell on yourself at will.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment</li><li>Rarity: Rare</li><li>Value: 4,000 gp</li><li>Requires attunement</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Boots of Levitation</strong></p><p>Wondrous item, (requires attunement) While you wear these boots, you can use an action to cast the @Compendium[dnd5e.spells.MRxldJd6C4bsBo3O]{Levitate} spell on yourself at will.</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":1,"units":"lb"},"price":{"value":4000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"HLhFCDGfI8EK7uV9\"><p><