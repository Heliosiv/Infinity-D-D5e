{"_id":"rY9sRFQp5CFSfsat","name":"Helm of Comprehending Languages","type":"equipment","img":"icons/magic/defensive/illusion-evasion-echo-purple.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"rY9sRFQp5CFSfsat\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Helm of Comprehending Languages</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item</em></p>\n<p>While wearing this helm, you can use an action to cast the @Compendium[dnd5e.spells.4dSvfvTy2ZIJ3K4k]{Comprehend Languages} spell from it at will.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Wondrous Item</li><li>Rarity: Uncommon</li><li>Value: 500 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Helm of Comprehending Languages</strong></p><p>Wondrous item While wearing this helm, you can use an action to cast the @Compendium[dnd5e.spells.4dSvfvTy2ZIJ3K4k]{Comprehend Languages} spell from it at will.</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":2,"units":"lb"},"price":{"value":500,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":null,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"rY9sRFQp5CFSfsat\"><p><em>A wondrous item awaiting iden