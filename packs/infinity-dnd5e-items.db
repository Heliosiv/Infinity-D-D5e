:"","useConditionReason":"","effectConditionText":"","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"isOverTimeFlag":false,"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""},"otherActivityId":"none","roll":{"formula":"","name":"","prompt":false,"visible":false}}},"identifier":"restorative-ointment","container":null,"attuned":false,"magicalBonus":null,"properties":[]},"effects":[{"name":"Restorative Cleansing","origin":"Item.VmcgAIsRCyrjBguC","duration":{"startTime":null,"seconds":1,"combat":null,"rounds":null,"turns":null,"startRound":null,"startTurn":null},"transfer":false,"disabled":false,"_id":"ba40486e9ac52ddb","changes":[{"key":"macro.itemMacro","mode":0,"value":"","priority":null}],"description":"Removes poisoned and disease effects from the target.","statuses":[],"flags":{"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":false,"selfTargetAlways":false,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"times-up":{"isPassive":false}},"tint":"#ffffff","_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":null,"modifiedTime":null,"lastModifiedBy":null},"img":"icons/commodities/materials/liquid-orange.webp","type":"base","system":{},"sort":0}],"folder":"IpoLYdVARuoNHWDg","flags":{"core":{"sourceId":"Compendium.dnd5e.items.Item.VmcgAIsRCyrjBguC"},"dnd5e":{"riders":{"activity":[],"effect":[]}},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[],"macro":{"name":"Restorative Ointment Cleansing","type":"script","scope":"global","command":"if (args?.[0] !== \"on\") return;\nconst targetActor = actor ?? token?.actor;\nif (!targetActor) return;\nconst shouldRemove = (effect) => {\n  const statuses = Array.from(effect.statuses ?? []);\n  const name = String(effect.name ?? \"\").toLowerCase();\n  const label = String(effect.label ?? \"\").toLowerCase();\n  return statuses.includes(\"poisoned\")\n    || statuses.includes(\"diseased\")\n    || name.includes(\"poisoned\")\n    || name.includes(\"diseased\")\n    || name.includes(\"disease\")\n    || label.includes(\"poisoned\")\n    || label.includes(\"diseased\")\n    || label.includes(\"disease\");\n};\nconst effects = targetActor.effects.filter(shouldRemove);\nawait Promise.all(effects.map((effect) => effect.delete()));"}},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.heal","automation.effect","automation.effect.applied","automation.mode.onuse","automation.mode.usable","automation.on-use","curation.medium","dmg.healing","economy.sellable","folder.fami