,"activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/apparatus-of-the-crab-lSd5QHnIJbKvP1bh","plannedPath":"assets/item-art/unique/apparatus-of-the-crab-lSd5QHnIJbKvP1bh.webp","fallbackIcon":"icons/containers/barrels/barrel-walnut-steel-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.lSd5QHnIJbKvP1bh","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"lTfo6OVvAY2iJ4oq","name":"Silver Horn of Valhalla","type":"consumable","img":"icons/tools/instruments/flute-simple-wood.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"lTfo6OVvAY2iJ4oq\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Silver Horn of Valhalla</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item</em></p>\n<p>You can use an action to blow this horn. In response, warrior spirits from the Valhalla appear within 60 feet of you. They use the statistics of a @Compendium[dnd5e.monsters.kz1t6xeXVwODpYb2]{Berserker}. They return to Valhalla after 1 hour or when they drop to 0 hit points. Once you use the horn, it can't be used again until 7 days have passed.</p>\n<p>Four types of Horn of Valhalla are known to exist, each made of a different metal. The horn's type determines how many berserkers answer its summons, as well as the requirement for its use. The GM chooses the horn's type or determines it randomly from the @Compendium[dnd5e.tables.RwerG95cIk2uRpsQ]{Horn of Valhalla} table.</p>\n<p><strong>Silver Horn of Valhalla.</strong>This silver horn summons [[/r 3d4 + 3]] berserkers when blown and has no other requirements.</p>\n<p>If you blow the horn without meeting its requirement, the summoned berserkers attack you. If you meet the requirement, they are friendly to you and your companions and follow your commands.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Horn</li><li>Rarity: Rare</li><li>Value: 5,600 gp</li><li>1 use(s)</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Silver Horn of Valhalla</strong></p><p>Wondrous item You can use an action to blow this horn. In response, warrior spirits from the Valhalla appear within 60 feet of you. They use the statistics of a @Compendium[dnd5...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":3,"units":"lb"},"price":{"value":5600,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":false,"spent":0},"damage":{"base":{"number":2,"denomination":4,"bonus":"2","types":[],"custom":{"enabled":false,"formula":""},"scaling":{"mode":"","number":null,"formula":""}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"lTfo6OVvAY2iJ4oq\"><p><em>A horn awaiting identification.</em></p><p>This horn is described by grain, polish, and handling marks. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Horn</li><li>Inspection cues: grain, polish, and handling marks</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"trinket","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Silver Horn of Valhalla."},"duration":{"concentration":false,"value":"1","units":"hour","special":"","override":false},"effects":[],"range":{"value":"60","units":"ft","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":""},"affects":{"count":"","type":"","choice":false,"special":""},"prompt":true,"override":false},"us