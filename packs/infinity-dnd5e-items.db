{"_id":"twRJhPtDQe1HceFt","name":"Padded Armor +1","type":"equipment","img":"icons/equipment/chest/breastplate-quilted-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"twRJhPtDQe1HceFt\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Padded Armor +1</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection for the wearer.</em></p>\n<p>You have a bonus to AC while wearing this armor.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Padded</li><li>Rarity: Rare</li><li>Value: 1,505 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Padded Armor +1</strong></p><p>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":8,"units":"lb"},"price":{"value":1505,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":12,"dex":null,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"twRJhPtDQe1HceFt\"><p><em>A padded armor awaiting identification.</em></p><p>This padded armor is described by worked metal, balance, and edge finish. Small details imply more value than a quick glance can confirm.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Padded Armor</li><li>Inspection cues: worked metal, balance, and edge finish</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"light","baseItem":"padded"},"container":null,"properties":["stealthDisadvantage"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Padded Armor +1"},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[],"range":{"units":"self","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":""},"affects":{"count":"","type":"","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"roll":{"formula":"","name":"","prompt":false,"visible":false},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"isOverTimeFlag":false,"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemov