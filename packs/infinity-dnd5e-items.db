tivityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.LmRHHMtplpxr9fX6","folderPathKey":"spells/level-3","folderLabels":["Spells","Level 3"],"primaryMode":"usable","activityTypes":["heal"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.765,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":250,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-3","sectionLabel":"Level 3","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-3","label":"Level 3","sort":4130}],"pathLabels":["Spells","Level 3"],"pathKeys":["spells","level-3"],"pathKey":"spells/level-3"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["heal"],"primaryActivityType":"heal","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-nec-level-3","plannedPath":"assets/item-art/shared/spell-nec-level-3.webp","fallbackIcon":"icons/magic/life/heart-cross-strong-blue.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/life/heart-cross-strong-blue.webp","effects":[],"folder":"5Si35RRLLaaoWvC3","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037354191,"modifiedTime":1725992719180,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"uncommon"}
{"_id":"LrPvWHBPmiMQQsKB","name":"Dominate Beast","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"LrPvWHBPmiMQQsKB\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Dominate Beast</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You attempt to beguile a beast that you can see within range. It must succeed on a Wisdom saving throw or be &amp;Reference[charmed] by you for the duration. If you or creatures that are friendly to you are fighting it, it has advantage on the saving throw.</p><p>While the beast is charmed, you have a telepathic link with it as long as the two of you are on the same plane of existence. You can use this telepathic link to issue commands to the creature while you are conscious (no action required), which it does its best to obey. You can specify a simple and general course of action, such as \"Attack that creature,\" \"Run over there,\" or \"Fetch that object.\" If the creature completes the order and doesn't receive further direction from you, it defends and preserves itself to the best of its ability.</p><p>You can use your action to take total and precise control of the target. Until the end of your next turn, the creature takes only the actions you choose, and doesn't do anything that you don't allow it to do. During this time, you can also cause the creature to use a reaction, but this requires you to use your own reaction as well.</p><p>Each time the target takes damage, it makes a new Wisdom saving throw against the spell. If the saving throw succeeds, the spell ends.</p><p><strong>At Higher Levels.</strong> When you cast this spell with a 5th-level spell slot, the duration is concentration, up to 10 minutes. When you use a 6th-level spell slot, the duration is concentration, up to 1 hour. When you use a spell slot of 7th level or higher, the duration is concentration, up to 8 hours.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Dominate Beast</li><li>Rarity: Rare</li><li>Value: 2,500 gp</li><li>Activities: Save</li></ul></aside></section>","chat":"<p><strong>Dominate Beast</strong></p><p>You attempt to beguile a beast that you can see within range. It must succeed on a Wisdom saving throw or be &amp;Reference[charmed] by you for the duration. If you or creatures tha...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"1","units":"minute"},"target":{"affects":{"type":"creature","count":"1","choice":false},"template":{"units":"","contiguous":false}},"range":{"value":"60","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":4,"school":"enc","materials":{"value":"","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","concentration"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Dominate Beast; resolve the target save."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"damage":{"onSave":"half","parts":[]},"save":{"ability":"wis","dc":{"calculation":"spellcasting","formula":""}},"uses":{"spent":