{"_id":"bbKLRNzrOYpaQz2u","name":"Star-Chart Triptych","type":"loot","img":"icons/sundries/documents/document-sealed-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"bbKLRNzrOYpaQz2u\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Star-Chart Triptych</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A three-panel wall chart painted with constellations, navigation marks, and gilt lines tracing old celestial routes.</p><p>It is part scholarship and part vanity piece, exactly the sort of art a court observatory or wealthy navigator would commission to impress visitors.</p><p>Display: Three-panel celestial wall chart. Weight: 7 lb.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Treasure, Treasure</li><li>Value: 5,000 gp</li></ul></aside></section>","chat":"<p><strong>Star-Chart Triptych</strong></p><p>A three-panel wall chart painted with constellations, navigation marks, and gilt lines tracing old celestial routes. It is part scholarship and part vanity piece, exactly the so...</p>"},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"bbKLRNzrOYpaQz2u\"><p><em>A crafted art object awaiting identification.</em></p><p>This crafted art object is described by freshness, aroma, and preparation. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Crafted Art Object</li><li>Inspection cues: freshness, aroma, and preparation</li><li>Identification state: Unidentified</li></ul></section>"},"source":{"rules":"2014","revision":1,"custom":"Party Operations Curated Treasure"},"quantity":1,"weight":{"value":7,"units":"lb"},"price":{"value":5000,"denomination":"gp"},"rarity":"","identified":true,"type":{"value":"treasure","subtype":""},"identifier":"star-chart-triptych","activities":{}},"effects":[],"folder":null,"flags":{"core":{"sourceId":"Compendium.infinity-dnd5e.infinity-dnd5e-items.Item.bbKLRNzrOYpaQz2u"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"folder":{"schema":"po-loot-folder-v1","familyKey":"sundries","familyLabel":"Sundries","sectionKey":"art-objects","sectionLabel":"Art Objects","leafKey":"wall-art","leafLabel":"Wall Art","path":[{"key":"sundries","label":"Sundries","sort":6000},{"key":"art-objects","label":"Art Objects","sort":6250},{"key":"wall-art","label":"Wall Art","sort":6280}],"pathLabels":["Sundries","Art Objects","Wall Art"],"pathKeys":["sundries","art-objects","wall-art"],"pathKey":"sundries/art-objects/wall-art"},"merchantCategories":["art","loot","luxury","treasure"],"lootType":"loot.loot","variableTreasureKind":"art","keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","foundryType.loot","loot","loot.loot","loot.variable","loot.variable.art","merchant.art","merchant.loot","merchant.luxury","merchant.trea