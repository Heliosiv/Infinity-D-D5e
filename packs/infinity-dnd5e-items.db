a":"po-item-enrichment-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.items.Item.XXLznzi3rlanMhTM","folderPathKey":"weapons/ammunition","folderLabels":["Weapons","Ammunition"],"primaryMode":"usable","activityTypes":["attack"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["consumable","magic","supplies"],"saleLiquidity":"sale.specialty","lootWeight":0.238,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":200,"folder":{"schema":"po-loot-folder-v1","familyKey":"weapons","familyLabel":"Weapons","sectionKey":"ammunition","sectionLabel":"Ammunition","leafKey":"","leafLabel":"","path":[{"key":"weapons","label":"Weapons","sort":1000},{"key":"ammunition","label":"Ammunition","sort":1300}],"pathLabels":["Weapons","Ammunition"],"pathKeys":["weapons","ammunition"],"pathKey":"weapons/ammunition"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["attack"],"primaryActivityType":"attack","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/ammunition-ammo","plannedPath":"assets/item-art/shared/ammunition-ammo.webp","fallbackIcon":"icons/weapons/ammunition/arrows-bodkin-yellow-red.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.XXLznzi3rlanMhTM","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},