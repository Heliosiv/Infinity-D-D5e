data-item-id=\"nqBDWkVOfcGZt4YU\"><p><em>An inscribed spell formula awaiting identification.</em></p><p>This inscribed spell formula is described by craftsmanship, condition, and hidden marks. The notation is readable enough to identify the tradition, but not the full working at a glance.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.nqBDWkVOfcGZt4YU"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.save","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-1","folder.section.level-1","foundryType.spell","loot","loot.spell","merchant.arcana","merchant.magic","merchant.spell","price.gp","prop.concentration","prop.vocal","rarity.common","sale.standard","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.concentration","spell.level.1","spell.school.evo","tier.t1","value.v2","weight.none"],"lootType":"loot.spell","tier":"tier.t1","rarityNormalized":"common","gpValue":50,"valueBand":"value.v2","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.nqBDWkVOfcGZt4YU","folderPathKey":"spells/level-1","folderLabels":["Spells","Level 1"],"primaryMode":"usable","activityTypes":["save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":1.2,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":25,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-1","sectionLabel":"Level 1","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-1","label":"Level 1","sort":4110}],"pathLabels":["Spells","Level 1"],"pathKeys":["spells","level-1"],"pathKey":"spells/level-1"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-evo-level-1","plannedPath":"assets/item-art/shared/spell-evo-level-1.webp","fallbackIcon":"icons/magic/fire/projectile-meteor-salvo-strong-teal.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/fire/projectile-meteor-salvo-strong-teal.webp","effects":[],"folder":"ERuXllkhTQF51rDJ","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037364768,"modifiedTime":1725992722629,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"common"}
{"_id":"nslx2nT3p4lNkmdp","name":"Major Image","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"nslx2nT3p4lNkmdp\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Major Image</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You create the image of an object, a creature, or some other visible phenomenon that is no larger than a 20-foot cube. The image appears at a spot that you can see within range and lasts for the duration. It seems completely real, including sounds, smells, and temperature appropriate to the thing depicted. You can't create sufficient heat or cold to cause damage, a sound loud enough to deal thunder damage or deafen a creature, or a smell that might sicken a creature (like a troglodyte's stench).</p><p>As long as you are within range of the illusion, you can use your action to cause the image to move to any other spot within range. As the image changes location, you can alter its appearance so that its movements appear natural for the image. For example, if you create an image of a creature and move it, you can alter the image so that it appears to be walking. Similarly, you can cause the illusion to make different sounds at different times, even making it carry on a conversation, for example.</p><p>Physical interaction with the image reveals it to be an illusion, because things can pass through it. A creature that uses its action to examine the image can determine that it is an illusion with a successful Intelligence (Investigation) check against your spell save DC. If a creature discerns the illusion for what it is, the creature can see through the image, and its other sensory qualities become faint to the creature.</p><p><strong>At Higher Levels.</strong> When you cast this spell using a spell slot of 6th level or higher, the spell lasts until dispelled, without requiring your concentration.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Major Image</li><li>Rarity: Uncommon</li><li>Value: 500 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Major Image</strong></p><p>You create the image of an object, a creature, or some other visible phenomenon that is no larger than a 20-foot cube. The image appears at a spot that you can see within range...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"cube","size":"20","contiguous":false}},"range":{"value":"120","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":3,"school":"ill","materials":{"value":"A bit of fleece","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material","concentration"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Major Image."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"