arty-operations.party-operations-loot-manifest.Item.eL2H4IxniOFn39gX","folderPathKey":"sundries/trade-goods/materials-metals","folderLabels":["Sundries","Trade Goods","Materials & Metals"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["crafting","loot","luxury","magic","material","metal","smithing","tradegood"],"saleLiquidity":"sale.luxury","lootWeight":0.9,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":23,"folder":{"schema":"po-loot-folder-v1","familyKey":"sundries","familyLabel":"Sundries","sectionKey":"trade-goods","sectionLabel":"Trade Goods","leafKey":"materials-metals","leafLabel":"Materials & Metals","path":[{"key":"sundries","label":"Sundries","sort":6000},{"key":"trade-goods","label":"Trade Goods","sort":6400},{"key":"materials-metals","label":"Materials & Metals","sort":6420}],"pathLabels":["Sundries","Trade Goods","Materials & Metals"],"pathKeys":["sundries","trade-goods","materials-metals"],"pathKey":"sundries/trade-goods/materials-metals"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/loot-sundries-trade-goods-materials-metals","plannedPath":"assets/item-art/shared/loot-sundries-trade-goods-materials-metals.webp","fallbackIcon":"icons/commodities/metal/ingot-stamped-silver.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":null,"duplicateSource":nu