ent-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.items.Item.hf5j1meGsA33HkUj","folderPathKey":"consumables/arcane-consumables","folderLabels":["Consumables","Arcane Consumables"],"primaryMode":"usable","activityTypes":["save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["consumable","magic"],"saleLiquidity":"sale.specialty","lootWeight":0.14,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":9000,"folder":{"schema":"po-loot-folder-v1","familyKey":"consumables","familyLabel":"Consumables","sectionKey":"arcane-consumables","sectionLabel":"Arcane Consumables","leafKey":"","leafLabel":"","path":[{"key":"consumables","label":"Consumables","sort":3000},{"key":"arcane-consumables","label":"Arcane Consumables","sort":3500}],"pathLabels":["Consumables","Arcane Consumables"],"pathKeys":["consumables","arcane-consumables"],"pathKey":"consumables/arcane-consumables"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":["creature"],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/mirror-of-life-trapping-hf5j1meGsA33HkUj","plannedPath":"assets/item-art/unique/mirror-of-life-trapping-hf5j1meGsA33HkUj.webp","fallbackIcon":"icons/magic/air/wind-vortex-swirl-purple.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.hf5j1meGsA33HkUj","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd