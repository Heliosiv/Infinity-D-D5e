:"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.party-operations.party-operations-loot-manifest.Item.6kbexHjBmnE0HAPG","folderPathKey":"consumables/other-consumables","folderLabels":["Consumables","Other Consumables"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"manual","priceDenomination":"gp","merchantCategories":["consumable","material","metal","tradegood"],"saleLiquidity":"sale.standard","lootWeight":1.32,"maxRecommendedQty":6,"lootEligible":true,"sellValueGp":5,"folder":{"schema":"po-loot-folder-v1","familyKey":"consumables","familyLabel":"Consumables","sectionKey":"other-consumables","sectionLabel":"Other Consumables","leafKey":"","leafLabel":"","path":[{"key":"consumables","label":"Consumables","sort":3000},{"key":"other-consumables","label":"Other Consumables","sort":3600}],"pathLabels":["Consumables","Other Consumables"],"pathKeys":["consumables","other-consumables"],"pathKey":"consumables/other-consumables"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-consumables-other-consumables","plannedPath":"assets/item-art/shared/consumable-consumables-other-consumables.webp","fallbackIcon":"icons/commodities/materials/powder-red-green-yellow.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","