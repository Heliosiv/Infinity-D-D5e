ies":["arcana","consumable","loot","magic","scroll","spell"],"saleLiquidity":"sale.standard","lootWeight":0.01175,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":1280,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"spell-scrolls","sectionLabel":"Spell Scrolls","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"spell-scrolls","label":"Spell Scrolls","sort":4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["summon"],"primaryActivityType":"summon","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-sealed-red-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"XT7nzJmVGgv73uaf","sourceSpellName":"Conjure Celestial","sourceSpellUuid":"Compendium.dnd5e.spells.Item.XT7nzJmVGgv73uaf","spellLevel":7,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"XT7nzJmVGgv73uaf","spellName":"Conjure Celestial","spellLevel":7,"school":"con","sourceUuid":"Compendium.dnd5e.spells.Item.XT7nzJmVGgv73uaf"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.XT7nzJmVGgv73uaf","duplicateSource":"XT7nzJmVGgv73uaf","coreVersion":"12.343","systemId":"dnd5e","syst