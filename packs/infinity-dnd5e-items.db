{"_id":"mhFBTY0egW8AeCHe","name":"Potion of Hill Giant Strength","type":"consumable","img":"icons/consumables/potions/bottle-bulb-corked-green.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"mhFBTY0egW8AeCHe\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Potion of Hill Giant Strength</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This potion's transparent liquid has floating in it a sliver of fingernail from a giant of the appropriate type.</em></p>\n<p>When you drink this potion, your Strength score changes to 21 for 1 hour.  The potion has no effect on you if your Strength is equal to or greater than that score.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Potion</li><li>Rarity: Uncommon</li><li>Value: 900 gp</li><li>1 use(s)</li><li>Activities: Utility</li><li>Automated effects: 1 applied</li></ul></aside></section>","chat":"<p><strong>Potion of Hill Giant Strength</strong></p><p>This potion&#39;s transparent liquid has floating in it a sliver of fingernail from a giant of the appropriate type. When you drink this potion, your Strength score changes to 21 fo...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0.1,"units":"lb"},"price":{"value":900,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infi