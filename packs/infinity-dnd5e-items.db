"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"22dPoeXfaaAv4K3h","sourceSpellName":"Hellish Rebuke","sourceSpellUuid":"Compendium.dnd5e.spells.Item.22dPoeXfaaAv4K3h","spellLevel":1,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"22dPoeXfaaAv4K3h","spellName":"Hellish Rebuke","spellLevel":1,"school":"evo","sourceUuid":"Compendium.dnd5e.spells.Item.22dPoeXfaaAv4K3h"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.22dPoeXfaaAv4K3h","duplicateSource":"22dPoeXfaaAv4K3h","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"Q3GNXEHScG1bvKVS","name":"Spell Scroll: Heroism","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"Q3GNXEHScG1bvKVS\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Heroism</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Heroism (1st-level enc).</p><hr /><p>A willing creature you touch is imbued with bravery. Until the spell ends, the creature is immune to being Frightened and gains Temporary Hit Points equal to your Spellcasting ability modifier at the start of each of its turns. When the spell ends, the target loses any remaining temporary hit points from this spell.</p><p><strong>At Higher Levels.</strong> When you cast this spell using a spell slot of 2nd level or higher, you can target one additional creature for each slot level above 1st.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Common</li><li>Value: 60 gp</li><li>1 use(s)</li><li>Stored spell: Heroism</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Heroism</strong></p><p>A consumable spell scroll containing Heroism, a 1st-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated