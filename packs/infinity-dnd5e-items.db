folder.section.spell-scrolls","foundryType.consumable","loot","loot.scroll","magic.bonus","merchant.arcana","merchant.consumable","merchant.loot","merchant.magic","merchant.scroll","merchant.spell","price.gp","prop.concentration","prop.somatic","prop.vocal","rarity.rare","sale.specialty","sale.standard","source.class.curated","source.class.generated","source.curated","source.dnd5e.spells","source.infinity-dnd5e.spell-scrolls","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.concentration","spell.level.5","spell.school.abj","subtype.scroll","tier.t3","value.high","value.v3","weight.none"],"lootType":"loot.scroll","tier":"tier.t3","rarityNormalized":"rare","gpValue":640,"valueBand":"value.v3","taggedAt":"2026-05-30T00:00:00.000Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.wXzkqpeFP8eWgJzK","folderPathKey":"spells/spell-scrolls","folderLabels":["Spells","Spell Scrolls"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"spell-scroll-template","priceDenomination":"gp","merchantCategories":["arcana","consumable","loot","magic","scroll","spell"],"saleLiquidity":"sale.standard","lootWeight":0.013243243243,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":320,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"spell-scrolls","sectionLabel":"Spell Scrolls","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"spell-scrolls","label":"Spell Scrolls","sort":4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-plain-red.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"wXzkqpeFP8eWgJzK","sourceSpellName":"Antilife Shell","sourceSpellUuid":"Compendium.dnd5e.spells.Item.wXzkqpeFP8eWgJzK","spellLevel":5,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"wXzkqpeFP8eWgJzK","spellName":"Antilife Shell","spellLevel":5,"school":"abj","sourceUuid":"Compendium.dnd5e.spells.Item.wXzkqpeFP8eWgJzK"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.wXzkqpeFP8eWgJzK","duplicateSource":"wXzkqpeFP8eWgJzK","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"8zhRoPt5B84ldCdk","name":"Spell Scroll: Arcane Hand","type":"consumable","img":"icons/sundries/scrolls/scroll-plain-red.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"8zhRoPt5B84ldCdk\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Arcane Hand</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Arcane Hand (5th-level evo).</p><hr /><p>You create a Large hand of shimmering, translucent force in an unoccupied space that you can see within range. The hand lasts for the spell's Duration, and it moves at your command, mimicking the movements of your own hand.</p><p>The hand is an object that has AC 20 and Hit Points equal to your hit point maximum. If it drops to 0 Hit Points, the spell ends. It has a Strength of 26 (+8) and a Dexterity of 10 (+0). The hand doesn't fill its space.</p><p>When you cast the spell and as a Bonus Action on your subsequent turns, you can move the hand up to 60 feet and then cause one of the following Effects with it.</p><p><strong>Clenched Fist</strong>. The hand strikes one creature or object within 5 feet of it. Make a melee spell Attack for the hand using your game Statistics. On a hit, the target takes 4d8 force damage.</p><p><strong>Forceful Hand</strong>. The hand attempts to push a creature within 5 feet of it in a direction you choose. Make a check with the hand's Strength contested by the Strength (Athletics) check of the target. If the target is Medium or smaller, you have advantage on the check. If you succeed, the hand pushes the target up to 5 feet plus a number of feet equal to five times your Spellcasting ability modifier. The hand moves with the target to remain within 5 feet of it.</p><p><strong>Grasping Hand</strong>. The hand attempts to grapple a Huge or smaller creature within 5 feet of it. You use the hand's Strength score to resolve the grapple. If the target is Medium or smaller, you have advantage on the check. While the hand is Grappling the target, you can use a Bonus Action to have the hand crush it. When you do so, the target takes bludgeoning damage equal to 2d6 + your Spellcasting ability modifier.</p><p><strong>Interposing Hand</strong>. The hand interposes itself between you and a creature you choose until you give the hand a different command. The hand moves to stay between you and the target, providing you with half cover against the target. The target can't move through the hand's space if its Strength score is less than or equal to the hand's Strength score. If its Strength score is higher than the hand's Strength score, the target can move toward you through the hand's space, but that space is difficult terrain for the target.</p><p><strong>At Higher Levels.</strong> When you cast this spell using a spell slot of 6th level or higher, the damage from the clenched fist option increases by 2d8 and the damage from the grasping hand increases by 2d6 for each slot level above 5th.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Rare</li><li>Value: 640 gp</li><li>1 use(s)</li><li>Stored spell: Arcane Hand</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Arcane Hand</strong></p><p>A consumable spell scroll containing Arcane Hand, a 5th-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":640,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"8zhRoPt5B84ldCdk\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"summon","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster's spell list."},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Arcane Hand from a spell scroll."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"bonuses":{"ac":"","hp":"@attri