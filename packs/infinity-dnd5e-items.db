ath.sundries.gems-jewelry.jewelry-tokens","folder.section.gems-jewelry","foundryType.equipment","loot","loot.equipment.magic","magic.bonus","merchant.curio","merchant.equipment","merchant.jewelry","merchant.magic","merchant.outfitting","price.gp","rarity.legendary","sale.luxury","sale.specialty","source.class.generated","source.dnd5e.items","source.policy.normal","subtype.trinket","tag.ring","tier.t4","value.high","value.v5","weight.none"],"lootType":"loot.equipment.magic","tier":"tier.t4","rarityNormalized":"legendary","gpValue":45000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"equipment","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.items.Item.hdlBOEbEjiwUjTW5","folderPathKey":"sundries/gems-jewelry/jewelry-tokens","folderLabels":["Sundries","Gems & Jewelry","Jewelry & Tokens"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["curio","equipment","jewelry","magic","outfitting"],"saleLiquidity":"sale.specialty","lootWeight":0.08,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":22500,"folder":{"schema":"po-loot-folder-v1","familyKey":"sundries","familyLabel":"Sundries","sectionKey":"gems-jewelry","sectionLabel":"Gems & Jewelry","leafKey":"jewelry-tokens","leafLabel":"Jewelry & Tokens","path":[{"key":"sundries","label":"Sundries","sort":6000},{"key":"gems-jewelry","label":"Gems & Jewelry","sort":6200},{"key":"jewelry-tokens","label":"Jewelry & Tokens","sort":6220}],"pathLabels":["Sundries","Gems & Jewelry","Jewelry & Tokens"],"pathKeys":["sundries","gems-jewelry","jewelry-tokens"],"pathKey":"sundries/gems-jewelry/jewelry-tokens"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/jewelry-ring-of-djinni-summoning","plannedPath":"assets/item-art/shared/jewelry-ring-of-djinni-summoning.webp","fallbackIcon":"icons/equipment/finger/ring-faceted-gold-purple.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.hdlBOEbEjiwUjTW5","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"hf5j1meGsA33HkUj","name":"Mirror of Life Trapping","type":"consumable","img":"icons/magic/air/wind-vortex-swirl-purple.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"hf5j1meGsA33HkUj\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Mirror of Life Trapping</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item</em></p>\n<p>When this 4-foot-tall mirror is viewed indirectly, its surface shows faint images of creatures. The mirror weighs 50 pounds, and it has AC 11, 10 hit points, and vulnerability to bludgeoning damage. It shatters and is destroyed when reduced to 0 hit points.</p>\n<p>If the mirror is hanging on a vertical surface and you are within 5 feet of it, you can use an action to speak its command word and activate it. It remains activated until you use an action to speak the command word again.</p>\n<p>Any creature other than you that sees its reflection in the activated mirror while within 30 feet of it must succeed on a DC 15 Charisma saving throw or be trapped, along with anything it is wearing or carrying, in one of the mirror's twelve extradimensional cells. This saving throw is made with advantage if the creature knows the mirror's nature, and constructs succeed on the saving throw automatically.</p>\n<p>An extradimensional cell is an infinite expanse filled with thick fog that reduces visibility to 10 feet. Creatures trapped in the mirror's cells don't age, and they don't need to eat, drink, or sleep. A creature trapped within a cell can escape using magic that permits planar travel. Otherwise, the creature is confined to the cell until freed.</p>\n<p>If the mirror traps a creature but its twelve extradimensional cells are already occupied, the mirror frees one trapped creature at random to accommodate the new prisoner. A freed creature appears in an unoccupied space within sight of the mirror but facing away from it. If the mirror is shattered, all creatures it contains are freed and appear in unoccupied spaces near it.</p>\n<p>While within 5 feet of the mirror, you can use an action to speak the name of one creature trapped in it or call out a particular cell by number. The creature named or contained in the named cell appears as an image on the mirror's surface. You and the creature can then communicate normally.</p>\n<p>In a similar way, you can use an action to speak a second command word and free one creature trapped in the mirror. The freed creature appears, along with its possessions, in the unoccupied space nearest to the mirror and facing away from it.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Trinket</li><li>Rarity: Very Rare</li><li>Value: 18,000 gp</li><li>12 use(s)</li><li>Activities: Save</li></ul></aside></section>","chat":"<p><strong>Mirror of Life Trapping</strong></p><p>Wondrous item When this 4-foot-tall mirror is viewed indirectly, its surface shows faint images of creatures. The mirror weighs 50 pounds, and it has AC 11, 10 hit points, and v...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":50,"units":"lb"},"price":{"value":18000,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"veryRare","identified":true,"uses":{"max":"12","recovery":[],"autoDestroy":false,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"hf5j1meGsA33HkUj\"><p><em>A trinket awaiting identification.</em></p><p>This trinket is described by craftsmanship, condition, and hidden marks. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Trinket</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"trinket","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"condition":"Command word. Target must be able to see its reflection.","override":false},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Mirror of Life Trapping; resolve the listed save."},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[],"range":{"value":"30","units":"ft","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":""},"affects":{"count":"1","type":"creature","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"damage":{"onSave":"half","parts":[],"critical":{"allow":false}},"save":{"ability":["cha"],"dc":{"calculation":"","formula":"15"}},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","