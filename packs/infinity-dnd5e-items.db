"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"JLTQyqXEaJDrTXyW","sourceSpellName":"Acid Splash","sourceSpellUuid":"Compendium.dnd5e.spells.Item.JLTQyqXEaJDrTXyW","spellLevel":0,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"JLTQyqXEaJDrTXyW","spellName":"Acid Splash","spellLevel":0,"school":"con","sourceUuid":"Compendium.dnd5e.spells.Item.JLTQyqXEaJDrTXyW"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.JLTQyqXEaJDrTXyW","duplicateSource":"JLTQyqXEaJDrTXyW","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"ZukGi93OaReKeJe2","name":"Spell Scroll: Chill Touch","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"ZukGi93OaReKeJe2\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Chill Touch</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Chill Touch (cantrip nec).</p><hr /><p>You create a ghostly, skeletal hand in the space of a creature within range. Make a ranged spell attack against the creature to assail it with the chill of the grave. On a hit, the target takes 1d8 Necrotic damage, and it can't regain hit points until the start of your next turn. Until then, the hand clings to the target.</p><p>If you hit an undead target, it also has disadvantage on attack rolls against you until the end of your next turn.</p><p>This spell's damage increases by 1d8 when you reach 5th level (2d8), 11th level (3d8), and 17th level (4d8).</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Common</li><li>Value: 10 gp</li><li>1 use(s)</li><li>Stored spell: Chill Touch</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Chill Touch</strong></p><p>A consumable spell scroll containi