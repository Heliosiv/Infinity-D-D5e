,"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/private-sanctum-NJgxf7pmSsBArIG7","plannedPath":"assets/item-art/unique/private-sanctum-NJgxf7pmSsBArIG7.webp","fallbackIcon":"icons/magic/defensive/shield-barrier-flaming-diamond-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/defensive/shield-barrier-flaming-diamond-orange.webp","effects":[],"folder":"5auWSClKMDUIV5Ni","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037355005,"modifiedTime":1725992719463,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"rare"}
{"_id":"NXWWWgHtWb7Nv21F","name":"Tiny Hut","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"NXWWWgHtWb7Nv21F\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Tiny Hut</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A 10-foot-radius immobile dome of force springs into existence around and above you and remains stationary for the duration. The spell ends if you leave its area.</p><p>Nine creatures of Medium size or smaller can fit inside the dome with you. The spell fails if its area includes a larger creature or more than nine creatures. Creatures and objects within the dome when you cast this spell can move through it freely. All other creatures and objects are barred from passing through it. Spells and other magical effects can't extend through the dome or be cast through it. The atmosphere inside the space is comfortable and dry, regardless of the weather outside.</p><p>Until the spell ends, you can command the interior to become dimly lit or dark. The dome is opaque from the outside, of any color you choose, but it is transparent from the inside.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Tiny Hut</li><li>Rarity: Uncommon</li><li>Value: 500 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Tiny Hut</strong></p><p>A 10-foot-radius immobile dome of force springs into existence around and above you and remains stationary for the duration. The spell ends if you leave its area. Nine creatures...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"minute","condition":"","value":1},"duration":{"value":"8","units":"hour"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"sphere","size":"10","contiguous":false}},"range":{"units":"self"},"uses":{"max":"","recovery":[],"spent":0},"level":3,"school":"evo","materials":{"value":"A small crystal bead","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material","ritual"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Tiny Hut."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"tiny-hut","price":{"value"