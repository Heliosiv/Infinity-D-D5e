-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.o8Dh7fblk1d16tnO","folderPathKey":"spells/level-1","folderLabels":["Spells","Level 1"],"primaryMode":"usable","activityTypes":["heal"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":1.2,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":25,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-1","sectionLabel":"Level 1","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-1","label":"Level 1","sort":4110}],"pathLabels":["Spells","Level 1"],"pathKeys":["spells","level-1"],"pathKey":"spells/level-1"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["heal"],"primaryActivityType":"heal","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-evo-level-1","plannedPath":"assets/item-art/shared/spell-evo-level-1.webp","fallbackIcon":"icons/magic/life/heart-cross-green.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/life/heart-cross-green.webp","effects":[],"folder":"ERuXllkhTQF51rDJ","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037364895,"modifiedTime":1725992722679,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"common"}
{"_id":"o9ZCvuD2B1OTcubb","name":"Wall of Force","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"o9ZCvuD2B1OTcubb\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Wall of Force</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>An invisible wall of force springs into existence at a point you choose within range. The wall appears in any orientation you choose, as a horizontal or vertical barrier or at an angle. It can be free floating or resting on a solid surface. You can form it into a hemispherical dome or a sphere with a radius of up to 10 feet, or you can shape a flat surface made up of ten 10-foot-by-10-foot panels. Each panel must be contiguous with another panel. In any form, the wall is 1/4 inch thick. It lasts for the Duration. If the wall cuts through a creature's space when it appears, the creature is pushed to one side of the wall (your choice which side).</p><p>Nothing can physically pass through the wall. It is immune to all damage and can't be dispelled by Dispel Magic. A Disintegrate spell destroys the wall instantly, however. The wall also extends into the Ethereal Plane, blocking ethereal travel through the wall.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Wall Of Force</li><li>Rarity: Rare</li><li>Value: 5,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Wall of Force</strong></p><p>An invisible wall of force springs into existence at a point you choose within range. The wall appears in any orientation you choose, as a horizontal or vertical barrier or at a...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"wall","size":"100","contiguous":false}},"range":{"value":"120","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":5,"school":"evo","materials":{"value":"A pinch of powder made by crushing clear gemstone","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material","concentration"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Wall of Force."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false