{"_id":"k3T7tpcdzDyVKlF4","name":"Wand of the War Mage +2","type":"equipment","img":"icons/weapons/staves/staff-engraved-red.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"k3T7tpcdzDyVKlF4\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Wand of the War Mage +2</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>(Requires attunement by a spellcaster)</em></p>\n<p>While holding this wand, you gain a bonus to spell attack rolls of +2. In addition, you ignore half cover when making a spell attack.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Wand</li><li>Rarity: Rare</li><li>Value: 4,000 gp</li><li>Requires attunement</li><li>Activities: Utility</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Wand of the War Mage +2</strong></p><p>(Requires attunement by a spellcaster) While holding this wand, you gain a bonus to spell attack rolls of +2. In addition, you ignore half cover when making a spell attack.</p>"},"source":{"rules":"2014","revision":1},"quantity":1,"weight":{"value":1,"units":"lb"},"price":{"value":4000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","spent":0,"recovery":[]},"armor":{"value":0,"dex":null,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"identifier":"wand-of-the-war-mage-2","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unident