yCount":1,"activityTypes":["heal"],"primaryActivityType":"heal","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-gold-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"34ddoYIrnOZ2GFYi","sourceSpellName":"Mass Healing Word","sourceSpellUuid":"Compendium.dnd5e.spells.Item.34ddoYIrnOZ2GFYi","spellLevel":3,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"34ddoYIrnOZ2GFYi","spellName":"Mass Healing Word","spellLevel":3,"school":"evo","sourceUuid":"Compendium.dnd5e.spells.Item.34ddoYIrnOZ2GFYi"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.34ddoYIrnOZ2GFYi","duplicateSource":"34ddoYIrnOZ2GFYi","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"6376j4i3dzsM8uAn","name":"Spell Scroll: Meld into Stone","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-gold-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"6376j4i3dzsM8uAn\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Meld into Stone</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Meld into Stone (3rd-level trs).</p><hr /><p>You step into a stone object or surface large enough to fully contain your body, melding yourself and all the Equipment you carry with the stone for the Duration. Using your Movement, you step into the stone at a point you can touch. Nothing of your presence remains visible or otherwise detectable by nonmagical Senses.</p><p>While merged with the stone, you can't see what occurs outside it, and any Wisdom (Perception) checks you make to hear sounds outside it are made with disadvantage. You remain aware of the passage of time and can cast Spells on yourself while merged in the stone. You can use your Movement to leave the stone where you entered it, which ends the spell. You otherwise can't move.</p><p>Minor physical damage to the stone doesn't harm you, but its partial destruction or a change in its shape (to the extent that you no longer fit within it) expels you and deals 6d6 bludgeoning damage to you. The stone's complete destruction (or Transmutation into a different substance) expels you and deals 50 bludgeoning damage to you. If expelled, you fall prone in an unoccupied space closest to where you first entered.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Uncommon</li><li>Value: 200 gp</li><li>1 use(s)</li><li>Stored spell: Meld into Stone</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Meld into Stone</strong></p><p>A consumable spell scroll containing Meld into Stone, a 3rd-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":200,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"6376j4i3dzsM8uAn\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"damage","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster'