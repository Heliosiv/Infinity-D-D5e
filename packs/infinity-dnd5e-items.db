":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/simulacrum-jccbeBIfLrqEZnDP","plannedPath":"assets/item-art/unique/simulacrum-jccbeBIfLrqEZnDP.webp","fallbackIcon":"icons/magic/control/energy-stream-link-spiral-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/control/energy-stream-link-spiral-orange.webp","effects":[],"folder":"irCSpQWIMtp978TA","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037363627,"modifiedTime":1725992722296,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"very-rare"}
{"_id":"jhhT9PsHy5A7EojO","name":"Resurrection","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"jhhT9PsHy5A7EojO\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Resurrection</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You touch a dead creature that has been dead for no more than a century, that didn't die of old age, and that isn't undead. If its soul is free and willing, the target returns to life with all its hit points.</p><p>This spell neutralizes any poisons and cures normal diseases afflicting the creature when it died. It doesn't, however, remove magical diseases, curses, and the like; if such effects aren't removed prior to casting the spell, they afflict the target on its return to life.</p><p>This spell closes all mortal wounds and restores any missing body parts.</p><p>Coming back from the dead is an ordeal. The target takes a −4 penalty to all attack rolls, saving throws, and ability checks. Every time the target finishes a long rest, the penalty is reduced by 1 until it disappears.</p><p>Casting this spell to restore life to a creature that has been dead for one year or longer taxes you greatly. Until you finish a long rest, you can't cast spells again, and you have disadvantage on all attack rolls, ability checks, and saving throws.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Resurrection</li><li>Rarity: Very Rare</li><li>Value: 25,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Resurrection</strong></p><p>You touch a dead creature that has been dead for no more than a century, that didn&#39;t die of old age, and that isn&#39;t undead. If its soul is free and willing, the target returns t...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"hour","condition":"","value":1},"duration":{"value":"","units":"inst"},"target":{"affects":{"type":"creature","count":"1","choice":false},"template":{"units":"spec","contiguous":false}},"range":{"units":"touch"},"uses":{"max":"","recovery":[],"spent":0},"level":7,"school":"nec","materials":{"value":"A diamond worth at least 1,000 gp, which the spell consumes","consumed":true,"cost":1000,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Resurrection."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"resurrection","price":{"value":25000,"denomination":"gp"},"rarity":"veryRare","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"jhhT9PsHy5A7EojO\"><p><em>An inscribed spell formula awaiting identification.</em></p><p>This inscribed spell formula is described by craftsmanship, condition, and hidden marks. It carries the kind of presence that makes casual appraisal feel inadequate.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.jhhT9PsHy5A7EojO"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-7","folder.section.level-7","foundryType.spell","loot","loot.spell","magic.bonus","merchant.arcana","merchant.magic","merchant.spell","price.gp","prop.material","prop.somatic","prop.vocal","rarity.very-rare","sale.specialty","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.level.7","spell.school.nec","tier.t4","value.high","value.v5","weight.none"],"lootType":"loot.spell","tier":"tier.t4","rarityNormalized":"very-rare","gpValue":25000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.jhhT9PsHy5A7EojO","folderPathKey":"spells/level-7","folderLabels":["Spells","Level 7"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.specialty","lootWeight":0.14,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":12500,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-7","sectionLabel":"Level 7","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-7","label":"Level 7","sort":4170}],"pathLabels":["Spells","Level 7"],"pathKeys":["spells","level-7"],"pathKey":"spells/level-7"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/resurrection-jhhT9PsHy5A7EojO","plannedPath":"assets/item-art/unique/resurrection-jhhT9PsHy5A7EojO.webp","fallbackIcon":"icons/magic/life/heart-cross-strong-flame-blue.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/life/heart-cross-strong-flame-blue.webp","effects":[],"folder":"irCSpQWIMtp978TA","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037363708,"modifiedTime":1725992722313,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"very-rare"}
{"_id":"jmfu8zj4zjjzUbeh","name":"Prismatic Wall","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"jmfu8zj4zjjzUbeh\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Prismatic Wall</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A shimmering, multicolored plane of light forms a vertical opaque wall—up to 90 feet long, 30 feet high, and 1 inch thick—centered on a point you can see within range. Alternatively, you can shape the wall into a Sphere up to 30 feet in diameter centered on a point you choose within range. The wall remains in place for the Duration. If you position the wall so that it passes through a space occupied by a creature, the spell fails, and your action and the spell slot are wasted.</p><p>The wall sheds bright light out to a range of 100 feet and dim light for an additional 100 feet. You and creatures you designate at the time you cast the spell can pass through and remain near the wall without harm. If another creature that can see the wall moves to within 20 feet of it or starts its turn there, the creature must succeed on a Constitution saving throw or become Blinded for 1 minute.</p><p>The wall consists of seven layers, each with a different color. When a creature attempts to reach into or pass through the wall, it does so one layer at a time through all the wall's layers. As it passes or reaches through each layer, the creature must make a Dexterity saving throw or be affected by that layer's properties as described below.</p><p>The wall can be destroyed, also one layer at a time, in order from red to violet, by means specific to each layer. Once a layer is destroyed, it remains so for the Duration of the spell. An Antimagic Field has no effect on the wall, and Dispel Magic works only against the violet layer.</p>\n<ol>\n<li><strong>Red</strong>. The creature takes 10d6 fire damage on a failed save, or half as much damage on a successful one. While this layer is in place, nonmagical Ranged Attacks can't pass through the wall. The layer can be destroyed by dealing at least 25 cold damage to it.</li>\n<li><strong>Orange</strong>. The creature takes 10d6 acid damage on a failed save, or half as much damage on a successful one. While this layer is in place, magical Ranged Attacks can't pass through the wall. The layer is destroyed by a strong wind.</li>\n<li><strong>Yellow</strong>. The creature takes 10d6 lightning damage on a failed save, or half as much damage on a successful one. This layer can be destroyed by dealing at least 60 force damage to it.</li>\n<li><strong>Green</strong>. The creature takes 10d6 poison damage on a failed save, or half as much damage on a successful one. A Passwall spell, or another spell of equal or greater level that can open a portal on a solid surface, destroys this layer.</li>\n<li><strong>Blue</strong>. The creature takes 10d6 cold damage on a failed save, or half as much damage on a successful one. This layer can be destroyed by dealing at least 25 fire damage to it.</li>\n<li><strong>Indigo</strong>. On a failed save, the creature is Restrained. It must then make a Constitution saving throw at the end of each of its turns. If it successfully saves three times, the spell ends. If it fails its save three times, it permanently turns to stone and is subjected to the Petrified condition. The successes and failures don't need to be consecutive; keep track of both until the creature collects three of a kind.\n<ul>\n<li>While this layer is in place, Spells can't be cast through the wall. The layer is destroyed by bright light shed by a Daylight spell or a similar spell of equal or higher level.</li>\n</ul>\n</li>\n<li><strong>Violet</strong>. On a failed save, the creature is Blinded. It must then make a Wisdom saving throw at the start of your next turn. A successful save ends the blindness. If it fails that save, the creature is transported to another plane of the DM's choosing and is no longer Blinded. (Typically, a creature that is on a plane that isn't its home plane is banished home, while other creatures are usually cast into the Astral or Ethereal planes.) This layer is destroyed by a Dispel Magic spell or a similar spell of equal or higher level that can end Spells and magical Effects.</li>\n</ol></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Prismatic Wall</li><li>Rarity: Legendary</li><li>Value: 250,000 gp</li><li>Activities: Save</li></ul></aside></section>","chat":"<p><strong>Prismatic Wall</strong></p><p>A shimmering, multicolored plane of light forms a vertical opaque wall—up to 90 feet long, 30 feet high, and 1 inch thick—centered on a point you can see within range. Alternati...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"wall","size":"90","contiguous":false}},"range":{"value":"60","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":9,"school":"abj","materials":{"value":"","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Prismatic Wall; resolve the target save."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"damage":{"onSave":"half","parts":[{"number":10,"denomination":6,"bonus":"","types":[],"custom":{"enabled":false,"formula":""},"scaling":{"mode":"","number":null,"formula":""}}]},"save":{"ability":"dex","dc":{"calculation":"spellcasting","formula":""}},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","roll":{"formula":"","name":"","prompt":false,"visible":false},"macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"prismatic-wall","price":{"value":250000,"denomination":"gp"},"rarity":"legendary","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"jmfu8zj4zjjzUbeh\"><p><em>An inscribed spell formula awaiting identification.</em></p><p>This inscribed spell formula is described by craftsmanship, condition, and hidden marks. It carries the kind of presence that makes casual appraisal feel inadequate.</p><ul class=\"infinity-item-stat