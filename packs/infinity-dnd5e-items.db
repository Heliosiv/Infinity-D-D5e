{"key":"wondrous-items","label":"Wondrous Items","sort":6500},{"key":"trinkets-implements","label":"Trinkets & Implements","sort":6520}],"pathLabels":["Sundries","Wondrous Items","Trinkets & Implements"],"pathKeys":["sundries","wondrous-items","trinkets-implements"],"pathKey":"sundries/wondrous-items/trinkets-implements"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"passive","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["special"],"targetTypes":["self"],"effectCount":1,"transferEffectCount":1,"appliedEffectCount":0,"hasPassiveEffects":true,"hasAppliedEffects":false,"integrations":["dae","midi-qol"]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/equipment-sundries-wondrous-items-trinkets-implements","plannedPath":"assets/item-art/shared/equipment-sundries-wondrous-items-trinkets-implements.webp","fallbackIcon":"icons/magic/perception/hand-eye-pink.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.U4PI6l96QJUk6TGb","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"U74TPNQLJZbHJyCk","name":"Robe of Eyes","type":"equipment","img":"icons/magic/perception/eye-tendrils-web-purple.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"U74TPNQLJZbHJyCk\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Robe of Eyes</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item, (requires attunement)</em></p>\n<p>This robe is adorned with eyelike patterns. While you wear the robe, you gain the following benefits:</p>\n<ul>\n<li>The robe lets you see in all directions, and you have advantage on Wisdom (Perception) checks that rely on sight.</li>\n<li>You have darkvision out to a range of 120 feet.</li>\n<li>You can see invisible creatures and objects, as well as see into the Ethereal Plane, out to a range of 120 feet.</li>\n</ul>\n<p>The eyes on the robe can't be closed or averted. Although you can close or avert your own eyes, you are never considered to be doing so while wearing this robe.</p>\n<p>A @Compendium[dnd5e.spells.Bnn9Nzajixvow9xi]{Light} spell cast on the robe or a @Compendium[dnd5e.spells.BP3GCwa66IAw1yTG]{Daylight} spell cast within 5 feet of the robe causes you to be blinded for 1 minute. At the end of each of your turns, you can make a Constitution saving throw (DC 11 for light or DC 15 for daylight), ending the blindness on a success.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment</li><li>Rarity: Rare</li><li>Value: 20,000 gp</li><li>Requires attunement</li><li>Activities: Save</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Robe of Eyes</strong></p><p>Wondrous item, (requires attunement) This robe is adorned with eyelike patterns. While you wear the robe, you gain the following benefits: The robe lets you see in all direction...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":1,"units":"lb"},"price":{"value":20000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"U74TPNQLJZbHJyCk\"><p><em>A worn item awaiting identification.</em></p><p>This worn item is described by stitching, wear, and fitted seams. The workmanship suggests it deserves careful study before anyone relies on it.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Worn Item</li><li>Inspection cues: stitching, wear, and fitted seams</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"clothing","baseItem":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"special","value":1,"condition":"","override":false},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Robe of Eyes; resolve the listed save."},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[],"range":{"value":"120","units":"ft","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":""},"affects":{"count":"","type":"self","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"damage":{"onSave":"half","