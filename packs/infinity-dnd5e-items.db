 & Shields","Heavy Armor"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["armor","equipment","magic","material","metal","outfitting","tradegood"],"saleLiquidity":"sale.standard","lootWeight":0.63,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":1000,"folder":{"schema":"po-loot-folder-v1","familyKey":"armor","familyLabel":"Armor","sectionKey":"magic-armor-shields","sectionLabel":"Magic Armor & Shields","leafKey":"heavy-armor","leafLabel":"Heavy Armor","path":[{"key":"armor","label":"Armor","sort":2000},{"key":"magic-armor-shields","label":"Magic Armor & Shields","sort":2100},{"key":"heavy-armor","label":"Heavy Armor","sort":2130}],"pathLabels":["Armor","Magic Armor & Shields","Heavy Armor"],"pathKeys":["armor","magic-armor-shields","heavy-armor"],"pathKey":"armor/magic-armor-shields/heavy-armor"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/armor-plate","plannedPath":"assets/item-art/shared/armor-plate.webp","fallbackIcon":"icons/equipment/chest/breastplate-cuirass-steel-grey.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"_stats":{"compendiumSource":"Compendium.dnd5e.items.Item.HVpXIU0zZw0a4Fb7","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,