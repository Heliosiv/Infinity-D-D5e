{"_id":"eHGbr3rqRRxdBPLq","name":"Chain Mail +3","type":"equipment","img":"icons/equipment/chest/breastplate-metal-scaled-grey.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"eHGbr3rqRRxdBPLq\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Chain Mail +3</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection for the wearer.</em></p>\n<p>You have a bonus to AC while wearing this armor.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Chainmail</li><li>Rarity: Legendary</li><li>Value: 25,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Chain Mail +3</strong></p><p>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":55,"units":"lb"},"price":{"value":25000,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"legendary","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":19,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":13,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"eHGbr3rqRRxdBPLq\"><p><em>A chainmail armor awaiting identification.</em></p><p>This chainmail armor is described by worked metal, balance, and edge finish. It carries the kind of presence that makes casual appraisal feel inadequate.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Chainmail Armor</li><li>Inspection cues: worked metal, balance, and edge finish</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"heavy","baseItem":"chainmail"},"container":null,"properties":["stealthDisadvantage"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"condition":"","override":false},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Chain Mail +3"},"duration":{"concentration":false,"value":"","units":"inst","special":"","override":false},"effects":[],"range":{"units":"self","special":"","override":false},"target":{"template":{"count":"","contiguous":false,"type":"","size":"","width":"","height":"","units":""},"affects":{"count":"","type":"","choice":false,"special":""},"prompt":true,"override":false},"uses":{"spent":0,"max":"","recovery":[]},"roll":{"formula":"","name":"","prompt":false,"visible":false},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"isOverTimeFlag":false,"overTimeProperties":{"saveRemoves":true,"preRe