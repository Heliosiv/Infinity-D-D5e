eafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-5","label":"Level 5","sort":4150}],"pathLabels":["Spells","Level 5"],"pathKeys":["spells","level-5"],"pathKey":"spells/level-5"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":2,"activityTypes":["attack","save"],"primaryActivityType":"attack","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/contagion-CjIq8Ed7bu3vVwT1","plannedPath":"assets/item-art/unique/contagion-CjIq8Ed7bu3vVwT1.webp","fallbackIcon":"icons/magic/unholy/strike-beam-blood-large-red-purple.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/unholy/strike-beam-blood-large-red-purple.webp","effects":[],"folder":"bG9QTayc46rfNkv2","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037351011,"modifiedTime":1725992718119,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"rare"}
{"_id":"CylBa7jR8DSbo8Z3","name":"Zone of Truth","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"CylBa7jR8DSbo8Z3\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Zone of Truth</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You create a magical zone that guards against deception in a 15-foot-radius sphere centered on a point of your choice within range. Until the spell ends, a creature that enters the spell's area for the first time on a turn or starts its turn there must make a Charisma saving throw. On a failed save, a creature can't speak a deliberate lie while in the radius. You know whether each creature succeeds or fails on its saving throw.</p>\n        <p>An affected creature is aware of the spell and can thus avoid answering questions to which it would normally respond with a lie. Such a creature can be evasive in its answers as long as it remains within the boundaries of the truth.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Zone Of Truth</li><li>Rarity: Uncommon</li><li>Value: 250 gp</li><li>Activities: Save</li></ul></aside></section>","chat":"<p><strong>Zone of Truth</strong></p><p>You create a magical zone that guards against deception in a 15-foot-radius sphere centered on a point of your choice within range. Until the spell ends, a creature that enters...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"10","units":"minute"},"target":{"affects":{"choice":false},"template":{"units":"ft","type":"sphere","size":"15","contiguous":false}},"range":{"value":"60","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":2,"school":"enc","materials":{"value":"","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Zone of Truth; resolve the target save."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"damage":{"onSave":"half","parts":[]},"save":{"ability":"cha","dc":{"calculation":"spellcasting","formula":""}},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","roll":{"formula":"","name":"","prompt":false,"visible":false},"macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"identifier":"zone-of-truth","price":{"value":250,"denomination":"gp"},"rarity":"