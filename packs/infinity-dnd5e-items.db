{"_id":"84z9mVy1mCipUWEY","name":"Breastplate +1","type":"equipment","img":"icons/equipment/chest/breastplate-layered-steel-black.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"84z9mVy1mCipUWEY\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Breastplate +1</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection for the wearer.</em></p>\n<p>You have a bonus to AC while wearing this armor.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Breastplate</li><li>Rarity: Rare</li><li>Value: 1,900 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Breastplate +1</strong></p><p>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection...</p>"},"source":{"rules":"2014","revision":1},"quantity":1,"weight":{"value":20,"units":"lb"},"price":{"value":1900,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","spent":0,"recovery":[]},"armor":{"value":15,"dex":2,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"identifier":"breastplate-1","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" dat