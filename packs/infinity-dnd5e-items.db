{"_id":"63nb14yQRJMc4bIn","name":"Philter of Love","type":"consumable","img":"icons/consumables/potions/potion-flask-corked-labeled-pink.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"63nb14yQRJMc4bIn\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Philter of Love</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This potion's rose-hued, effervescent liquid contains one easy-to-miss bubble shaped like a heart.</em></p>\n<p>The next time you see a creature within 10 minutes after drinking this philter, you become charmed by that creature for 1 hour. If the creature is of a species and gender you are normally attracted to, you regard it as your true love while you are charmed.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Potion</li><li>Rarity: Uncommon</li><li>Value: 90 gp</li><li>1 use(s)</li><li>Activities: Utility</li><li>Automated effects: 1 applied</li></ul></aside></section>","chat":"<p><strong>Philter of Love</strong></p><p>This potion&#39;s rose-hued, effervescent liquid contains one easy-to-miss bubble shaped like a heart. The next time you see a creature within 10 minutes after drinking this philter...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0.1,"units":"lb"},"price":{"value":90,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-des