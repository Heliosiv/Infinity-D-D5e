sual appraisal feel inadequate.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.x5JNBSyIBBZsjcGT"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.save","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-8","folder.section.level-8","foundryType.spell","loot","loot.spell","magic.bonus","merchant.arcana","merchant.magic","merchant.spell","price.gp","prop.concentration","prop.material","prop.somatic","prop.vocal","rarity.very-rare","sale.specialty","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.concentration","spell.level.8","spell.school.evo","tier.t4","value.high","value.v5","weight.none"],"lootType":"loot.spell","tier":"tier.t4","rarityNormalized":"very-rare","gpValue":50000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.x5JNBSyIBBZsjcGT","folderPathKey":"spells/level-8","folderLabels":["Spells","Level 8"],"primaryMode":"usable","activityTypes":["save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.specialty","lootWeight":0.14,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":25000,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-8","sectionLabel":"Level 8","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-8","label":"Level 8","sort":4180}],"pathLabels":["Spells","Level 8"],"pathKeys":["spells","level-8"],"pathKey":"spells/level-8"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/earthquake-x5JNBSyIBBZsjcGT","plannedPath":"assets/item-art/unique/earthquake-x5JNBSyIBBZsjcGT.webp","fallbackIcon":"icons/magic/earth/projectile-spiked-stone-boulder-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/earth/projectile-spiked-stone-boulder-orange.webp","effects":[],"folder":"x1XTiOgx4DJ34wc5","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037366644,"modifiedTime":1725992723440,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"very-rare"}
{"_id":"xNM9CzQQr2CieM4B","name":"Demiplane","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"xNM9CzQQr2CieM4B\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Demiplane</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You create a shadowy door on a flat solid surface that you can see within range. The door is large enough to allow Medium creatures to pass through unhindered. When opened, the door leads to a demiplane that appears to be an empty room 30 feet in each dimension, made of wood or stone. When the spell ends, the door disappears, and any creatures or objects inside the demiplane remain trapped there, as the door also disappears from the other side.</p><p>Each time you cast this spell, you can create a new demiplane, or have the shadowy door connect to a demiplane you created with a previous casting of this spell. Additionally, if you know the nature and contents of a demiplane created by a casting of this spell by another creature, you can have the shadowy door connect to its demiplane instead.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Demiplane</li><li>Rarity: Very Rare</li><li>Value: 50,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Demiplane</strong></p><p>You create a shadowy door on a flat solid surface that you can see within range. The door is large enough to allow Medium creatures to pass through unhindered. When opened, the...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"action","condition":"","value":1},"duration":{"value":"1","units":"hour"},"ta