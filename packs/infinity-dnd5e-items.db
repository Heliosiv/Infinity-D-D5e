weight.none"],"lootType":"loot.spell","tier":"tier.t1","rarityNormalized":"common","gpValue":25,"valueBand":"value.v1","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.EOmsUcFQJTfG2oio","folderPathKey":"spells/cantrips","folderLabels":["Spells","Cantrips"],"primaryMode":"usable","activityTypes":["attack"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":1.2,"maxRecommendedQty":4,"lootEligible":true,"sellValueGp":12.5,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"cantrips","sectionLabel":"Cantrips","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"cantrips","label":"Cantrips","sort":4100}],"pathLabels":["Spells","Cantrips"],"pathKeys":["spells","cantrips"],"pathKey":"spells/cantrips"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["attack"],"primaryActivityType":"attack","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-evo-level-0","plannedPath":"assets/item-art/shared/spell-evo-level-0.webp","fallbackIcon":"icons/magic/fire/projectile-fireball-smoke-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/fire/projectile-fireball-smoke-orange.webp","effects":[],"folder":"Z8kZlnggh1Pt