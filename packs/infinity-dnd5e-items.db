ationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["ingredient","loot","tradegood"],"saleLiquidity":"sale.standard","lootWeight":1.32,"maxRecommendedQty":6,"lootEligible":true,"sellValueGp":1.5,"folder":{"schema":"po-loot-folder-v1","familyKey":"sundries","familyLabel":"Sundries","sectionKey":"herbs-reagents","sectionLabel":"Herbs & Reagents","leafKey":"reagents","leafLabel":"Alchemical Reagents","path":[{"key":"sundries","label":"Sundries","sort":6000},{"key":"herbs-reagents","label":"Herbs & Reagents","sort":6300},{"key":"reagents","label":"Alchemical Reagents","sort":6320}],"pathLabels":["Sundries","Herbs & Reagents","Alchemical Reagents"],"pathKeys":["sundries","herbs-reagents","reagents"],"pathKey":"sundries/herbs-reagents/reagents"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/loot-sundries-herbs-reagents-reagents","plannedPath":"assets/item-art/shared/loot-sundries-herbs-reagents-reagents.webp","fallbackIcon":"icons/consumables/food/berries-ration-round-red.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/consumables/food/berries-ration-round-red.webp","effects":[],"folder":"zQBgGIath6Cy0aqB","_stats":{"compendiumSource":"Compendium.dnd5e.tradegoods.Item.u753EokyA4vjksle","duplicateSource":null,"coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1771268199232,"modifiedTime":1771268199232,"lastModifiedBy":"GFV