{"_id":"7CPuXZHmyhoHolIm","name":"Backpack","type":"container","img":"icons/containers/bags/pack-simple-leather.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"7CPuXZHmyhoHolIm\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Backpack</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A backpack can hold one cubic foot or 30 pounds of gear. You can also strap items, such as a bedroll or a coil of rope, to the outside of a backpack.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Container, Backpack</li><li>Rarity: Common</li><li>Value: 2 gp</li></ul></aside></section>","chat":"<p><strong>Backpack</strong></p><p>A backpack can hold one cubic foot or 30 pounds of gear. You can also strap items, such as a bedroll or a coil of rope, to the outside of a backpack.</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":5,"units":"lb"},"price":{"value":2,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"common","identified":true,"capacity":{"weight":{"value":30,"units":"lb"},"count":null,"volume":{"value":null,"units":"cubicFoot"}},"currency":{"cp":0,"sp":0,"ep":0,"gp":0,"pp":0},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"7CPuXZHmyhoHolIm\"><p><em>A backpack container awaiting identification.</em></p><p>This backpack container is described by stitching, wear, and fitted seams. Its practical use is apparent, but exact value and special details still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Backpack Container</li><li>Inspection cues: stitching, wear, and fitted seams</li><li>Identification state: Unidentified</li></ul></section>"},"container":null,"properties":[],"identifier":"backpack","attuned":false,"activities":{}},"effects":[],"folder":"uNQCicLJLwOY0FyO","flags":{"core":{"sourceId":"Compendium.dnd5e.items.Item.H8YCd689ezlD26aT"},"dnd5e":{},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.medium","economy.sellable","folder.family.sundries","folder.leaf.storage","folder.path.sundries.containers-packs.storage","folder.section.containers-packs","foundryType.container","loot","loot.container","merchant.container","merchant.storage","price.gp","rarity.common","sale.standard","source.class.generated","source.dnd5e.items","source.policy.normal","tier.t1","value.v0","weight.medium"],"lootType":"loot.container","tier":"tier.t1","rarityNormalized":"common","gpValue":2,"valueBand":"value.v0","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"container","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.items.Item.H8YCd689ezlD26aT","folderPathKey":"sundries/cont