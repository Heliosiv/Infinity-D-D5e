able","activityTypes":["summon"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.765,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":250,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-3","sectionLabel":"Level 3","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-3","label":"Level 3","sort":4130}],"pathLabels":["Spells","Level 3"],"pathKeys":["spells","level-3"],"pathKey":"spells/level-3"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["summon"],"primaryActivityType":"summon","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-con-level-3","plannedPath":"assets/item-art/shared/spell-con-level-3.webp","fallbackIcon":"icons/magic/nature/wolf-paw-glow-large-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/nature/wolf-paw-glow-large-orange.webp","effects":[],"folder":"5Si35RRLLaaoWvC3","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037345541,"modifiedTime":1725992716427,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"uncommon"}
{"_id":"1LkZvINag7KqBmDR","name":"Conjure Elemental","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"1LkZvINag7KqBmDR\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Conjure Elemental</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You call forth an elemental servant. Choose an area of air, earth, fire, or water that fills a 10-foot cube within range. An elemental of challenge rating 5 or lower appropriate to the area you chose appears in an unoccupied space within 10 feet of it. For example, a fire elemental emerges from a bonfire, and an earth elemental rises up from the ground. The elemental disappears when it drops to 0 hit points or when the spell ends.</p><p>The elemental is friendly to you and your companions for the duration. Roll initiative for the elemental, which has its own turns. It obeys any verbal commands that you issue to it (no action required by you). If you don't issue any commands to the elemental, it defends itself from hostile creatures but otherwise takes no actions.</p><p>If your concentration is broken, the elemental doesn't disappear. Instead, you lose control of the elemental, it becomes hostile toward you and your companions, and it might attack. An uncontrolled elemental can't be dismissed by you, and it disappears 1 hour after you summoned it.</p><p><strong>Higher Levels. </strong>When you cast this spell using a spell slot of 6th level or higher, the challenge rating increases by 1 for each slot level above 5th.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Conjure Elemental</li><li>Rarity: Rare</li><li>Value: 5,000 gp</li><li>Activities: Summon</li></ul></aside></section>","chat":"<p><strong>Conjure Elemental</strong></p><p>You call forth an elemental servant. Choose an area of air, earth, fire, or water that fills a 10-foot cube within range. An elemental of challenge rating 5 or lower appropriate...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"activation":{"type":"minute","condition":"an area of air, earth, fire, or water that fills a 10-foot cube within range","value":1},"duration":{"value":"1","units":"hour"},"target":{"affects":{"type":"space","count":"1","choice":false},"template":{"units":"","contiguous":false}},"range":{"value":"90","units":"ft"},"uses":{"max":"","recovery":[],"spent":0},"level":5,"school":"con","materials":{"value":"Burning incense for air, soft clay for earth, sulfur and phosphorus for fire, or water and sand for water.","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"properties":["vocal","somatic","material","concentration"],"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"summon","activation":{"type":"action","value":1,"override":false,"condition":""},"consumption":{"targets":[],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Use Conjure Elemental to summon the listed creature or effect."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"bonuses":{"ac":"","hd":"","hp":"","attackDamage":"","saveDamage":"","healing":""},"creatureSizes":[],"creatureTypes":[],"match":{"attacks":false,"proficiency":false,"saves":false},"profiles":[{"count":"1","cr":"@item.level","name":"","_id":"BFnNfSl7Ojcw4Rm2","uuid":"","level":{"min":null,"max":null},"t