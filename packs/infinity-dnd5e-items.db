,"valueBand":"value.v3","taggedAt":"2026-05-30T00:00:00.000Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"consumable","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.fVbCxFRaORalHB20","folderPathKey":"spells/spell-scrolls","folderLabels":["Spells","Spell Scrolls"],"primaryMode":"usable","activityTypes":["save"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"spell-scroll-template","priceDenomination":"gp","merchantCategories":["arcana","consumable","loot","magic","scroll","spell"],"saleLiquidity":"sale.standard","lootWeight":0.013243243243,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":320,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"spell-scrolls","sectionLabel":"Spell Scrolls","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"spell-scrolls","label":"Spell Scrolls","sort":4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-plain-red.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"fVb