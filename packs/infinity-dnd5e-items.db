20000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"consumable","activityCount":3,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.items.Item.lPsueMv4ZoXqCYf9","folderPathKey":"consumables/charged-magic-items","folderLabels":["Consumables","Charged Magic Items"],"primaryMode":"usable","activityTypes":["utility","save","damage"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["consumable","magic"],"saleLiquidity":"sale.specialty","lootWeight":0.24,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":10000,"folder":{"schema":"po-loot-folder-v1","familyKey":"consumables","familyLabel":"Consumables","sectionKey":"charged-magic-items","sectionLabel":"Charged Magic Items","leafKey":"","leafLabel":"","path":[{"key":"consumables","label":"Consumables","sort":3000},{"key":"charged-magic-items","label":"Charged Magic Items","sort":3400}],"pathLabels":["Consumables","Charged Magic Items"],"pathKeys":["consumables","charged-magic-items"],"pathKey":"consumables/charged-magic-items"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":3,"activityTypes":["utility","save","damage"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":7,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/wand-of-wonder-lPsueMv4ZoXqCYf9","plannedPath":"assets/item-art/unique/wand-of-wonder-lPsueMv4ZoXqCYf9.webp","fallbackIcon":"icons/weapons/staves/staff-skull-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentifi