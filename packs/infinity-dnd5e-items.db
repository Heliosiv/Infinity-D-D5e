:4200}],"pathLabels":["Spells","Spell Scrolls"],"pathKeys":["spells","spell-scrolls"],"pathKey":"spells/spell-scrolls"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["save"],"primaryActivityType":"save","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-gold-brown.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"CylBa7jR8DSbo8Z3","sourceSpellName":"Zone of Truth","sourceSpellUuid":"Compendium.dnd5e.spells.Item.CylBa7jR8DSbo8Z3","spellLevel":2,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"CylBa7jR8DSbo8Z3","spellName":"Zone of Truth","spellLevel":2,"school":"enc","sourceUuid":"Compendium.dnd5e.spells.Item.CylBa7jR8DSbo8Z3"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.CylBa7jR8DSbo8Z3","duplicateSource":"CylBa7jR8DSbo8Z3","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"jfirwtTUdOaMXAFC","name":"Spell Scroll: Animate Dead","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-gold-brown.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"jfirwtTUdOaMXAFC\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Animate Dead</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Animate Dead (3rd-level nec).</p><hr /><p>This spell creates an undead servant. Choose a pile of bones or a corpse of a Medium or Small humanoid within range. Your spell imbues the target with a foul mimicry of life, raising it as an undead creature. The target becomes a skeleton if you chose bones or a zombie if you chose a corpse (the DM has the creature's game statistics).</p><p>On each of your turns, you can use a bonus action to mentally command any creature you made with this spell if the creature is within 60 feet of you (if you control multiple creatures, you can command any or all of them at the same time, issuing the same command to each one). You decide what action the creature will take and where it will move during its next turn, or you can issue a general command, such as to guard a particular chamber or corridor. If you issue no commands, the creature only defends itself against hostile creatures. Once given an order, the creature continues to follow it until its task is complete.</p><p>The creature is under your control for 24 hours, after which it stops obeying any command you've given it. To maintain control of the creature for another 24 hours, you must cast this spell on the creature again before the current 24-hour period ends. This use of the spell reasserts your control over up to four creatures you have animated with this spell, rather than animating a new one.</p><p><strong>At Higher Levels.</strong> When you cast this spell using a spell slot of 4th level or higher, you animate or reassert control over two additional undead creatures for each slot level above 3rd. Each of the creatures must come from a different corpse or pile of bones.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Uncommon</li><li>Value: 200 gp</li><li>1 use(s)</li><li>Stored spell: Animate Dead</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Animate Dead</strong></p><p>A consumable spell scroll containing Animate Dead, a 3rd-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":200,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"uncommon","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"jfirwtTUdOaMXAFC\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"utility","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster's spell list."},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Animate Dead from a spell scroll."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"roll":{"formula":"","name":"","prompt":false,"visible":false},"uses":{"spent":0,"recovery":[],"max":""},"sort":0,"useConditionText":"","useConditionReason":"","effectConditionText":"","isOverTimeFlag":false,"otherActivityId":"none","macroData":{"name":"","command":""},"ignoreTraits":{"idi":false,"idr":false,"idv":false,"ida":false},"midiProperties":{"ignoreTraits":[],"triggeredActivityId":"none","triggeredActivityConditionText":"","triggeredActivityTargets":"targets","triggeredActivityRollAs":"self","forceDialog":false,"confirmTargets":"default","autoTargetType":"any","autoTargetAction":"default","automationOnly":false,"otherActivityCompatible":true,"identifier":"","displayActivityName":false,"rollMode":"default","chooseEffects":false,"toggleEffect":false,"ignoreFullCover":false},"overTimeProperties":{"saveRemoves":true,"preRemoveConditionText":"","postRemoveConditionText":""}}},"id