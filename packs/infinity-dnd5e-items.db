{"_id":"5SorTMl8NKDO9Yge","name":"Ring of Poison Resistance","type":"equipment","img":"icons/equipment/finger/ring-faceted-gold-purple.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"5SorTMl8NKDO9Yge\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Ring of Poison Resistance</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>(Requires attunement)</em></p>\n<p><em>This ring has been inlaid with an amethyst stone that glitters when it catches the light.</em></p>\n<p>You have resistance to poison damage while wearing this ring.</p>\n<p>For other rings of resistance, roll on the @Compendium[dnd5e.tables.MdTxWyYVhTIgtNcG]{Ring of Resistance} table</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Ring</li><li>Rarity: Rare</li><li>Value: 6,000 gp</li><li>Requires attunement</li><li>Activities: Utility</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Ring of Poison Resistance</strong></p><p>(Requires attunement) This ring has been inlaid with an amethyst stone that glitters when it catches the light. You have resistance to poison damage while wearing this ring. For...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":6000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"rare","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-des