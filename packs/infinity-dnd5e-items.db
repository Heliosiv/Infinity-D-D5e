tion, but not the full working at a glance.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.yfbK8gZqESlaoY5t"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-3","folder.section.level-3","foundryType.spell","loot","loot.spell","magic.bonus","merchant.arcana","merchant.magic","merchant.spell","price.gp","prop.concentration","prop.material","prop.somatic","prop.vocal","rarity.uncommon","sale.standard","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.concentration","spell.level.3","spell.school.trs","tier.t2","value.v3","weight.none"],"lootType":"loot.spell","tier":"tier.t2","rarityNormalized":"uncommon","gpValue":500,"valueBand":"value.v3","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.yfbK8gZqESlaoY5t","folderPathKey":"spells/level-3","folderLabels":["Spells","Level 3"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.standard","lootWeight":0.765,"maxRecommendedQty":2,"lootEligible":true,"sellValueGp":250,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-3","sectionLabel":"Level 3","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-3","label":"Level 3","sort":4130}],"pathLabels":["Spells","Level 3"],"pathKeys":["spells","level-3"],"pathKey":"spells/level-3"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/spell-trs-level-3","plannedPath":"assets/item-art/shared/spell-trs-level-3.webp","fallbackIcon":"icons/magic/control/energy-stream-link-white.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/control/energy-stream-link-white.webp","effects":[],"folder":"5Si35RRLLaaoWvC3","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037366960,"modifiedTime":1725992723578,"lastModifiedBy":"dnd5ebuilder0000"},"rarity":"uncommon"}
{"_id":"yqUDoxk4x0NWG5Bz","name":"Slow","ownership":{"default":0},"type":"spell","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"yqUDoxk4x0NWG5Bz\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Slow</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>You alter time around up to six creatures of your choice in a 40-foot cube within range. Each target must succeed on a Wisdom saving throw or be affected by this spell for the duration.</p><p>An affected target's speed is halved, it takes a -2 penalty to AC and Dexterity saving throws, and it can't use reactions. On its turn, it can use either an action or a bonus action, not both. Regardless of the creature's abilities or magic items, it can't make more than one melee or ranged attack during its turn.</p><p>If the creature attempts to cast a spell with a casting time of 1 action, roll a d20. On an 11 or higher, the spell doesn't take effect until the creature's next turn, and the creature must use its action on that turn to complete the spell. If it can't, the spell is wasted.</p><p>A creature affected by this spell makes another Wisdom saving throw at the end of its turn. On a successful save, the effect ends for it.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Spell, Slow</li><li>Rarity: Uncommon</li><li>Value: 500 gp</li><li>Activities: Save, Utility</li></ul></aside></section>","chat":"<p><strong>Slow</strong></p><p>You alter time around up to six creatures of your choice in a 40-foot cube within range. Each target must succeed on a Wisdom saving throw or be affected by this spell for the d...</p>"},"source":{"custom":"","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014"