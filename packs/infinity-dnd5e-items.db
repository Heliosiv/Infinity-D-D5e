cribed spell formula is described by craftsmanship, condition, and hidden marks. It carries the kind of presence that makes casual appraisal feel inadequate.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Inscribed Spell Formula</li><li>Inspection cues: craftsmanship, condition, and hidden marks</li><li>Identification state: Unidentified</li></ul></section>"},"weight":{"value":0,"units":"lb"}},"sort":0,"flags":{"core":{"sourceId":"Compendium.dnd5e.spells.Item.N2UEFq8X5LRsLcOZ"},"midi-qol":{"rollAttackPerTarget":"default","removeAttackDamageButtons":"default","effectActivation":false,"itemCondition":"","reactionCondition":"","otherCondition":"","effectCondition":""},"dae":{"disableIncapacitated":false,"selfTarget":true,"selfTargetAlways":true,"dontApply":false,"stackable":"noneName","showIcon":true,"durationExpression":"","macroRepeat":"none","specialDuration":[]},"midiProperties":{"confirmTargets":"default","autoFailFriendly":false,"autoSaveFriendly":false,"critOther":false,"offHandWeapon":false,"magicdam":false,"magiceffect":false,"concentration":false,"noConcentrationCheck":false,"toggleEffect":false,"ignoreTotalCover":false},"infinity-dnd5e":{"keywords":["activation.action","automation.activity","automation.activity.utility","automation.mode.usable","curation.high","economy.sellable","folder.family.spells","folder.path.spells.level-9","folder.section.level-9","foundryType.spell","loot","loot.spell","magic.bonus","merchant.arcana","merchant.magic","merchant.spell","price.gp","prop.concentration","prop.material","prop.somatic","prop.vocal","rarity.legendary","sale.specialty","source.class.curated","source.curated","source.dnd5e.spells","source.party.operations.party.operations.loot.manifest","source.policy.normal","spell.concentration","spell.level.9","spell.school.trs","tier.t4","value.high","value.v5","weight.none"],"lootType":"loot.spell","tier":"tier.t4","rarityNormalized":"legendary","gpValue":250000,"valueBand":"value.v5","taggedAt":"2026-04-20T00:02:30.081Z","tagSchema":"po-loot-v3","details":{"schema":"po-item-enrichment-v3","itemType":"spell","activityCount":1,"effectCount":0,"hasDescription":true,"coreSourceId":"Compendium.dnd5e.spells.Item.N2UEFq8X5LRsLcOZ","folderPathKey":"spells/level-9","folderLabels":["Spells","Level 9"],"primaryMode":"usable","activityTypes":["utility"],"activationTypes":["action"],"transferEffectCount":0,"appliedEffectCount":0},"pricingSource":"system","priceDenomination":"gp","merchantCategories":["arcana","magic","spell"],"saleLiquidity":"sale.specialty","lootWeight":0.08,"maxRecommendedQty":1,"lootEligible":true,"sellValueGp":125000,"folder":{"schema":"po-loot-folder-v1","familyKey":"spells","familyLabel":"Spells","sectionKey":"level-9","sectionLabel":"Level 9","leafKey":"","leafLabel":"","path":[{"key":"spells","label":"Spells","sort":4000},{"key":"level-9","label":"Level 9","sort":4190}],"pathLabels":["Spells","Level 9"],"pathKeys":["spells","level-9"],"pathKey":"spells/level-9"},"usability":{"schema":"po-loot-usage-v1","isUsable":true,"primaryMode":"usable","activityCount":1,"activityTypes":["utility"],"primaryActivityType":"utility","activationTypes":["action"],"targetTypes":[],"effectCount":0,"transferEffectCount":0,"appliedEffectCount":0,"hasPassiveEffects":false,"hasAppliedEffects":false,"integrations":[]},"sourceClass":"curated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"bespoke","assetId":"unique/shapechange-N2UEFq8X5LRsLcOZ","plannedPath":"assets/item-art/unique/shapechange-N2UEFq8X5LRsLcOZ.webp","fallbackIcon":"icons/magic/nature/wolf-paw-glow-large-orange.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true}}},"img":"icons/magic/nature/wolf-paw-glow-large-orange.webp","effects":[],"folder":"KL6ZY4VRMjojGrL4","_stats":{"duplicateSource":null,"coreVersion":"12.331","systemId":"dnd5e","systemVersion":"4.0.0","createdTime":1725037354933