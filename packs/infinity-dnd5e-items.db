{"_id":"xbVpKtrQ6tJsPhXX","name":"Half Plate Armor +3","type":"equipment","img":"icons/equipment/chest/breastplate-layered-steel-black.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"xbVpKtrQ6tJsPhXX\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Half Plate Armor +3</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection for the wearer.</em></p>\n<p>You have a bonus to AC while wearing this armor.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment, Halfplate</li><li>Rarity: Legendary</li><li>Value: 25,000 gp</li><li>Activities: Utility</li></ul></aside></section>","chat":"<p><strong>Half Plate Armor +3</strong></p><p>This armor has been embellished with powerful runes, crafted in sorcerous fires, blessed by a powerful being, or some other event has seen it bequeathed with enhanced protection...</p>"},"source":{"custom":"SRD 5.1","revision":1,"rules":"2014"},"quantity":1,"weight":{"value":40,"units":"lb"},"price":{"value":25000,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"legendary","identified":true,"cover":null,"crewed":false,"uses":{"max":"","recovery":[],"spent":0},"armor":{"value":18,"dex":2,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"uni