hasAppliedEffects":false,"integrations":[]},"sourceClass":"generated","sourcePolicy":"normal","curationScore":8,"art":{"schema":"infinity-dnd5e-art-assignment-v1","mode":"reusable","assetId":"shared/consumable-spells-spell-scrolls","plannedPath":"assets/item-art/shared/consumable-spells-spell-scrolls.webp","fallbackIcon":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","generated":false},"descriptionState":{"schema":"infinity-dnd5e-description-state-v1","identified":true,"unidentified":true},"spellScroll":{"schema":"infinity-dnd5e-spell-scroll-v1","sourceSpellId":"8MICCMeOXT3aJUy9","sourceSpellName":"Divine Favor","sourceSpellUuid":"Compendium.dnd5e.spells.Item.8MICCMeOXT3aJUy9","spellLevel":1,"generatedAt":"2026-05-30T00:00:00.000Z"},"scrollSource":{"schema":"infinity-dnd5e-spell-scroll-v1","spellId":"8MICCMeOXT3aJUy9","spellName":"Divine Favor","spellLevel":1,"school":"evo","sourceUuid":"Compendium.dnd5e.spells.Item.8MICCMeOXT3aJUy9"}}},"_stats":{"compendiumSource":"Compendium.dnd5e.spells.Item.8MICCMeOXT3aJUy9","duplicateSource":"8MICCMeOXT3aJUy9","coreVersion":"12.343","systemId":"dnd5e","systemVersion":"4.4.4","createdTime":1780142400000,"modifiedTime":1780142400000,"lastModifiedBy":"GFVfiCPdpln7qZBb"},"sort":0,"ownership":{"default":0,"GFVfiCPdpln7qZBb":3}}
{"_id":"hhUURX7T4mv6gCza","name":"Spell Scroll: Entangle","type":"consumable","img":"icons/sundries/scrolls/scroll-bound-orange-tan.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"hhUURX7T4mv6gCza\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Spell Scroll: Entangle</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p>A spell scroll bears the words of a single spell, written in a mystical cipher. If the spell is on your class's spell list, you can read the scroll and cast its spell without providing any material components. Otherwise, the scroll is unintelligible. Casting the spell by reading the scroll requires the spell's normal casting time. Once the spell is cast, the words on the scroll fade, and it crumbles to dust.</p><p><strong>Stored Spell:</strong> Entangle (1st-level con).</p><hr /><p>Grasping weeds and vines sprout from the ground in a 20-foot square starting from a point within range. For the Duration, these Plants turn the ground in the area into difficult terrain.</p><p>A creature in the area when you cast the spell must succeed on a Strength saving throw or be &amp;Reference[Restrained] by the entangling Plants until the spell ends. A creature restrained by the plants can use its action to make a Strength check against your spell save DC. On a success, it frees itself.</p><p>When the spell ends, the conjured Plants wilt away.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Consumable, Scroll</li><li>Rarity: Common</li><li>Value: 60 gp</li><li>1 use(s)</li><li>Stored spell: Entangle</li></ul></aside></section>","chat":"<p><strong>Spell Scroll: Entangle</strong></p><p>A consumable spell scroll containing Entangle, a 1st-level spell.</p>"},"source":{"custom":"Infinity D&D5e generated spell scroll","book":"SRD 5.1","page":"","license":"CC-BY-4.0","rules":"2014","revision":1},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":60,"denomination":"gp"},"attunement":"","equipped":false,"rarity":"common","identified":true,"uses":{"max":"1","recovery":[],"autoDestroy":true,"spent":0},"damage":{"base":{"number":null,"denomination":null,"types":[],"custom":{"enabled":false},"scaling":{"number":1}},"replace":false},"unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"unidentified\" data-item-id=\"hhUURX7T4mv6gCza\"><p><em>A sealed scroll awaiting identification.</em></p><p>This sealed scroll is described by paper stock, ink, and binding. Its practical use is apparent, but exact value and spell formula still need inspection.</p><ul class=\"infinity-item-state-list\"><li>Visible form: Sealed Scroll</li><li>Inspection cues: paper stock, ink, and binding</li><li>Identification state: Unidentified</li></ul></section>"},"type":{"value":"scroll","subtype":""},"activities":{"dnd5eactivity000":{"_id":"dnd5eactivity000","type":"save","activation":{"type":"action","value":1,"override":false,"condition":"Spell must be on the caster's spell list."},"consumption":{"targets":[{"type":"itemUses","target":"","value":"1","scaling":{"mode":"","formula":""}}],"scaling":{"allowed":false,"max":""},"spellSlot":true},"description":{"chatFlavor":"Cast Entangle from a spell scroll."},"duration":{"units":"inst","concentration":false,"override":false,"value":"","special":""},"effects":[],"range":{"override":false,"units":"self","special":""},"target":{"prompt":true,"template":{"contiguous":false,"units":"ft","count":"","type":"","size":"","width":"","height":""},"affects":{"choice":false,"count":"","type":"","special":""},"override":false},"damage":{"onSave":"half"