{"_id":"wBYmPQG3nZfD88aP","name":"Belt of Storm Giant Strength","type":"equipment","img":"icons/equipment/waist/sash-cloth-gold-purple.webp","system":{"description":{"value":"<section class=\"infinity-item-description infinity-item-description--identified\" data-schema=\"infinity-dnd5e-description-state-v1\" data-identification-state=\"identified\" data-item-id=\"wBYmPQG3nZfD88aP\"><header class=\"infinity-item-state-header\"><p><strong>Identified State:</strong> Belt of Storm Giant Strength</p></header><div class=\"infinity-item-body\" data-content=\"rules\"><p><em>Wondrous item, (requires attunement)</em></p>\n<p>While wearing this belt, your Strength score changes to 29. If your Strength is already equal to or greater than the belt's score, the item has no effect on you.</p></div><aside class=\"infinity-item-state\" data-content=\"metadata\"><p><strong>Item State</strong></p><ul class=\"infinity-item-state-list\"><li>Equipment</li><li>Rarity: Legendary</li><li>Value: 25,000 gp</li><li>Requires attunement</li><li>Activities: Utility</li><li>Automated effects: 1 passive</li></ul></aside></section>","chat":"<p><strong>Belt of Storm Giant Strength</strong></p><p>Wondrous item, (requires attunement) While wearing this belt, your Strength score changes to 29. If your Strength is already equal to or greater than the belt&#39;s score, the item...</p>"},"source":{"rules":"2014","revision":1},"quantity":1,"weight":{"value":1,"units":"lb"},"price":{"value":25000,"denomination":"gp"},"attunement":"required","equipped":false,"rarity":"legendary","identified":true,"cover":null,"crewed":false,"uses":{"max":"","spent":0,"recovery":[]},"armor":{"value":0,"dex":0,"magicalBonus":null},"hp":{"value":0,"max":0,"dt":null,"conditions":""},"speed":{"value":null,"conditions":""},"strength":null,"proficient":0,"identifier":"belt-of-storm-giant-strength","unidentified":{"description":"<section class=\"infinity-item-description infinity-item-description--unidentified\" data-schema=\"infinit