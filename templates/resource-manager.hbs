{{!--
  Infinity D&D5e — Quartermaster (Resource Manager).
  GM-only. Configure what counts as food/water/light, set the party's
  environment, run daily upkeep, and review the last report.
--}}
<div class="rm-shell">
  <header class="rm-head">
    <div class="rm-head__title">
      <h2><i class="fa-solid fa-campground" aria-hidden="true"></i> Quartermaster</h2>
      <p class="rm-head__sub">Party supplies — food, water &amp; light.</p>
    </div>
    <div class="rm-head__actions">
      <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="refresh" title="Refresh" aria-label="Refresh Quartermaster">
        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <p class="infinity-workspace-context" role="note">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    <span><strong>Workspace guide:</strong>
      {{#if isAuthoritative}}start on Today, resolve any visible safety lock, then use Setup &amp; Rules only when the roster or resource rules need changes.
      {{else}}this tab is read-only because another GM client is authoritative; review receipts here or use the active GM client for writes.
      {{/if}}
    </span>
  </p>

  <nav class="rm-section-nav" aria-label="Quartermaster sections">
    <button type="button" data-action="selectSection" data-section-target="rm-today" aria-controls="rm-today"><i class="fa-solid fa-sun" aria-hidden="true"></i> Today</button>
    <button type="button" data-action="selectSection" data-section-target="rm-runs" aria-controls="rm-runs"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Recent Runs</button>
    <button type="button" data-action="selectSection" data-section-target="rm-setup" aria-controls="rm-setup"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Setup &amp; Rules</button>
  </nav>

  <section id="rm-today" class="rm-workspace-section rm-today" aria-labelledby="rm-today-heading" tabindex="-1">
    <div class="rm-workspace-section__head">
      <div>
        <p class="rm-workspace-section__eyebrow">Daily routine</p>
        <h3 id="rm-today-heading">Today</h3>
      </div>
      <div class="rm-today__actions">
        <button type="button" class="mw-btn mw-btn--primary" data-action="advanceDay" title="{{#if canRunResourceWrites}}Consume one day of configured resources without foraging or moving the world clock{{else}}{{#unless isAuthoritative}}Another GM client is currently authoritative.{{else}}{{#if hasActiveUpkeep}}Review the interrupted run before changing more inventory.{{else}}Fix blocking resource conflicts in Setup &amp; Rules.{{/if}}{{/unless}}{{/if}}" {{#unless canRunResourceWrites}}disabled aria-disabled="true" aria-describedby="rm-resource-write-reason"{{/unless}}>
          <i class="fa-solid fa-utensils" aria-hidden="true"></i> Use Daily Supplies
        </button>
        <button type="button" class="mw-btn mw-btn--ghost" data-action="forageDrive" title="{{#if canRunForageDrive}}Choose what each character gathers and run their Survival checks (no day passes){{else}}{{#if canRunResourceWrites}}Foraging is closed in the current environment.{{else}}{{#unless isAuthoritative}}Another GM client is currently authoritative.{{else}}{{#if hasActiveUpkeep}}Review the interrupted run before changing more inventory.{{else}}Fix blocking resource conflicts in Setup &amp; Rules.{{/if}}{{/unless}}{{/if}}{{/if}}" {{#unless canRunForageDrive}}disabled aria-disabled="true" aria-describedby="{{#if canRunResourceWrites}}rm-forage-drive-reason{{else}}rm-resource-write-reason{{/if}}"{{/unless}}>
          <i class="fa-solid fa-wheat-awn" aria-hidden="true"></i> Forage Drive
        </button>
      </div>
    </div>

    <article class="rm-next-action {{#if hasActiveUpkeep}}rm-next-action--warning{{/if}}{{#if hasBlockingResourceConflicts}} rm-next-action--warning{{/if}}" aria-labelledby="rm-next-action-heading">
      <span class="rm-next-action__icon" aria-hidden="true"><i class="fa-solid {{#unless isAuthoritative}}fa-user-shield{{else}}{{#if hasActiveUpkeep}}fa-shield-halved{{else}}{{#if hasBlockingResourceConflicts}}fa-triangle-exclamation{{else}}{{#unless hasParty}}fa-users{{else}}fa-utensils{{/unless}}{{/if}}{{/if}}{{/unless}}"></i></span>
      <div>
        <p>Recommended next action</p>
        {{#unless isAuthoritative}}
        <h4 id="rm-next-action-heading">Use the active GM client</h4>
        <span>Another GM client is authoritative. Run upkeep from that client.</span>
        {{else}}{{#if hasActiveUpkeep}}
        <h4 id="rm-next-action-heading">Review the interrupted run</h4>
        <span>Compare the party's current supplies, then use Clear after review. Quartermaster will not replay the run.</span>
        {{else}}{{#if hasBlockingResourceConflicts}}
        <h4 id="rm-next-action-heading">Fix resource rule conflicts</h4>
        <span>Open Setup &amp; Rules and resolve every blocking overlap before running upkeep.</span>
        {{else}}{{#unless hasParty}}
        <h4 id="rm-next-action-heading">Add the party roster</h4>
        <span>Open Setup &amp; Rules and add the actors whose supplies should be tracked.</span>
        {{else}}
        <h4 id="rm-next-action-heading">Review supplies, then use daily supplies</h4>
        <span>Use Forage Drive first when supplies are low and foraging is open; otherwise consume one configured day.</span>
        {{/unless}}{{/if}}{{/if}}{{/unless}}
      </div>
    </article>

    {{#unless canRunResourceWrites}}
    <p id="rm-resource-write-reason" class="rm-disabled-reason" role="status">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <strong>Use Daily Supplies and Forage Drive are unavailable:</strong>
      {{#unless isAuthoritative}}Another GM client is currently authoritative. Run upkeep from that client.{{else}}{{#if hasActiveUpkeep}}Review and acknowledge the interrupted run before changing more inventory.{{else}}Fix every blocking resource conflict in Setup &amp; Rules.{{/if}}{{/unless}}
    </p>
    {{/unless}}

  {{#unless isAuthoritative}}
  <p class="rm-note rm-note--warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Another GM is the active one — daily upkeep runs on their client.</p>
  {{/unless}}

  {{#if hasActiveUpkeep}}
  <div class="rm-note rm-note--warn" role="alert">
    <p><i class="fa-solid fa-lock" aria-hidden="true"></i> <strong>Resource writes are safety-locked.</strong>
      The {{activeUpkeep.triggerLabel}} run for {{activeUpkeep.dayLabel}} did not finish cleanly. Quartermaster will not replay it or change more inventory until you review the supplies.
    </p>
    <button type="button" class="mw-btn mw-btn--ghost" data-action="clearInterruptedRun" title="{{#if isAuthoritative}}Record this run as interrupted after reviewing the party's supplies{{else}}Only the active GM client can clear an interrupted run{{/if}}" {{#unless isAuthoritative}}disabled aria-disabled="true"{{/unless}}>
      <i class="fa-solid fa-unlock" aria-hidden="true"></i> Clear after review
    </button>
  </div>
  {{/if}}

  {{#if hasResourceConflictWarnings}}
  <div class="rm-note rm-note--warn" {{#if hasBlockingResourceConflicts}}role="alert"{{else}}role="status"{{/if}}>
    <p><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <strong>Resource rules need attention.</strong>
      {{#if hasBlockingResourceConflicts}}Use Daily Supplies and Forage Drive are paused until the blocking conflicts are fixed.{{else}}These shared match rules are warnings; check them before they claim the same inventory item.{{/if}}
    </p>
    <ul>
      {{#each resourceConflictWarnings}}
      <li>{{message}}{{#if isBlocking}} <strong>(blocks resource writes)</strong>{{/if}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  <p class="rm-note">Set where the party is, check supplies below, then <strong>Use Daily Supplies</strong> — or turn on Auto-run to do it automatically as in-game days pass.</p>

  <section class="rm-section rm-environment">
    <h3>Where is the party?</h3>
    <div class="rm-environment__row">
      <select class="mw-input" data-role="environment" aria-label="Choose an environment to preview and activate" {{#unless isAuthoritative}}disabled aria-disabled="true"{{/unless}}>
        {{#each environments}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>
        {{/each}}
      </select>
      <span class="rm-environment__status">
        {{#if currentEnvForageable}}
        <i class="fa-solid fa-leaf" aria-hidden="true"></i> Foraging open · {{#if currentEnvDcsDiffer}}Food DC {{currentEnvFoodDc}} · Water DC {{currentEnvWaterDc}}{{else}}DC {{currentEnvFoodDc}}{{/if}}
        {{else}}
        <i class="fa-solid fa-ban" aria-hidden="true"></i> No foraging here
        {{/if}}
      </span>
    </div>
    <p class="rm-note">Choosing another region opens a rules preview before anything becomes active.</p>
    {{#if canRunResourceWrites}}{{#unless currentEnvForageable}}
    <p id="rm-forage-drive-reason" class="rm-disabled-reason" role="status"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Forage Drive is unavailable here. Choose a forageable environment first.</p>
    {{/unless}}{{/if}}
  </section>

  {{#if hasOverviewResources}}
  <section class="rm-section rm-outlook" aria-labelledby="rm-outlook-heading">
    <h3 id="rm-outlook-heading">Supply outlook</h3>
    <div class="rm-outlook__grid">
      {{#each overviewResources}}
      <article class="rm-outlook-card rm-outlook-card--{{status}}">
        <div class="rm-outlook-card__head">
          <span class="rm-outlook-card__icon" aria-hidden="true"><i class="{{icon}}"></i></span>
          <div>
            <strong>{{label}}</strong>
            <span title="{{scopeLabel}} - {{sourceSummary}}">{{scopeLabel}} - {{sourceSummary}}</span>
          </div>
          <span class="rm-outlook-card__status">{{statusLabel}}</span>
        </div>
        <dl>
          <div><dt>Available</dt><dd>{{available}}</dd></div>
          <div><dt>Daily use</dt><dd>{{dailyUse}}</dd></div>
          <div><dt>Coverage</dt><dd>{{coverageLabel}}</dd></div>
        </dl>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if report}}
  <section class="rm-section rm-report">
    <h3>Last upkeep - {{#if report.needsReview}}Needs review{{else}}{{#if report.hasShortages}}Shortages{{else}}Complete{{/if}}{{/if}}</h3>
    <p class="rm-report__meta">Environment: {{report.environmentLabel}}</p>
    <ul class="rm-report__list">
      {{#each report.rows}}
      <li class="{{stateClass}}">
        <strong>{{name}}</strong>
        {{#if needsReview}}needs review{{else}}{{#if supplied}}supplied{{else}}short: {{#each shortages}}<span>{{label}} {{amount}}</span>{{/each}}{{/if}}{{/if}}
        {{#if needsReview}}{{#if hasShortages}} - confirmed short: {{#each shortages}}<span>{{label}} {{amount}}</span>{{/each}}{{/if}}{{/if}}
        {{#if forageNote}} - {{forageNote}}{{/if}}
        {{#if hasErrors}} - inventory write needs review{{/if}}
      </li>
      {{/each}}
      {{#each report.partyShortages}}
      <li class="{{#if needsReview}}is-review{{else}}is-short{{/if}}"><strong>{{label}}</strong>{{#if needsReview}} - needs review{{/if}}{{#if amount}} - party pool short by {{amount}}{{/if}}{{#if hasError}} - inventory write needs review{{/if}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  </section>

  <section class="rm-workspace-section rm-section rm-runs" id="rm-runs" aria-labelledby="rm-runs-heading" tabindex="-1">
    <h3 id="rm-runs-heading">Recent runs</h3>
    {{#if hasRecentRuns}}
    <details class="rm-runs__disclosure" {{#if recentRunsExpanded}}open{{/if}}>
      <summary>
        <span><i class="fa-solid fa-chevron-right rm-disclosure-chevron" aria-hidden="true"></i> <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Run receipts</span>
        <small>{{recentRunCountLabel}}</small>
      </summary>
      <div class="rm-runs__list">
        {{#each recentRuns}}
        <details class="rm-run rm-run--{{statusTone}}" {{#if expanded}}open{{/if}}>
          <summary>
            <i class="fa-solid fa-chevron-right rm-disclosure-chevron" aria-hidden="true"></i>
            <span class="rm-run__identity">
              <strong>{{triggerLabel}}</strong>
              <small>{{recordedAtLabel}}</small>
              <small class="rm-run__summary-meta">{{environmentLabel}} · {{dayLabel}} · {{actorCountLabel}}</small>
            </span>
            <span class="rm-run__summary">
              <span class="rm-run__status">{{statusLabel}}</span>
              <small>{{summaryLabel}}</small>
            </span>
          </summary>
          <div class="rm-run__detail">
            <div class="rm-run__meta">
              <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{environmentLabel}}</span>
              <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> {{dayLabel}}</span>
              <span><i class="fa-solid fa-user-shield" aria-hidden="true"></i> {{initiatorLabel}}</span>
              <span><i class="fa-regular fa-clock" aria-hidden="true"></i> Started {{startedAtLabel}}</span>
            </div>

            {{#if isInterrupted}}
            <p class="rm-run__unknown" role="note"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              <strong>Inventory outcome unknown.</strong> Clearing the safety lock acknowledged the interruption; it did not prove which inventory changes finished.
            </p>
            {{/if}}

            {{#if isInterrupted}}
            {{#if forageContext}}
            <dl class="rm-run__facts">
              <div><dt>Requested</dt><dd>{{forageContext.targetLabel}}</dd></div>
              <div><dt>Destination</dt><dd>{{forageContext.destinationLabel}}</dd></div>
            </dl>
            {{/if}}
            {{/if}}

            {{#if forageDrive}}
            <dl class="rm-run__facts">
              <div><dt>Target</dt><dd>{{forageDrive.targetLabel}}</dd></div>
              {{#if forageDrive.hasDc}}<div><dt>DC</dt><dd>{{forageDrive.dcLabel}}</dd></div>{{/if}}
              <div><dt>Yield rule</dt><dd>{{forageDrive.modeLabel}}</dd></div>
              <div><dt>Destination</dt><dd>{{forageDrive.destinationLabel}}</dd></div>
              <div><dt>Applied</dt><dd>+{{forageDrive.totalFood}} food / +{{forageDrive.totalWater}} water</dd></div>
            </dl>
            {{#if forageDrive.hasErrors}}
            <ul class="rm-run__errors">
              {{#each forageDrive.errors}}<li>{{this}}</li>{{/each}}
            </ul>
            {{/if}}
            {{/if}}

            {{#if hasActors}}
            <div class="rm-run__actors">
              {{#each actors}}
              <article class="rm-run-actor">
                <div class="rm-run-actor__head">
                  <strong>{{name}}</strong>
                  {{#if hasRole}}<span>{{roleLabel}}</span>{{/if}}
                  {{#if hasForageTarget}}<span>{{forageTargetLabel}}</span>{{/if}}
                  {{#if hasForage}}<span>{{forageNote}}</span>{{/if}}
                </div>
                {{#if hasResources}}
                <ul>
                  {{#each resources}}
                  <li><span>{{label}}</span><span>Used {{consumed}} · short {{shortfall}}</span></li>
                  {{/each}}
                </ul>
                {{/if}}
                {{#if hasErrors}}
                <ul class="rm-run__errors">
                  {{#each displayErrors}}<li>{{this}}</li>{{/each}}
                </ul>
                {{/if}}
              </article>
              {{/each}}
            </div>
            {{/if}}

            {{#if hasPartyResources}}
            <div class="rm-run__party">
              <strong>Party resources</strong>
              <ul>
                {{#each partyResources}}
                <li class="{{#if hasShortfall}}is-short{{/if}} {{#if hasError}}is-error{{/if}}"><span>{{label}}</span><span>Used {{consumed}} · short {{shortfall}}{{#if hasError}} · <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{error}}{{/if}}</span></li>
                {{/each}}
              </ul>
            </div>
            {{/if}}

            {{#if hasExhaustionSuggestions}}
            <div class="rm-run__suggestions">
              <strong>Exhaustion suggestions</strong>
              <p>Suggestion only; this receipt does not confirm it was applied.</p>
              <ul>
                {{#each exhaustionSuggestions}}
                <li><strong>{{name}} +{{suggestDelta}}</strong>{{#if reasons}} — {{#each reasons}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}{{/if}}</li>
                {{/each}}
              </ul>
            </div>
            {{/if}}

            <details class="rm-run__diagnostics">
              <summary>Advanced receipt details</summary>
              <p class="rm-run__id"><span>Run ID</span> <code>{{runId}}</code></p>
            </details>
          </div>
        </details>
        {{/each}}
      </div>
    </details>
    {{else}}
    <p class="rm-note">No resource runs have been recorded yet.</p>
    {{/if}}
  </section>

  <details id="rm-setup" class="rm-setup rm-workspace-section" data-role="setup-disclosure" tabindex="-1" {{#if setupExpanded}}open{{/if}}>
    <summary class="rm-setup__summary">
      <span><i class="fa-solid fa-sliders" aria-hidden="true"></i> Setup &amp; rules</span>
      <small>Environment, resources, safety, and party roster</small>
    </summary>
    <div class="rm-setup__content" {{#unless isAuthoritative}}aria-disabled="true"{{/unless}}>
      <section class="rm-setup-checklist" aria-labelledby="rm-setup-checklist-heading">
        <div>
          <p class="rm-workspace-section__eyebrow">First setup</p>
          <h3 id="rm-setup-checklist-heading">Campaign readiness</h3>
        </div>
        <ul>
          <li class="is-complete">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span><strong>Current environment selected</strong><small>{{currentEnvLabel}}</small></span>
          </li>
          <li class="{{#if hasParty}}is-complete{{else}}is-incomplete{{/if}}">
            <i class="fa-solid {{#if hasParty}}fa-circle-check{{else}}fa-circle{{/if}}" aria-hidden="true"></i>
            <span><strong>Party roster available</strong><small>{{#if hasParty}}Tracked actors are ready.{{else}}Add at least one actor.{{/if}}</small></span>
          </li>
          <li class="{{#if hasOverviewResources}}is-complete{{else}}is-incomplete{{/if}}">
            <i class="fa-solid {{#if hasOverviewResources}}fa-circle-check{{else}}fa-circle{{/if}}" aria-hidden="true"></i>
            <span><strong>Resources defined</strong><small>{{#if hasOverviewResources}}Resource rules are available.{{else}}Add a tracked resource.{{/if}}</small></span>
          </li>
          <li class="{{#if hasBlockingResourceConflicts}}is-incomplete{{else}}is-complete{{/if}}">
            <i class="fa-solid {{#if hasBlockingResourceConflicts}}fa-circle{{else}}fa-circle-check{{/if}}" aria-hidden="true"></i>
            <span><strong>Inventory matches are safe</strong><small>{{#if hasBlockingResourceConflicts}}Blocking overlaps need attention.{{else}}No blocking item-match conflicts found.{{/if}}</small></span>
          </li>
        </ul>
      </section>
      <section class="rm-section rm-environment-setup" aria-labelledby="rm-environment-setup-heading">
        <div class="rm-section__head">
          <h3 id="rm-environment-setup-heading">Environment setup</h3>
          <div class="rm-environment-setup__actions" role="group" aria-label="Manage custom regions">
            <button type="button" class="mw-btn mw-btn--ghost" data-action="createEnvironment" title="{{#if canCreateEnvironment}}Create and open a new editable custom region{{else}}Only the active GM can create and activate a custom region{{/if}}" {{#unless canCreateEnvironment}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-plus" aria-hidden="true"></i> New custom
            </button>
            <button type="button" class="mw-btn mw-btn--ghost" data-action="copyEnvironment" title="{{#if canCopyEnvironment}}Copy the current region into an editable custom region{{else}}Only the active GM can copy and activate a custom region{{/if}}" {{#unless canCopyEnvironment}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-copy" aria-hidden="true"></i> Copy as custom
            </button>
            <button type="button" class="mw-btn mw-btn--ghost" data-action="exportEnvironments" title="{{#if canExportEnvironments}}Download {{customEnvironmentCount}} custom region rules as versioned JSON{{else}}{{#if isAuthoritative}}Create or copy a custom region before exporting{{else}}Only the active GM client can export custom regions{{/if}}{{/if}}" {{#unless canExportEnvironments}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-file-export" aria-hidden="true"></i> Export custom
            </button>
            <button type="button" class="mw-btn mw-btn--ghost" data-action="importEnvironments" title="{{#if canImportEnvironments}}Choose a versioned custom-region JSON file, validate it, and preview every change before saving{{else}}Only the active GM client can import custom regions{{/if}}" {{#unless canImportEnvironments}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-file-import" aria-hidden="true"></i> Import custom
            </button>
          </div>
        </div>
        {{#if currentEnvironment.isCustom}}
        <div class="rm-environment-editor" aria-label="Edit current custom environment">
          <div class="rm-environment-editor__head">
            <div>
              <strong>Custom region</strong>
              <span>Changes apply to this saved region immediately.</span>
            </div>
            <code>{{currentEnvironment.id}}</code>
          </div>
          <div class="rm-environment-editor__actions" role="group" aria-label="Reorder or remove {{currentEnvironment.label}}">
            <button type="button" class="mw-btn mw-btn--ghost" data-action="moveEnvironment" data-environment-id="{{currentEnvironment.id}}" data-direction="earlier" title="{{#if canMoveEnvironmentEarlier}}Move this custom region earlier in the list{{else}}{{#unless isAuthoritative}}Only the active GM client can reorder custom regions{{else}}This is already the first custom region{{/unless}}{{/if}}" aria-label="Move {{currentEnvironment.label}} earlier" {{#unless canMoveEnvironmentEarlier}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Earlier
            </button>
            <button type="button" class="mw-btn mw-btn--ghost" data-action="moveEnvironment" data-environment-id="{{currentEnvironment.id}}" data-direction="later" title="{{#if canMoveEnvironmentLater}}Move this custom region later in the list{{else}}{{#unless isAuthoritative}}Only the active GM client can reorder custom regions{{else}}This is already the last custom region{{/unless}}{{/if}}" aria-label="Move {{currentEnvironment.label}} later" {{#unless canMoveEnvironmentLater}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-arrow-down" aria-hidden="true"></i> Later
            </button>
            <button type="button" class="mw-btn mw-btn--danger" data-action="removeEnvironment" data-environment-id="{{currentEnvironment.id}}" title="{{#if canRemoveEnvironment}}Remove this custom region{{else}}Only the active GM can remove the current custom region{{/if}}" aria-label="Remove {{currentEnvironment.label}}" {{#unless canRemoveEnvironment}}disabled aria-disabled="true"{{/unless}}>
              <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove
            </button>
          </div>
          <div class="rm-environment-editor__grid">
            <label class="rm-field rm-environment-editor__name">
              <span>Name</span>
              <input class="mw-input" type="text" required maxlength="100" value="{{currentEnvironment.label}}" data-environment-id="{{currentEnvironment.id}}" data-environment-field="label" />
            </label>
            <label class="rm-toggle rm-environment-editor__toggle">
              <input type="checkbox" {{#if currentEnvironment.forageable}}checked{{/if}} data-environment-id="{{currentEnvironment.id}}" data-environment-field="forageable" /> Foraging open
            </label>
            <label class="rm-field rm-field--narrow">
              <span>Food DC</span>
              <input class="mw-input mw-input--num" type="number" min="0" max="100" step="1" value="{{currentEnvironment.foodDc}}" data-environment-id="{{currentEnvironment.id}}" data-environment-field="foodDc" />
            </label>
            <label class="rm-field rm-field--narrow">
              <span>Water DC</span>
              <input class="mw-input mw-input--num" type="number" min="0" max="100" step="1" value="{{currentEnvironment.waterDc}}" data-environment-id="{{currentEnvironment.id}}" data-environment-field="waterDc" />
            </label>
            <label class="rm-field">
              <span>Food yield</span>
              <input class="mw-input" type="text" maxlength="64" inputmode="text" value="{{currentEnvironment.yieldFood}}" placeholder="1d6" data-environment-id="{{currentEnvironment.id}}" data-environment-field="yieldFood" />
            </label>
            <label class="rm-field">
              <span>Water yield</span>
              <input class="mw-input" type="text" maxlength="64" inputmode="text" value="{{currentEnvironment.yieldWater}}" placeholder="1d6" data-environment-id="{{currentEnvironment.id}}" data-environment-field="yieldWater" />
            </label>
          </div>
          <p class="rm-note">Each Survival roll is checked against the requested supply's DC. Yield accepts a number or bounded dice math such as <code>1d6</code> or <code>2d4+1</code>. Turn foraging off for settlements, dungeons, or other closed regions.</p>
        </div>
        {{else}}
        <p class="rm-note">Built-in regions stay unchanged. Copy the current region to make an editable campaign variant.</p>
        {{/if}}
      </section>

  <section class="rm-section rm-options">
    <h3>Rules</h3>
    <div class="rm-options__grid">
      <label class="rm-toggle"><input type="checkbox" data-config-path="autoTrigger" {{#if autoTrigger}}checked{{/if}} /> Auto-run on day change</label>
      <label class="rm-toggle"><input type="checkbox" data-config-path="waterEnabled" {{#if waterEnabled}}checked{{/if}} /> Track water</label>
      <label class="rm-toggle"><input type="checkbox" data-config-path="halfRations" {{#if halfRations}}checked{{/if}} /> Half rations</label>
      <label class="rm-field">
        <span>Foraging yield</span>
        <select class="mw-input" data-config-path="forageMode">
          <option value="each" {{#if forageModeEach}}selected{{/if}}>Each forager keeps their own</option>
          <option value="best" {{#unless forageModeEach}}selected{{/unless}}>Best result feeds the party</option>
        </select>
      </label>
      <label class="rm-field">
        <span>Maximum catch-up days</span>
        <input class="mw-input mw-input--num" type="number" min="1" max="30" step="1" value="{{maxCatchUpDays}}" data-config-path="maxCatchUpDays" />
      </label>
    </div>
  </section>

  <section class="rm-section rm-resources">
    <div class="rm-section__head">
      <h3>Tracked resources</h3>
      <button type="button" class="mw-btn mw-btn--ghost" data-action="addResource"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add</button>
    </div>
    {{#each resources}}
    <article class="rm-resource">
      <div class="rm-resource__top">
        <input class="mw-input rm-resource__label" type="text" value="{{label}}" data-config-path="resource:{{id}}:label" aria-label="Resource name" />
        <label class="rm-resource__perday">Per day
          <input class="mw-input mw-input--num" type="number" min="0" step="1" value="{{perDay}}" data-config-path="resource:{{id}}:perDay" />
        </label>
        <label class="rm-resource__scope">Scope
          <select class="mw-input" data-config-path="resource:{{id}}:scope" {{#if scopeLocked}}disabled aria-disabled="true" title="Food and water stay per character so shortages and exhaustion are assigned correctly."{{/if}}>
            <option value="per-character" {{#unless scopeIsParty}}selected{{/unless}}>Each character</option>
            <option value="party" {{#if scopeIsParty}}selected{{/if}}>Whole party</option>
          </select>
        </label>
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="removeResource" data-resource-id="{{id}}" title="Remove resource" aria-label="Remove {{label}}">
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
        </button>
      </div>
      <div class="rm-resource__match">
        <label class="rm-field">
          <span>Name keywords (comma-separated)</span>
          <input class="mw-input" type="text" value="{{keywords}}" data-config-path="resource:{{id}}:keywords" placeholder="e.g. ration, rations" />
        </label>
        <label class="rm-field rm-field--narrow">
          <span>Tag (advanced)</span>
          <input class="mw-input" type="text" value="{{flagTag}}" data-config-path="resource:{{id}}:flagTag" title="Internal marker auto-applied to foraged/created items. Most GMs can leave this alone." />
        </label>
      </div>
      <div class="rm-resource__tags" data-drop-resource="{{id}}">
        <span class="rm-resource__droplabel"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Drag an item here (from a sheet or compendium) to match it exactly — more reliable than keywords.</span>
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="addTag" data-resource-id="{{id}}" title="Search for an item" aria-label="Search for an exact item match for {{label}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
        <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="addTagByUuid" data-resource-id="{{id}}" title="Paste an Item UUID" aria-label="Paste an Item UUID to match exactly for {{label}}"><i class="fa-solid fa-link" aria-hidden="true"></i></button>
        {{#each tags}}
        <span class="rm-tag {{#if missing}}rm-tag--missing{{/if}}" title="{{uuid}}">{{name}}{{#if missing}} (missing){{/if}}
          <button type="button" class="rm-tag__x" data-action="removeTag" data-resource-id="{{../id}}" data-uuid="{{uuid}}" title="Remove {{name}}" aria-label="Remove {{name}} from resource items">×</button>
        </span>
        {{/each}}
      </div>
    </article>
    {{/each}}
  </section>

  <section class="rm-section rm-party">
    <h3>Party supplies</h3>
    {{#if rosterIsImplicit}}
    <p class="rm-note">Auto-tracking every player-owned character. Mark a <strong>Stash</strong>, change <strong>Draws from</strong>, or add an inventory-only actor to start curating the roster.</p>
    {{/if}}
    {{#if hasRosterMembers}}
    <div class="rm-stash-pick">
      <label for="rm-party-stash">Per-character supply stash</label>
      <select id="rm-party-stash" data-config-path="partyStashId" aria-label="Single stash the whole party draws per-character supplies from">
        {{#each partyStashOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{#if partyStashActive}}<span class="rm-muted">Every consuming party member draws per-character supplies from {{partyStashName}}'s pack.</span>{{else}}<span class="rm-muted">Or set each character's source per-row below.</span>{{/if}}
    </div>
    {{/if}}
    {{#if hasParty}}
    <table class="rm-table rm-roster">
      <thead>
        <tr>
          <th scope="col">Actor</th>
          {{#each resources}}<th scope="col">{{label}}</th>{{/each}}
          <th scope="col">Exhaustion</th>
          <th scope="col" title="Charge this actor one per-character share of daily supplies">Consumes</th>
          <th scope="col" title="This character's pack is a shared source the party can draw from">Stash</th>
          <th scope="col">Draws from</th>
          <th scope="col"><span class="rm-sr">Remove</span></th>
        </tr>
      </thead>
      <tbody>
        {{#each partyRows}}
        <tr>
          <td>{{name}}</td>
          {{#each counts}}<td class="rm-num" title="{{detail}}">{{total}}{{#if shared}}<small> shared</small>{{/if}}</td>{{/each}}
          <td class="rm-num">{{exhaustion}}</td>
          <td class="rm-num">
            <input type="checkbox" data-config-path="roster:{{actorId}}:consumes" {{#if consumes}}checked{{/if}} aria-label="Charge {{name}} daily per-character supplies" />
          </td>
          <td class="rm-num">
            <input type="checkbox" data-config-path="roster:{{actorId}}:isStash" {{#if isStash}}checked{{/if}} aria-label="Mark {{name}} as a shared stash" />
          </td>
          <td class="rm-drawfrom">
            {{#if @root.partyStashActive}}
            <span class="rm-muted" title="The whole party draws per-character supplies from the party stash">→ {{@root.partyStashName}}</span>
            {{else unless consumes}}
            <span class="rm-muted" title="This actor stores inventory but does not consume a daily share">Inventory only</span>
            {{else if isStash}}
            <span class="rm-muted" title="A stash holds its own supplies">Self (stash)</span>
            {{else if canDrawFromStash}}
            <select data-config-path="roster:{{actorId}}:drawFrom" aria-label="Where {{name}} draws supplies from">
              {{#each drawFromOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            {{else}}
            <span class="rm-muted">Self</span>
            {{/if}}
          </td>
          <td>
            <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="removeRosterMember" data-actor-id="{{actorId}}" title="Remove {{name}} from the roster" aria-label="Remove {{name}} from the roster"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="rm-note">No player-owned characters auto-detected. Add any actor as an inventory source, then enable <strong>Consumes</strong> for each actual party member.</p>
    {{/if}}
    {{#if hasAvailableToAdd}}
    <div class="rm-roster-add">
      <button type="button" class="mw-btn mw-btn--ghost" data-action="addRosterMember"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find Actor</button>
    </div>
    {{/if}}
  </section>

      <div class="rm-setup__reset">
        <div>
          <strong>Reset Quartermaster</strong>
          <span>Restore the default resources, rules, roster routing, and environments.</span>
        </div>
        <button type="button" class="mw-btn mw-btn--ghost" data-action="resetConfig">
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset to defaults
        </button>
      </div>
    </div>
  </details>
</div>
