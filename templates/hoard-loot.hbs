{{!--
  Infinity D&D5e — Hoard Loot window template.
  Tier × Hoard Scale drives the budget; the Coin vs. Items slider trades
  raw coin for items. Item count is a soft cap, demoted from the
  main controls. Rarity + loot-type chips default to all-selected.
--}}
<div
  class="hl-shell"
  {{#if lootStudio}}
  id="{{lootStudio.panelId}}"
  role="tabpanel"
  aria-labelledby="{{lootStudio.tabId}}"
  {{/if}}
>
  <form class="hl-form" data-form="hoard-loot" autocomplete="off">
    <header class="hl-form__head">
      <div>
        <h2 class="hl-form__title">Hoard Loot</h2>
        <p class="hl-form__hint">
          Roll a treasure cache. Pick a tier and a scale; the Coin vs. Items slider trades coin for items.
        </p>
      </div>
      <div class="hl-form__budget" aria-live="polite">
        <span class="hl-form__budget-label">Total Treasure</span>
        <strong data-total-budget>{{totalBudgetLabel}}</strong>
        <div class="hl-form__budget-split">
          <span><i class="fa-solid fa-coins" aria-hidden="true"></i> <span data-coin-pile-projected>{{coinPileLabel}}</span> coin</span>
          <span><i class="fa-solid fa-gem" aria-hidden="true"></i> <span data-item-budget>{{itemBudgetLabel}}</span> items</span>
        </div>
        <span class="hl-form__budget-sub {{#if noCandidates}}is-empty{{/if}}" data-candidates title="{{candidateUnavailableReason}}">{{candidateLabel}}</span>
      </div>
      {{> toolMenu}}
    </header>

    {{!-- Tier --}}
    <fieldset class="lf-fieldset">
      <legend class="lf-fieldset__legend">Tier</legend>
      <div class="lf-segment" role="group" aria-label="Tier">
        {{#each tierOptions}}
        <button
          type="button"
          class="lf-segment__btn {{#if selected}}is-active{{/if}}"
          aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
          data-action="tierSelect"
          data-value="{{value}}"
          title="{{label}}"
        >
          <span class="lf-segment__short">{{shortLabel}}</span>
          <span class="lf-segment__long">{{label}}</span>
          {{#if count}}<span class="lf-segment__count">{{count}}</span>{{/if}}
        </button>
        {{/each}}
      </div>
    </fieldset>

    {{!-- Hoard scale --}}
    <fieldset class="lf-fieldset">
      <legend class="lf-fieldset__legend">
        Hoard Scale <small>(rarity defaults follow the scale)</small>
      </legend>
      <div class="lf-segment lf-segment--scale" role="group" aria-label="Hoard scale">
        {{#each scaleOptions}}
        <button
          type="button"
          class="lf-segment__btn {{#if selected}}is-active{{/if}}"
          aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
          data-action="scaleSelect"
          data-value="{{value}}"
          title="{{label}} — ×{{multiplier}} of tier base. {{flavor}}"
        >
          <span class="lf-segment__short">{{label}}</span>
          <span class="lf-segment__long">×{{multiplier}}</span>
        </button>
        {{/each}}
      </div>
    </fieldset>

    {{!-- Coin vs. Items remains visible as the mode's primary shaping control. --}}
    <div class="lf-form__sliders lf-form__sliders--primary">
      {{> hoardSlider pileBias}}
    </div>

    <details class="loot-studio-advanced" data-loot-advanced {{#if lootStudio.advancedOpen}}open{{/if}}>
      <summary>
        <span><i class="fa-solid fa-sliders" aria-hidden="true"></i> Advanced options</span>
        <small>Magic mix, filters, rarity weighting, limits, and art</small>
      </summary>
      <div class="loot-studio-advanced__body">
    <div class="lf-form__sliders">
      {{> hoardSlider magicBias}}
    </div>

    {{!-- Rarity chips (default all selected) --}}
    <fieldset class="lf-fieldset">
      <legend class="lf-fieldset__legend">
        Rarity <small>(no selection = Any)</small>
        <span class="lf-chiprow__bulk">
          <button type="button" class="lf-bulk" data-action="chipAll" data-group="rarity">Select all</button>
          <button type="button" class="lf-bulk" data-action="chipNone" data-group="rarity">Clear selection</button>
        </span>
      </legend>
      <div class="lf-chiprow">
        {{#each rarityOptions}}
        <label class="lf-chip lf-chip--rarity-{{value}} {{#if unavailable}}is-unavailable{{/if}} {{#if partial}}is-partial{{/if}} {{#if selectedUnavailable}}is-selected-unavailable{{/if}}" data-chip-group="rarity" data-chip-value="{{value}}" title="{{availabilityTitle}}" aria-disabled="{{#if disabled}}true{{else}}false{{/if}}">
          <input type="checkbox" name="rarity" value="{{value}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} />
          <span>{{label}}{{#if countKnown}} <em class="lf-chip__count" data-chip-count>{{count}}</em>{{/if}}</span>
        </label>
        {{/each}}
      </div>
    </fieldset>

    {{!-- Rarity balance weights --}}
    <fieldset class="lf-fieldset">
      <legend class="lf-fieldset__legend">Rarity Balance</legend>
      <div class="lf-balance">
        <label class="lf-balance__preset">
          <span>Preset</span>
          <select class="lf-input" name="rarityBalance">
            {{#each rarityBalanceOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <div class="lf-balance__grid" aria-label="Rarity multipliers">
          {{#each rarityWeightRows}}
          <label class="lf-balance__row lf-balance__row--{{rarity}}">
            <span>{{label}}</span>
            <input class="lf-input" type="number" name="rarityWeight.{{rarity}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{weight}}" />
          </label>
          {{/each}}
        </div>
      </div>
    </fieldset>

    {{!-- Loot type chips (default all selected) --}}
    <fieldset class="lf-fieldset">
      <legend class="lf-fieldset__legend">
        Item Types <small>(no selection = Any)</small>
        <span class="lf-chiprow__bulk">
          <button type="button" class="lf-bulk" data-action="chipAll" data-group="lootType">Select all</button>
          <button type="button" class="lf-bulk" data-action="chipNone" data-group="lootType">Clear selection</button>
        </span>
      </legend>
      <div class="lf-chiprow">
        {{#each lootTypeOptions}}
        <label class="lf-chip {{#if unavailable}}is-unavailable{{/if}} {{#if partial}}is-partial{{/if}} {{#if selectedUnavailable}}is-selected-unavailable{{/if}}" data-chip-group="lootType" data-chip-value="{{value}}" title="{{availabilityTitle}}" aria-disabled="{{#if disabled}}true{{else}}false{{/if}}">
          <input type="checkbox" name="lootType" value="{{value}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}} />
          <span>{{label}}{{#if countKnown}} <em class="lf-chip__count" data-chip-count>{{count}}</em>{{/if}}</span>
        </label>
        {{/each}}
      </div>
    </fieldset>

    {{!-- Advanced: max-items + art variants. 0 disables the item-count
         cap; art variants generate unique names and appraisal notes
         for variable-art base items in the pack. --}}
    <div class="hl-advanced">
      <label class="hl-advanced__field">
        <span>Max items <small>(0 = no max)</small></span>
        <input
          class="lf-input hl-advanced__input"
          type="number"
          name="maxItems"
          min="{{maxItemsMin}}"
          max="{{maxItemsMax}}"
          step="1"
          value="{{maxItems}}"
          title="Set to 0 for no item-count cap."
        />
      </label>
      <label class="hl-advanced__field hl-advanced__field--checkbox">
        <input
          type="checkbox"
          name="artVariants"
          {{#if form.artVariants}}checked{{/if}}
        />
        <span>Art variants <small>(unique details for art objects)</small></span>
      </label>
    </div>

    {{> marketFilter}}
      </div>
    </details>

    <div class="lf-form__actions">
      <button type="button" class="lf-btn lf-btn--primary" data-action="generate" data-ready-title="Roll the Hoard (Enter or R)" title="{{#if generateDisabledReason}}{{generateDisabledReason}}{{else}}Roll the Hoard (Enter or R){{/if}}" {{#if generateDisabled}}disabled aria-disabled="true"{{/if}} {{#if loadingItems}}aria-busy="true"{{/if}}>
        <i class="fa-solid fa-sack-dollar" aria-hidden="true"></i>
        <span>Roll the Hoard</span>
      </button>
      <button type="button" class="lf-btn lf-btn--ghost" data-action="reset" title="Restore form defaults">
        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
        <span>Reset Settings</span>
      </button>
      {{#if hasResult}}
      <button type="button" class="lf-btn lf-btn--ghost" data-action="clear" title="Clear the haul, keep settings">
        <i class="fa-solid fa-eraser" aria-hidden="true"></i>
        <span>Clear Haul</span>
      </button>
      {{/if}}
    </div>
  </form>

  <section class="hl-result" aria-live="polite">
    {{#if loadingItems}}
    <div class="lf-result__loading" role="status">
      <span class="lf-skeleton lf-skeleton--lg"></span>
      <span class="lf-skeleton"></span>
      <span class="lf-skeleton lf-skeleton--sm"></span>
      <p class="lf-result__placeholder">Loading items…</p>
    </div>
    {{else if hasResult}}
    <header class="lf-result__head">
      <h3 class="lf-result__title">
        Total — {{result.totalGpLabel}}
      </h3>
      <div class="lf-result__actions">
        <button type="button" class="lf-btn lf-btn--small" data-action="depositHaul" title="Give items + coins to one character">
          <i class="fa-solid fa-share-from-square" aria-hidden="true"></i>
          <span>Give to Character</span>
        </button>
        <button type="button" class="lf-btn lf-btn--small" data-action="sendToChat" title="Post this hoard to chat">
          <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
          <span>Send to Chat</span>
        </button>
        <button type="button" class="lf-btn lf-btn--small" data-action="copyToClipboard" title="Copy a plain-text summary to the clipboard">
          <i class="fa-solid fa-clipboard" aria-hidden="true"></i>
          <span>Copy</span>
        </button>
        <button type="button" class="lf-btn lf-btn--small" data-action="distributeSplit" title="Split the haul across multiple characters">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          <span>Split</span>
        </button>
        <button type="button" class="lf-btn lf-btn--small" data-action="distributeToSelected" title="Split the hoard across the selected canvas tokens' characters">
          <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
          <span>To Selected</span>
        </button>
        <button type="button" class="lf-btn lf-btn--small" data-action="exportJournal" title="Save this hoard to a journal entry">
          <i class="fa-solid fa-book" aria-hidden="true"></i>
          <span>Journal</span>
        </button>
      </div>
    </header>

    {{#if hasCoinPile}}
    <article class="hl-coinpile" aria-label="Coin pile">
      <div class="hl-coinpile__icon"><i class="fa-solid fa-coins" aria-hidden="true"></i></div>
      <div class="hl-coinpile__body">
        <strong class="hl-coinpile__total">{{result.coinPileLabel}}</strong>
        {{#if result.coinBreakdownLabel}}
        <span class="hl-coinpile__breakdown" data-coin-breakdown>{{result.coinBreakdownLabel}}</span>
        {{/if}}
      </div>
    </article>
    {{/if}}

    {{#if result.items.length}}
    <div class="lf-result__search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" class="lf-input" data-result-search placeholder="Filter items…" aria-label="Filter items by name or rarity" />
      <span class="lf-result__search-count" data-search-count aria-live="polite"></span>
    </div>
    <ul class="lf-result__list">
      {{#each result.items}}
      {{> "modules/infinity-dnd5e/templates/loot-result-item.hbs"}}
      {{/each}}
    </ul>
    {{/if}}

    {{#if result.warnings.length}}
    <ul class="lf-result__warnings">
      {{#each result.warnings}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
    {{else}}
    <p class="lf-result__placeholder">
      Click <strong>Roll the Hoard</strong> to generate a treasure cache.
    </p>
    {{/if}}
  </section>
</div>

{{!-- Reusable slider partial --}}
{{#*inline "hoardSlider"}}
<div class="lf-slider">
  <div class="lf-slider__head">
    <label class="lf-slider__label" for="hl-slider-{{name}}">{{label}}</label>
    <span class="lf-slider__value">
      <strong data-readout="{{name}}">{{valueLabel}}</strong>
      {{#if presetLabel}}<em data-preset="{{name}}">{{presetLabel}}</em>{{/if}}
    </span>
  </div>
  <input
    class="lf-slider__input"
    id="hl-slider-{{name}}"
    type="range"
    name="{{name}}"
    min="{{min}}"
    max="{{max}}"
    step="{{step}}"
    value="{{value}}"
  />
  {{#if snaps}}
  <div class="lf-slider__snaps">
    {{#each snaps}}
    <button
      type="button"
      class="lf-slider__snap {{#if active}}is-active{{/if}}"
      aria-pressed="{{#if active}}true{{else}}false{{/if}}"
      data-action="snap"
      data-target="{{../name}}"
      data-value="{{value}}"
    >{{label}}</button>
    {{/each}}
  </div>
  {{/if}}
</div>
{{/inline}}

{{!-- Presets + history + undo menu (see loot-forge.hbs for canonical copy). --}}
{{#*inline "toolMenu"}}
<details class="lf-menu">
  <summary class="lf-menu__trigger" title="Presets, recent rolls & undo" aria-label="Presets and history menu">
    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
  </summary>
  <div class="lf-menu__panel">
    <div class="lf-menu__row">
      <input type="text" class="lf-input lf-menu__name" data-preset-name placeholder="Preset name…" aria-label="New preset name" maxlength="40" />
      <button type="button" class="lf-btn lf-btn--small" data-action="savePreset" title="Save current settings as a preset">
        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span>Save</span>
      </button>
      <button type="button" class="lf-btn lf-btn--small lf-menu__io" data-action="exportPresets" title="Download all presets as a JSON file" aria-label="Export presets">
        <i class="fa-solid fa-file-export" aria-hidden="true"></i>
      </button>
      <button type="button" class="lf-btn lf-btn--small lf-menu__io" data-action="importPresets" title="Import presets from a JSON file" aria-label="Import presets">
        <i class="fa-solid fa-file-import" aria-hidden="true"></i>
      </button>
    </div>
    {{#if hasPresets}}
    <div class="lf-menu__heading">Presets</div>
    <ul class="lf-menu__list">
      {{#each presets}}
      <li class="lf-menu__item">
        <button type="button" class="lf-menu__load" data-action="loadPreset" data-preset-id="{{id}}" title="Load this preset">{{name}}</button>
        <button type="button" class="lf-menu__del" data-action="deletePreset" data-preset-id="{{id}}" title="Delete this preset" aria-label="Delete preset"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if hasHistory}}
    <div class="lf-menu__heading">Recent rolls</div>
    <ul class="lf-menu__list">
      {{#each history}}
      <li class="lf-menu__item">
        <button type="button" class="lf-menu__load" data-action="loadHistory" data-history-id="{{id}}" title="Reopen this roll">{{label}}</button>
      </li>
      {{/each}}
    </ul>
    <button type="button" class="lf-btn lf-btn--small lf-menu__clear" data-action="clearHistory" title="Forget every recent roll">
      <i class="fa-solid fa-trash" aria-hidden="true"></i><span>Clear History</span>
    </button>
    {{/if}}
    {{#if canUndo}}
    <button type="button" class="lf-btn lf-btn--small lf-menu__undo" data-action="undo" title="Undo the last item change">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>Undo</span>
    </button>
    {{/if}}
  </div>
</details>
{{/inline}}

{{!-- Item value filter (see loot-forge.hbs for the canonical copy). --}}
{{#*inline "marketFilter"}}
<fieldset class="lf-fieldset lf-market-filter">
  <legend class="lf-fieldset__legend">
    Item Value <small>(market tier or custom range)</small>
    <span class="lf-chiprow__bulk"><strong data-value-range>{{valueRangeLabel}}</strong></span>
  </legend>
  <div class="lf-market">
    {{#each marketTiers}}
    <button
      type="button"
      class="lf-market__tier {{#if active}}is-active{{/if}}"
      aria-pressed="{{#if active}}true{{else}}false{{/if}}"
      data-action="marketTier"
      data-min="{{min}}"
      data-max="{{max}}"
      title="{{label}} — {{#if max}}items up to {{max}} gp{{else}}no value limit{{/if}}"
    >
      <i class="{{icon}}" aria-hidden="true"></i>
      <span>{{label}}</span>
    </button>
    {{/each}}
  </div>
  <div class="lf-market__range">
    <label class="lf-field lf-field--inline">
      <span class="lf-field__label">Min gp <small>(0 = none)</small></span>
      <input class="lf-input" type="number" name="minItemGp" min="0" step="50" value="{{minItemGp}}" />
    </label>
    <label class="lf-field lf-field--inline">
      <span class="lf-field__label">Max gp <small>(0 = none)</small></span>
      <input class="lf-input" type="number" name="maxItemGp" min="0" step="50" value="{{maxItemGp}}" />
    </label>
  </div>
</fieldset>
{{/inline}}
