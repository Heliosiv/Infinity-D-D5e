{{!--
  Infinity D&D5e — Reputation Workspace (GM).
  Master/detail editor for faction overview, player visibility, and history.
--}}
<div class="rw-shell">
  <header class="rw-head">
    <div class="rw-head__title">
      <h2><i class="fa-solid fa-handshake" aria-hidden="true"></i> Reputation &amp; Factions</h2>
      <p class="rw-head__hint">
        Track each faction's relationship with the party, control exactly what players can see,
        and keep every standing change in one reasoned history.
      </p>
    </div>
    <div class="rw-head__actions">
      <button type="button" class="rw-btn rw-btn--primary" data-action="newFaction" title="Add a faction the party has encountered">
        <i class="fa-solid fa-plus" aria-hidden="true"></i> New Faction
      </button>
    </div>
  </header>

  <p class="infinity-workspace-context" role="note">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    <span><strong>Workspace guide:</strong>
      {{#if selected}}edit the selected faction in Overview, review player visibility separately, then record a reasoned standing change or note in History.
      {{else}}select a faction to review it, or create one after the party meets it.
      {{/if}}
    </span>
  </p>

  <div class="rw-body">
    <aside class="rw-list" aria-label="Factions">
      {{#if hasFactions}}
        <p class="rw-list__summary">{{total}} tracked · {{revealedCount}} revealed</p>
        <ul class="rw-list__items">
          {{#each factions}}
          <li class="rw-list__row {{#if selected}}is-selected{{/if}}">
            <button type="button" class="rw-list__btn" data-action="selectFaction" data-faction-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
              <span class="rw-list__art" style="background-image:url('{{img}}');" aria-hidden="true"></span>
              <span class="rw-list__copy">
                <strong class="rw-list__name">{{name}}</strong>
                <span class="rw-pill rw-pill--{{band}}">{{standingLabel}}</span>
              </span>
              {{#if revealed}}
              <span class="rw-list__eye" title="Revealed to players"><i class="fa-solid fa-eye" aria-hidden="true"></i></span>
              {{/if}}
            </button>
          </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="rw-empty">No factions yet. Click <strong>New Faction</strong> to add the first one the party has met.</p>
      {{/if}}
    </aside>

    <section class="rw-edit" aria-label="Faction editor">
      {{#if selected}}
      <form class="rw-form" data-form="faction-edit" autocomplete="off">
        <nav class="rw-section-nav" aria-label="Faction editor sections">
          <button type="button" data-action="selectSection" data-section-target="rw-section-overview" aria-controls="rw-section-overview">Overview</button>
          <button type="button" data-action="selectSection" data-section-target="rw-section-visibility" aria-controls="rw-section-visibility">Player Visibility</button>
          <button type="button" data-action="selectSection" data-section-target="rw-section-history" aria-controls="rw-section-history">History</button>
        </nav>

        <section id="rw-section-overview" class="rw-workspace-section" aria-labelledby="rw-section-overview-heading" tabindex="-1">
          <div class="rw-workspace-section__head">
            <div>
              <p>Faction record</p>
              <h3 id="rw-section-overview-heading">Overview</h3>
            </div>
            <span>Identity, standing, GM notes, and character-specific context.</span>
          </div>

          <div class="rw-form__head">
            <span class="rw-form__art" style="background-image:url('{{selected.img}}');" aria-hidden="true"></span>
            <div class="rw-form__head-fields">
              <label class="rw-field">
                <span class="rw-field__label">Name</span>
                <input class="rw-input" type="text" name="name" value="{{selected.name}}" />
              </label>
              <label class="rw-field">
                <span class="rw-field__label">Type <small>(e.g. Guild, Noble House, Cult)</small></span>
                <input class="rw-input" type="text" name="category" value="{{selected.category}}" placeholder="Optional" />
              </label>
              <label class="rw-field">
                <span class="rw-field__label">Image</span>
                <div class="rw-field__row">
                  <input class="rw-input" type="text" name="img" value="{{selected.img}}" placeholder="icons/svg/mystery-man.svg" />
                  <button type="button" class="rw-btn rw-btn--icon" data-action="pickImage" title="Browse or upload an image" aria-label="Browse faction image">
                    <i class="fa-solid fa-image" aria-hidden="true"></i>
                  </button>
                </div>
              </label>
            </div>
          </div>

          <section class="rw-standing rw-standing--{{selected.band}}" aria-labelledby="rw-standing-heading">
            <div class="rw-standing__readout">
              <span id="rw-standing-heading" class="rw-standing__tier">{{selected.tier}}</span>
              <span class="rw-standing__score">{{selected.standingLabel}}</span>
            </div>
            <div class="rw-meter" role="img" aria-label="Standing {{selected.standingLabel}}">
              <div class="rw-meter__fill rw-meter__fill--{{selected.band}}" style="width:{{selected.meterPercent}}%;"></div>
            </div>
            <div class="rw-standing-change" data-standing-change>
              <label class="rw-field" for="rw-standing-change-value">
                <span class="rw-field__label">New standing</span>
                <input id="rw-standing-change-value" class="rw-input" type="number" min="-5" max="5" step="1" value="{{selected.standing}}" required aria-required="true" data-role="standing-change-value" aria-describedby="rw-standing-change-help" />
              </label>
              <label class="rw-field" for="rw-standing-change-reason">
                <span class="rw-field__label">Reason <small>(required)</small></span>
                <textarea id="rw-standing-change-reason" class="rw-textarea" rows="2" required aria-required="true" data-role="standing-change-reason" placeholder="What did the party do to change this standing?" aria-label="Reason for standing change"></textarea>
              </label>
              <button type="button" class="rw-btn rw-btn--primary" data-action="changeStanding" aria-describedby="rw-standing-change-help">
                <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> Record Standing Change
              </button>
              <p id="rw-standing-change-help">Choose a different value from −5 to +5 and explain why. The history records the change and reason together.</p>
            </div>
          </section>

          <fieldset class="rw-fieldset">
            <legend>GM Notes <small>(never shown to players)</small></legend>
            <label class="rw-field">
              <span class="rw-field__label">Who they are / what they want</span>
              <textarea class="rw-textarea" name="description" rows="2" placeholder="Background, goals, key NPCs…">{{selected.description}}</textarea>
            </label>
            <label class="rw-field">
              <span class="rw-field__label">Current notes</span>
              <textarea class="rw-textarea" name="gmNotes" rows="2" placeholder="Anything you want to remember.">{{selected.gmNotes}}</textarea>
            </label>
          </fieldset>

          <fieldset class="rw-fieldset">
            <legend>Per-Character <small>(optional — one PC stands apart from the party)</small></legend>
            <div class="rw-perchar" data-perchar-rows>
              {{#if selected.hasPerCharacter}}
                {{#each selected.perCharacter}}
                <div class="rw-perchar__row" data-row-id="{{id}}">
                  <select class="rw-input" data-role="pcActor" data-row-id="{{id}}" aria-label="Character">
                    {{#if unknownActor}}<option value="{{actorId}}" selected>(unknown)</option>{{/if}}
                    {{#each characterOptions}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                    {{/each}}
                  </select>
                  <input class="rw-input rw-input--num" type="number" data-role="pcDelta" data-row-id="{{id}}" value="{{delta}}" min="-5" max="5" step="1" title="Modifier vs. the party standing (display only)" aria-label="Character standing modifier" />
                  <input class="rw-input" type="text" data-role="pcNote" data-row-id="{{id}}" value="{{note}}" placeholder="Why this PC stands apart" aria-label="Character-specific note" />
                  <button type="button" class="rw-btn rw-btn--ghost rw-btn--icon" data-action="removeCharacterNote" data-row-id="{{id}}" title="Remove this note" aria-label="Remove character note">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                  </button>
                </div>
                {{/each}}
              {{else}}
                <p class="rw-empty rw-empty--sm">No per-character notes.{{#unless hasCharacters}} (Add player characters to the world first.){{/unless}}</p>
              {{/if}}
            </div>
            <div class="rw-perchar__foot">
              <button type="button" class="rw-btn" data-action="addCharacterNote" {{#unless hasCharacters}}disabled aria-disabled="true" title="Add player characters to the world first"{{/unless}}>
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i> Add Character Note
              </button>
            </div>
          </fieldset>
        </section>

        <section id="rw-section-visibility" class="rw-workspace-section" aria-labelledby="rw-section-visibility-heading" tabindex="-1">
          <div class="rw-workspace-section__head">
            <div>
              <p>Permission-safe projection</p>
              <h3 id="rw-section-visibility-heading">Player Visibility</h3>
            </div>
            <span>Only the revealed name, standing, and player note leave this GM workspace.</span>
          </div>
          <fieldset class="rw-fieldset">
            <legend>Players</legend>
            <label class="rw-field rw-field--toggle">
              <input type="checkbox" name="revealed" {{#if selected.revealed}}checked{{/if}} />
              <span class="rw-field__label">Reveal this faction to players <small>(shows name, standing, and the note below)</small></span>
            </label>
            <label class="rw-field">
              <span class="rw-field__label">Player-facing note</span>
              <textarea class="rw-textarea" name="playerNote" rows="2" placeholder="What players know about where they stand with this faction.">{{selected.playerNote}}</textarea>
            </label>
          </fieldset>
        </section>

        <section id="rw-section-history" class="rw-workspace-section" aria-labelledby="rw-section-history-heading" tabindex="-1">
          <div class="rw-workspace-section__head">
            <div>
              <p>Audit trail</p>
              <h3 id="rw-section-history-heading">History</h3>
            </div>
            <button type="button" class="rw-btn" data-action="logNote" title="Record a note without changing the standing">
              <i class="fa-solid fa-feather" aria-hidden="true"></i> Log Note
            </button>
          </div>
          <fieldset class="rw-fieldset rw-fieldset--log">
            <legend>Change Log</legend>
            {{#if selected.hasHistory}}
            <ul class="rw-log">
              {{#each selected.history}}
              <li class="rw-log__row">
                <span class="rw-log__delta rw-log__delta--{{deltaTone}}">{{deltaLabel}}</span>
                <div class="rw-log__body">
                  {{#if changed}}<span class="rw-log__swing">{{swing}}</span>{{/if}}
                  {{#if reason}}<span class="rw-log__reason">{{reason}}</span>{{/if}}
                  <span class="rw-log__meta">{{#if by}}{{by}}{{/if}}{{#if when}} · {{when}}{{/if}}</span>
                </div>
              </li>
              {{/each}}
            </ul>
            {{else}}
            <p class="rw-empty rw-empty--sm">No changes logged yet. Record a standing change or add a note to start the history.</p>
            {{/if}}
          </fieldset>
        </section>

        <div class="rw-form__foot">
          <span class="rw-save-status" role="status" aria-live="polite" data-save-status>{{saveStatus}}</span>
          <button type="button" class="rw-btn rw-btn--danger" data-action="deleteFaction">
            <i class="fa-solid fa-trash" aria-hidden="true"></i> Delete Faction
          </button>
          <button type="button" class="rw-btn" data-action="save" title="Save the text fields now (they also auto-save)">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save
          </button>
        </div>
      </form>
      {{else}}
      <div class="rw-edit__empty">
        <i class="fa-solid fa-handshake-slash" aria-hidden="true"></i>
        <p>Select a faction from the list, or add one to get started.</p>
      </div>
      {{/if}}
    </section>
  </div>
</div>
