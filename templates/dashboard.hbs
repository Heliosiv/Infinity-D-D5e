{{!-- Infinity D&D5e — permission-scoped player and Assistant GM launcher. --}}
<div class="id-shell infinity-app-shell">
  <header class="id-head">
    <div class="id-head__title">
      <p class="id-head__eyebrow">{{roleLabel}}</p>
      <h2>Infinity Player Launcher</h2>
      <p class="id-head__hint">{{headingHint}} Reopen this launcher anytime with Shift+I.</p>
    </div>
    <div class="id-head__aside">
      <button type="button" class="id-button id-button--secondary" data-action="help" aria-haspopup="dialog">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
        <span>Help</span>
      </button>
      <span class="id-head__version" aria-label="Infinity D&amp;D5e version {{moduleVersion}}">v{{moduleVersion}}</span>
    </div>
  </header>

  <main class="id-home-content">
    {{#if groups}}
      {{#each groups}}
      <section class="id-section" aria-labelledby="infinity-launcher-group-{{id}}">
        <header class="id-section__head">
          <span class="id-section__icon" aria-hidden="true"><i class="{{icon}}"></i></span>
          <div>
            <h3 id="infinity-launcher-group-{{id}}">{{label}}</h3>
            <p>{{description}}</p>
          </div>
        </header>
        <ul class="id-grid">
          {{#each actions}}
          <li class="id-tile" data-available="{{isAvailable}}">
            <button
              type="button"
              class="id-tile__button"
              data-action="launch"
              data-launch-kind="{{launchKind}}"
              data-launch-id="{{launchId}}"
              aria-disabled="{{ariaDisabled}}"
              aria-describedby="{{statusDescriptionId}}"
            >
              <span class="id-tile__icon" aria-hidden="true"><i class="{{icon}}"></i></span>
              <span class="id-tile__copy">
                <strong class="id-tile__title">{{title}}</strong>
                <span class="id-tile__description">{{description}}</span>
                {{#if statusLabel}}<span class="id-tile__badge">{{statusLabel}}</span>{{/if}}
                <span class="id-tile__status" id="{{statusDescriptionId}}">{{statusReason}}</span>
              </span>
              {{#if isAvailable}}<i class="fa-solid fa-arrow-right id-tile__arrow" aria-hidden="true"></i>{{/if}}
            </button>
          </li>
          {{/each}}
        </ul>
      </section>
      {{/each}}
    {{else}}
      {{!-- Backward-compatible fixture/extension context. --}}
      {{#each categories}}
      <section class="id-section">
        <header class="id-section__head"><div><h3>{{label}}</h3></div></header>
        <ul class="id-grid">
          {{#each tools}}
          <li class="id-tile" data-available="{{isAvailable}}">
            <button
              type="button"
              class="id-tile__button"
              data-action="launch"
              data-launch-kind="tool"
              data-launch-id="{{id}}"
              aria-disabled="{{isComingSoon}}"
            >
              <span class="id-tile__icon" aria-hidden="true"><i class="{{icon}}"></i></span>
              <span class="id-tile__copy">
                <strong class="id-tile__title">{{title}}</strong>
                <span class="id-tile__description">{{description}}</span>
              </span>
            </button>
          </li>
          {{/each}}
        </ul>
      </section>
      {{else}}
      <section class="id-empty" role="status">
        <i class="fa-solid fa-compass" aria-hidden="true"></i>
        <h3>No destinations are ready</h3>
        <p>Nothing changed. Close and reopen the launcher after the module finishes starting.</p>
      </section>
      {{/each}}
    {{/if}}
  </main>

  <footer class="id-foot">
    <p aria-live="polite">Choose an available destination above. Disabled cards explain what is needed.</p>
    <button type="button" class="id-button id-button--secondary" data-action="openSettings">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      <span>Infinity Settings</span>
    </button>
  </footer>
</div>
