{{!--
  Infinity D&D5e — Merchant Workspace template.
  Searchable directory or a focused merchant window with real tab panels.
--}}
<div class="mw-shell {{#if isMerchantEditor}}mw-shell--editor{{else}}mw-shell--directory{{/if}}">
  {{#unless isMerchantEditor}}
  <header class="mw-head">
    <div class="mw-head__title">
      <h2>Merchants</h2>
    </div>
    <div class="mw-head__actions">
      <span class="mw-global-status {{merchantAccessStatusClass}}" role="status">
        <i class="fa-solid {{merchantAccessStatusIcon}}" aria-hidden="true"></i>
        {{merchantAccessStatusLabel}}
      </span>
      {{#if merchantAccessClosed}}
      {{#if globalActiveSessionCount}}
      <button type="button" class="mw-btn mw-btn--danger" data-action="closeAllSessions" title="Close stale player merchant windows without changing the saved global lock">
        <i class="fa-solid fa-window-close" aria-hidden="true"></i> Close Stale
        ({{globalActiveSessionCount}})
      </button>
      {{/if}}
      <button type="button" class="mw-btn mw-btn--primary" data-action="reopenSessions" title="Restore global shop access and reopen the saved player sessions">
        <i class="fa-solid fa-store" aria-hidden="true"></i> Reopen All
        {{#if suspendedSessionCount}}({{suspendedSessionCount}}){{/if}}
      </button>
      {{else}}
      {{#if merchantReopenInterrupted}}
      <button type="button" class="mw-btn mw-btn--primary" data-action="reopenSessions" title="Continue restoring the saved player sessions before starting another global close">
        <i class="fa-solid fa-rotate" aria-hidden="true"></i> Resume restoring
        ({{suspendedSessionCount}})
      </button>
      {{else}}
      <button type="button" class="mw-btn mw-btn--danger" data-action="closeAllSessions" title="Close every player merchant window and block all shop access">
        <i class="fa-solid fa-shop-lock" aria-hidden="true"></i> Close All
        {{#if globalActiveSessionCount}}({{globalActiveSessionCount}}){{/if}}
      </button>
      {{/if}}
      {{/if}}
      <button type="button" class="mw-btn mw-btn--primary" data-action="newMerchant" title="Create a new merchant">
        <i class="fa-solid fa-plus" aria-hidden="true"></i> New Merchant
      </button>
    </div>
  </header>
  {{else}}
  <header class="mw-person-head">
    <h2>{{#if selected}}{{selected.name}}{{else}}Merchant unavailable{{/if}}</h2>
    <span class="mw-save-status" role="status" aria-live="polite" data-save-status>{{saveStatus}}</span>
    <button type="button" class="mw-btn" data-action="save" {{#unless selected}}disabled{{/unless}} title="Edits save automatically; retry a failed save here">Save now</button>
  </header>
  {{/unless}}


  {{#unless canManageMerchants}}
  <div class="mw-global-notice" role="status">
    <i class="fa-solid fa-eye" aria-hidden="true"></i>
    <span>{{merchantAuthorityReason}}</span>
  </div>
  {{/unless}}

  {{#if merchantAccessClosed}}
  <div class="mw-global-notice" role="status">
    <i class="fa-solid fa-circle-pause" aria-hidden="true"></i>
    <span>All shops are closed to players. Reopen All restores access and saved sessions.</span>
  </div>
  {{/if}}

  {{#unless isMerchantEditor}}
  {{#if hasTransactionReviews}}
  <section class="mw-review-panel" aria-labelledby="mw-review-heading">
    <div class="mw-review-panel__head">
      <div>
        <p class="mw-workspace-section__eyebrow">Protected recovery</p>
        <h3 id="mw-review-heading">Transactions needing review</h3>
      </div>
      <p>These trades remain pinned until exact campaign data proves a safe checkpoint.</p>
    </div>
    <div class="mw-review-list">
      {{#each transactionReviews}}
      <article class="mw-review-card">
        <div class="mw-review-card__summary">
          <strong>{{sideLabel}}: {{qty}}x {{itemName}}</strong>
          <span>{{merchantLabel}} · {{actorLabel}} · {{totalGp}} gp · {{playerLabel}}</span>
        </div>
        <p class="mw-review-card__reason">{{reasonLabel}}</p>
        <dl class="mw-review-card__states">
          <div><dt>Actor</dt><dd>{{actorStateLabel}}</dd></div>
          <div><dt>Merchant</dt><dd>{{merchantStateLabel}}</dd></div>
          <div><dt>Last checked</dt><dd>{{checkedAtLabel}}</dd></div>
        </dl>
        <dl class="mw-review-card__checkpoints">
          <div><dt>Actor wallet, saved</dt><dd>{{actorWalletPlanLabel}}</dd></div>
          <div><dt>Actor item, saved</dt><dd>{{actorItemPlanLabel}}</dd></div>
          <div><dt>Actor now</dt><dd>{{actorCurrentLabel}}</dd></div>
          <div><dt>Merchant gold, saved</dt><dd>{{merchantGoldPlanLabel}}</dd></div>
          <div><dt>Merchant stock, saved</dt><dd>{{merchantStockPlanLabel}}</dd></div>
          <div><dt>Merchant now</dt><dd>{{merchantCurrentLabel}}</dd></div>
        </dl>
        <p class="mw-review-card__guidance">If either state does not match a checkpoint, correct the campaign data manually. Do not reset, delete, or force-complete this record.</p>
        <button type="button" class="mw-btn mw-btn--primary" data-action="recheckTransaction" data-review-action-id="{{actionId}}" {{#unless canRecheck}}disabled{{/unless}} title="Read the Actor and Merchant again, then continue only from an exact safe checkpoint">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i> Recheck
        </button>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{/unless}}
  <div class="mw-body">
    {{#unless isMerchantEditor}}
    {{!-- Left rail: merchant list --}}
    <aside class="mw-list" aria-label="Merchants">
      {{#if hasMerchants}}
        <input type="search" class="mw-input mw-directory-search" data-merchant-search placeholder="Find a merchant…" aria-label="Find a merchant" />
        <p class="mw-empty" data-merchant-no-match hidden>No merchants match.</p>
        <ul class="mw-list__items">
          {{#each merchants}}
          <li class="mw-list__row">
            <button type="button" class="mw-list__btn" data-action="selectMerchant" data-merchant-id="{{id}}" aria-haspopup="dialog">
              <span class="mw-list__art" style="background-image:url('{{art}}');" aria-hidden="true"></span>
              <span class="mw-list__copy">
                <strong class="mw-list__name">{{name}}</strong>
                <span class="mw-list__meta">{{itemCount}} item{{#unless itemCountIsOne}}s{{/unless}} · {{allowedCount}} player{{#unless allowedCountIsOne}}s{{/unless}}</span>
              </span>
            </button>
          </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="mw-empty">No merchants yet. Click <strong>New Merchant</strong> to start.</p>
      {{/if}}
    </aside>
    {{else}}

    {{!-- Right pane: editor --}}
    <section class="mw-edit" aria-label="Merchant editor">
      {{#if selected}}
      <form class="mw-form" data-form="merchant-edit" autocomplete="off">
        <nav class="mw-section-nav" role="tablist" aria-label="Merchant sections">
          {{#each merchantTabs}}
          <button type="button" role="tab" id="{{tabId}}" data-action="selectSection" data-merchant-tab="{{key}}" aria-controls="{{panelId}}" aria-selected="{{active}}" tabindex="{{#if active}}0{{else}}-1{{/if}}">{{label}}</button>
          {{/each}}
        </nav>
        <div class="mw-tab-content">


        <section data-merchant-panel="basics" id="{{merchantPanels.basics.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.basics.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.basics.active}}hidden{{/unless}}>
        <div class="mw-form__head">
          <span class="mw-form__art" style="background-image:url('{{selected.art}}');" aria-hidden="true"></span>
          <div class="mw-form__head-fields">
            <label class="mw-field">
              <span class="mw-field__label">Name</span>
              <input class="mw-input" type="text" name="name" value="{{selected.name}}" />
            </label>
            <label class="mw-field">
              <span class="mw-field__label">Art</span>
              <div class="mw-field__row">
                <input class="mw-input" type="text" name="art" value="{{selected.art}}" placeholder="icons/svg/chest.svg" />
                <button type="button" class="mw-btn mw-btn--icon" data-action="pickArt" title="Browse or upload an image">
                  <i class="fa-solid fa-image" aria-hidden="true"></i>
                </button>
              </div>
            </label>
          </div>
        </div>

        <label class="mw-field">
          <span class="mw-field__label">Description / Flavor</span>
          <textarea class="mw-textarea" name="description" rows="2" placeholder="Optional flavor text shown to players.">{{selected.description}}</textarea>
        </label>
        </section>

        <section data-merchant-panel="pricing" id="{{merchantPanels.pricing.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.pricing.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.pricing.active}}hidden{{/unless}}>
<div class="mw-form__grid">
          <label class="mw-field">
            <span class="mw-field__label">Buy price ×</span>
            <input class="mw-input" type="number" name="defaultMarkup" min="0.1" max="5" step="0.05" value="{{selected.defaultMarkup}}" title="Multiplier on the listed price players pay. 1.0 = list price, 1.2 = +20%, 2.0 = double." />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Sell-back ×</span>
            <input class="mw-input" type="number" name="sellRatio" min="0" max="1.5" step="0.05" value="{{selected.sellRatio}}" title="Fraction of an item's value players get when selling to this merchant. 0.5 = half (standard 5e)." />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Gold on Hand</span>
            <input class="mw-input" type="number" name="goldOnHand" min="0" step="1" value="{{selected.goldOnHand}}" placeholder="∞ unlimited" title="Blank = unlimited purse. A literal 0 means the merchant can't buy anything from players." />
          </label>
</div>        </section>

        <section data-merchant-panel="bargaining" id="{{merchantPanels.bargaining.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.bargaining.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.bargaining.active}}hidden{{/unless}}>
<div class="mw-form__grid">
          <label class="mw-field">
            <span class="mw-field__label">Bargain DC</span>
            <input class="mw-input" type="number" name="bargainDC" min="5" max="30" step="1" value="{{selected.bargainDC}}" />
          </label>
          <label class="mw-field mw-field--toggle">
            <span class="mw-field__label">Advantage on Bargain</span>
            <input type="checkbox" name="bargainAdvantage" {{#if selected.bargainAdvantage}}checked{{/if}} />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Discount if Bargain Succeeds</span>
            <input class="mw-input" type="number" name="bargainSuccessPct" min="0" max="100" step="1" value="{{selected.bargainSuccessPct}}" />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Penalty if Bargain Fails</span>
            <input class="mw-input" type="number" name="bargainFailPct" min="0" max="100" step="1" value="{{selected.bargainFailPct}}" />
          </label>
</div>        <fieldset class="mw-fieldset">
          <legend>Allowed Skills</legend>
          <div class="mw-chiprow">
            {{#each skillOptions}}
            <label class="mw-chip">
              <input type="checkbox" name="allowedSkills" value="{{id}}" {{#if checked}}checked{{/if}} />
              <span>{{label}}</span>
            </label>
            {{/each}}
          </div>
        </fieldset>

        </section>
        <section data-merchant-panel="charm" id="{{merchantPanels.charm.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.charm.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.charm.active}}hidden{{/unless}}>
<div class="mw-form__grid">
          <label class="mw-field mw-field--toggle">
            <span class="mw-field__label">Charm affects prices</span>
            <input type="checkbox" name="passiveHaggle" {{#if selected.passiveHaggle}}checked{{/if}} title="On by default: a charismatic shopper automatically shifts prices before any bargain roll." />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Price shift per skill point</span>
            <input class="mw-input" type="number" name="passivePctPerPoint" min="0" max="20" step="0.5" value="{{selected.passivePctPerPoint}}" title="Price shift per point of passive social skill above/below the commoner baseline of 10." />
          </label>
          <label class="mw-field">
            <span class="mw-field__label">Most a price can shift</span>
            <input class="mw-input" type="number" name="passiveCapPct" min="0" max="100" step="1" value="{{selected.passiveCapPct}}" title="Cap on the automatic passive price shift, in either direction." />
          </label>
</div>
        </section>
        <section data-merchant-panel="stock" id="{{merchantPanels.stock.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.stock.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.stock.active}}hidden{{/unless}}>
        <fieldset class="mw-fieldset mw-fieldset--inv">
          <legend>Inventory <small>({{selected.items.length}} {{#if selected.itemCountIsOne}}row{{else}}rows{{/if}})</small></legend>
          {{#if inventoryRows.length}}
          <div class="mw-inv__search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" class="mw-input" data-inv-search placeholder="Filter inventory…" aria-label="Filter inventory by item name" />
            <span class="mw-inv__search-count" data-inv-search-count aria-live="polite"></span>
          </div>
          {{/if}}
          <div class="mw-inv__head">
            <span>Item</span>
            <span title="Current quantity in stock right now.">Qty</span>
            <span title="Restock amount — what 'Restock' resets this item's quantity back to.">Restock to</span>
            <span title="Custom price in gp for this item. Leave blank to use Buy price ×.">Custom gp</span>
            <span class="mw-inv__head-flag" title="Never runs out — unlimited stock.">∞</span>
            <span></span>
            <span></span>
          </div>
          <div class="mw-inv__drop" data-drop-zone="inventory" role="region" aria-label="Inventory — drag items here or use Add From Library below">
            {{#if inventoryRows.length}}
              {{#each inventoryRows}}
              <div class="mw-inv__row {{#if rarity}}mw-inv__row--{{rarity}}{{/if}} {{#if missing}}is-missing{{/if}} {{#if outOfStock}}is-out{{/if}}" data-uuid="{{uuid}}" data-search-text="{{name}}{{#if rarityLabel}} {{rarityLabel}}{{/if}}" title="Double-click to open sheet">
                <div class="mw-inv__name">
                  <span class="mw-inv__icon" style="background-image:url('{{img}}');" aria-hidden="true"></span>
                  <div class="mw-inv__copy">
                    <strong>{{name}}</strong>
                    <span class="mw-inv__meta">{{#unless missing}}<i class="fa-solid fa-coins mw-coin" aria-hidden="true"></i> {{/unless}}{{basePriceLabel}}{{#if rarityLabel}} · <span class="mw-rarity mw-rarity--{{rarity}}">{{rarityLabel}}</span>{{/if}}{{#if missing}} · <em>missing</em>{{/if}}</span>
                  </div>
                </div>
                <input class="mw-input mw-input--num" type="number" data-role="invQty" data-uuid="{{uuid}}" value="{{qtyDisplay}}" min="0" step="1" {{#if unlimited}}disabled{{/if}} aria-label="Quantity for {{name}}" />
                <input class="mw-input mw-input--num" type="number" data-role="invStartQty" data-uuid="{{uuid}}" value="{{startingQty}}" min="0" step="1" aria-label="Restock quantity for {{name}}" />
                <input class="mw-input mw-input--num" type="number" data-role="invPriceOverride" data-uuid="{{uuid}}" value="{{priceOverrideDisplay}}" min="0" step="0.05" placeholder="—" aria-label="Custom price (gp) for {{name}}" />
                <label class="mw-toggle" aria-label="Unlimited stock for {{name}}">
                  <input type="checkbox" data-role="invUnlimited" data-uuid="{{uuid}}" {{#if unlimited}}checked{{/if}} />
                </label>
                <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="openInventoryItem" data-uuid="{{uuid}}" title="Open {{name}}" aria-label="Open {{name}} item sheet">
                  <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                </button>
                <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="invRemove" data-uuid="{{uuid}}" title="Remove from inventory">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
              {{/each}}
            {{else}}
              <p class="mw-empty">Drag items from the sidebar / item library here, or click <strong>Add From Library</strong>.</p>
            {{/if}}
          </div>
          <div class="mw-inv__actions">
            <button type="button" class="mw-btn" data-action="addFromPack">
              <i class="fa-solid fa-box-open" aria-hidden="true"></i> Add From Library
            </button>
            <button type="button" class="mw-btn" data-action="restock">
              <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Restock All
            </button>
            <button type="button" class="mw-btn mw-btn--danger" data-action="clearInventory">
              <i class="fa-solid fa-trash-can" aria-hidden="true"></i> Clear All
            </button>
          </div>
        </fieldset>

        </section>
        <section data-merchant-panel="generate" id="{{merchantPanels.generate.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.generate.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.generate.active}}hidden{{/unless}}>
        <fieldset class="mw-fieldset">
          <legend>Random Stock <small>auto-generated inventory</small></legend>
          <p class="mw-hint">Generate adds stock. Re-Generate replaces it. Ammunition comes in stacks of 20.</p>
          <div class="mw-pool">
            <div class="mw-pool__col">
              <span class="mw-field__label">Item Types</span>
              <div class="mw-chiprow">
                {{#each poolLootTypeOptions}}
                <label class="mw-chip mw-chip--sm">
                  <input type="checkbox" name="poolLootTypes" value="{{value}}" {{#if checked}}checked{{/if}} />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
            </div>
            <div class="mw-pool__col">
              <span class="mw-field__label">Rarities</span>
              <div class="mw-chiprow">
                {{#each poolRarityOptions}}
                <label class="mw-chip mw-chip--sm">
                  <input type="checkbox" name="poolRarities" value="{{value}}" {{#if checked}}checked{{/if}} />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
            </div>
          </div>
          <div class="mw-rarity-balance">
            <label class="mw-field mw-rarity-balance__preset">
              <span class="mw-field__label">Rarity Balance</span>
              <select class="mw-input" name="poolRarityBalance">
                {{#each poolRarityBalanceOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            <div class="mw-rarity-balance__grid" aria-label="Rarity multipliers">
              {{#each poolRarityWeightRows}}
              <label class="mw-rarity-balance__row mw-rarity-balance__row--{{rarity}}">
                <span>{{label}}</span>
                <input class="mw-input mw-input--num" type="number" name="poolRarityWeight.{{rarity}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{weight}}" />
              </label>
              {{/each}}
            </div>
          </div>
          <div class="mw-market">
            <div class="mw-market__head">
              <span class="mw-field__label">Item Value <small>(market tier or custom range)</small></span>
              <strong class="mw-market__range-label" data-pool-value-range>{{poolValueRangeLabel}}</strong>
            </div>
            <div class="mw-market__tiers">
              {{#each poolMarketTiers}}
              <button type="button" class="mw-market__tier {{#if active}}is-active{{/if}}" data-action="marketTier" data-min="{{min}}" data-max="{{max}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" title="{{label}} — {{#if max}}items up to {{max}} gp{{else}}no value limit{{/if}}">
                <i class="{{icon}}" aria-hidden="true"></i> {{label}}
              </button>
              {{/each}}
            </div>
            <div class="mw-market__range">
              <label class="mw-field mw-field--inline">
                <span class="mw-field__label">Min gp <small>(0 = none)</small></span>
                <input class="mw-input mw-input--num" type="number" name="poolMinGp" min="0" step="50" value="{{poolMinGp}}" />
              </label>
              <label class="mw-field mw-field--inline">
                <span class="mw-field__label">Max gp <small>(0 = none)</small></span>
                <input class="mw-input mw-input--num" type="number" name="poolMaxGp" min="0" step="50" value="{{poolMaxGp}}" />
              </label>
            </div>
          </div>
          <div class="mw-pool__foot">
            <label class="mw-field mw-field--inline">
              <span class="mw-field__label">Max items <small>(blank = fill value)</small></span>
              <input class="mw-input mw-input--num" type="number" name="poolCount" min="0" max="50" step="1" value="{{poolCount}}" placeholder="Auto" />
            </label>
            <label class="mw-field mw-field--inline">
              <span class="mw-field__label">Stock value (gp) <small>(0 = none)</small></span>
              <input class="mw-input mw-input--num" type="number" name="poolBudgetGp" min="0" step="50" value="{{poolBudgetGp}}" placeholder="0" aria-label="Stock value budget in gold pieces" />
            </label>
            <button type="button" class="mw-btn mw-btn--primary" data-action="generateStock">
              <i class="fa-solid fa-dice" aria-hidden="true"></i> Generate Stock
            </button>
            <button type="button" class="mw-btn" data-action="regenerateStock" title="Clear all stock, then roll a fresh batch from the pool">
              <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Re-Generate
            </button>
          </div>
        </fieldset>


        </section>
        <section data-merchant-panel="buys" id="{{merchantPanels.buys.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.buys.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.buys.active}}hidden{{/unless}}>
        <fieldset class="mw-fieldset">
          <legend>Buys From Players <small>what this merchant will purchase</small></legend>
          <p class="mw-hint">Pick the item types and/or rarities this merchant buys back from players. Leave everything unchecked to buy anything sellable.{{#if buysAnything}} <strong>Currently buys anything.</strong>{{/if}}</p>
          <div class="mw-pool">
            <div class="mw-pool__col">
              <span class="mw-field__label">Item Types</span>
              <div class="mw-chiprow">
                {{#each buyFilterLootTypeOptions}}
                <label class="mw-chip mw-chip--sm">
                  <input type="checkbox" name="buyFilterLootTypes" value="{{value}}" {{#if checked}}checked{{/if}} />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
            </div>
            <div class="mw-pool__col">
              <span class="mw-field__label">Rarities</span>
              <div class="mw-chiprow">
                {{#each buyFilterRarityOptions}}
                <label class="mw-chip mw-chip--sm">
                  <input type="checkbox" name="buyFilterRarities" value="{{value}}" {{#if checked}}checked{{/if}} />
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>
            </div>
          </div>
          <div class="mw-pool__foot">
            <button type="button" class="mw-btn" data-action="copyStockToBuyFilter" title="Copy the Random Stock item types and rarities into this filter">
              <i class="fa-solid fa-copy" aria-hidden="true"></i> Copy from Random Stock
            </button>
          </div>
        </fieldset>


        </section>
        <section data-merchant-panel="access" id="{{merchantPanels.access.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.access.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.access.active}}hidden{{/unless}}>
          <fieldset class="mw-fieldset">
            <legend>Allowed Players</legend>
            {{#if hasPlayers}}
            <div class="mw-chiprow">
              {{#each playerOptions}}
              <label class="mw-chip">
                <input type="checkbox" name="allowedUserIds" value="{{id}}" {{#if checked}}checked{{/if}} />
                <span>{{name}}</span>
              </label>
              {{/each}}
            </div>
            {{else}}
            <p class="mw-empty">No active player users.</p>
            {{/if}}
            <label class="mw-field mw-field--inline mw-field--selfservice">
              <span class="mw-field__label">Self-Service</span>
              <select class="mw-input" name="selfServiceMode">
                {{#each selfServiceOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            {{#if selfServiceOffWithPlayers}}
            <p class="mw-warn">Self-Service is Off. Players need you to open a session.</p>
            {{/if}}
            <p class="mw-hint">With <strong>Knock</strong>, when a player asks to enter you'll get an Approve / Deny prompt on your screen.</p>
          </fieldset>
        </section>

        <section data-merchant-panel="sessions" id="{{merchantPanels.sessions.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.sessions.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.sessions.active}}hidden{{/unless}}>
        <div class="mw-form__foot">
          <div class="mw-form__foot-right">
            <button type="button" class="mw-btn" data-action="previewSession" title="Open a sandbox shop window to see how buying, selling, and bargaining work — nothing real changes">
              <i class="fa-solid fa-eye" aria-hidden="true"></i> Preview
            </button>
            <button type="button" class="mw-btn mw-btn--primary" data-action="openSession" {{#unless canOpenSession}}disabled{{/unless}} title="{{#if canOpenSession}}Open a live shop session for the allowed player(s){{else}}{{openSessionReason}}{{/if}}">
              <i class="fa-solid fa-store" aria-hidden="true"></i> Open Session
            </button>
          </div>
        </div>

        {{#unless canOpenSession}}
        <p class="mw-session-reason" role="status">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          <strong>Open Session is unavailable:</strong> {{openSessionReason}}
        </p>
        {{/unless}}

        {{#if activeSessions.length}}
        <div class="mw-sessions">
          <h4>Active Sessions</h4>
          <ul>
            {{#each activeSessions}}
            <li>
              <span>{{userLabel}}</span>
              <button type="button" class="mw-btn mw-btn--ghost" data-action="closeSession" data-session-id="{{sessionId}}">
                <i class="fa-solid fa-power-off" aria-hidden="true"></i> Close
              </button>
            </li>
            {{/each}}
          </ul>
        </div>
        {{else}}
        <p class="mw-empty mw-empty--session">No live sessions for this merchant. Preview does not change campaign data.</p>
        {{/if}}
        </section>
        <section data-merchant-panel="manage" id="{{merchantPanels.manage.panelId}}" role="tabpanel" aria-labelledby="{{merchantPanels.manage.tabId}}" class="mw-workspace-section" tabindex="0" {{#unless merchantPanels.manage.active}}hidden{{/unless}}>
          <div class="mw-form__foot">
            <button type="button" class="mw-btn" data-action="duplicateMerchant" title="Create a copy of this merchant with an empty inventory">
              <i class="fa-solid fa-copy" aria-hidden="true"></i> Duplicate
            </button>
            <button type="button" class="mw-btn mw-btn--danger" data-action="deleteMerchant">
              <i class="fa-solid fa-trash" aria-hidden="true"></i> Delete Merchant
            </button>
          </div>
        </section>
        </div>
      </form>
      {{else}}
      <div class="mw-edit__empty">
        <i class="fa-solid fa-shop-lock" aria-hidden="true"></i>
        <p>This merchant was removed. Close this window and choose another merchant.</p>
      </div>
      {{/if}}
    </section>
    {{/unless}}
  </div>
</div>
