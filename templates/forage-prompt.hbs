{{!--
  Infinity D&D5e — Forage Prompt.
  Pushed to a player when a new day begins somewhere they can forage. They roll
  Wisdom (Survival) to gather, or skip; the GM resolves and deposits the yield.
--}}
<div class="fp-shell" aria-busy="{{isWaiting}}">
  <header class="fp-head">
    <i class="fa-solid fa-wheat-awn fp-head__icon" aria-hidden="true"></i>
    <div class="fp-head__copy">
      <h2 class="fp-head__title">Foraging in {{environmentLabel}}</h2>
      {{#if dcLabel}}<p class="fp-head__dc">Foraging {{dcLabel}} (Wisdom · Survival)</p>{{/if}}
    </div>
  </header>

  <section class="fp-context" aria-label="Foraging context">
    <div><span>Character</span><strong>{{#if actorName}}{{actorName}}{{else}}No character selected{{/if}}</strong></div>
    <div><span>Location</span><strong>{{environmentLabel}}</strong></div>
    <div><span>Gathering</span><strong>{{#if forageTargetBoth}}Food and water{{else if forageTargetFood}}Food{{else}}Water{{/if}}</strong></div>
  </section>

  <p class="infinity-session-context" role="status">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    <span><strong>Safe next step:</strong>
      {{#if isWaiting}}wait for the Quartermaster's confirmed tally; do not roll again.
      {{else if offline}}reconnect and verify the day with the GM before repeating any uncertain roll.
      {{else if noActor}}ask the GM to assign a controlled character; no forage request was sent.
      {{else if isPrompt}}choose Roll Survival or Skip foraging. Either choice is recorded once by the active GM.
      {{else}}review the confirmed outcome, then close this prompt when ready.
      {{/if}}
    </span>
  </p>

  {{#if offline}}
  <div class="fp-offline" role="status">
    <i class="fa-solid fa-plug-circle-xmark" aria-hidden="true"></i>
    {{#if isWaiting}}
    <div><strong>Confirmation was interrupted</strong><span>The roll may already have counted. Do not roll again. Keep this window open while the GM reconnects.</span></div>
    {{else if result.timedOut}}
    <div><strong>The outcome is still uncertain</strong><span>Confirmation did not arrive, and the roll may already have counted. Do not roll again; ask the GM to verify the day after reconnecting.</span></div>
    {{else if isPrompt}}
    <div><strong>Foraging is offline</strong><span>No full GM is connected. No roll was sent; try after the GM reconnects.</span></div>
    <button type="button" class="mw-btn" data-action="retryConnection">Check connection</button>
    {{else}}
    <div><strong>The GM is offline</strong><span>The result shown here was already confirmed. You can safely close this window.</span></div>
    {{/if}}
  </div>
  {{/if}}

  {{#if noActor}}
  <p class="fp-empty" role="alert">No character is assigned to you — ask your GM to assign one so you can forage.</p>
  {{else if isPrompt}}
  <section class="fp-body">
    <p class="fp-prompt">Will <strong>{{actorName}}</strong> spend time foraging for {{#if forageTargetBoth}}food and water{{else if forageTargetFood}}food{{else}}water{{/if}} today?</p>
    {{#if passiveLabel}}<p class="fp-hint">{{passiveLabel}}{{#if wisLabel}} · {{wisLabel}}{{/if}}</p>{{/if}}
    <div class="fp-actions">
      <button type="button" class="mw-btn mw-btn--primary" data-action="rollSurvival" {{#if offline}}disabled title="A full GM must be online"{{/if}}>
        <i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Roll Survival
      </button>
      <button type="button" class="mw-btn mw-btn--ghost" data-action="skip" {{#if offline}}disabled title="A full GM must be online"{{/if}}>
        Skip foraging
      </button>
    </div>
  </section>
  {{else if isWaiting}}
  <section class="fp-body fp-body--waiting" {{#unless offline}}role="status" aria-live="polite" aria-atomic="true"{{/unless}}>
    <i class="fa-solid fa-hourglass-half fp-spin" aria-hidden="true"></i>
    <p>Your roll is in — waiting for the quartermaster to tally the haul…</p>
  </section>
  {{else if isDone}}
  <section class="fp-body fp-body--done" {{#unless offline}}role="status" aria-live="polite" aria-atomic="true"{{/unless}}>
    {{#if result.timedOut}}
    <p class="fp-result fp-result--fail">
      <i class="fa-solid fa-clock" aria-hidden="true"></i>
      Confirmation did not arrive. Your roll may already have counted; do not roll again. Check Party Supplies or the chat log, and ask the GM if the result is still unclear.
    </p>
    {{else if result.noResponse}}
    <p class="fp-result fp-result--fail">
      <i class="fa-solid fa-clock" aria-hidden="true"></i>
      Foraging wrapped up before you decided. Nothing was submitted from this window; check the chat log for the day's result.
    </p>
    {{else if result.suppressed}}
    <p class="fp-result">
      <i class="fa-solid fa-people-group" aria-hidden="true"></i>
      You gathered today, but another forager brought in the best haul for the party.
    </p>
    {{else if result.success}}
    <p class="fp-result fp-result--win">
      <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
      {{#if forageTargetBoth}}
      Food: {{#if result.foodSuccess}}{{#if result.foodSuppressed}}gathered, but another food haul was kept{{else}}<strong>+{{result.food}}</strong>{{/if}}{{else}}not found{{/if}}.<br />
      Water: {{#if result.waterSuccess}}{{#if result.waterSuppressed}}gathered, but another water haul was kept{{else}}<strong>+{{result.water}}</strong>{{/if}}{{else}}not found{{/if}}.
      {{else if forageTargetFood}}
      You foraged <strong>+{{result.food}}</strong> food.
      {{else}}
      You foraged <strong>+{{result.water}}</strong> water.
      {{/if}}
    </p>
    {{else}}
    <p class="fp-result fp-result--fail">
      <i class="fa-solid fa-cloud" aria-hidden="true"></i>
      You came up empty-handed today.
    </p>
    {{/if}}
    <div class="fp-actions">
      <button type="button" class="mw-btn" data-action="dismiss">Close</button>
    </div>
  </section>
  {{/if}}
</div>
