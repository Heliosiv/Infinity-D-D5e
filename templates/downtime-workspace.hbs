{{!-- Infinity D&D5e - full-GM Downtime Workspace. --}}
<div class="dt-shell dt-shell--workspace {{#if guided}}dt-shell--guided{{/if}}" aria-busy="{{#if busy}}true{{else}}false{{/if}}">
  <header class="dt-head">
    <div class="dt-head__copy">
      <p class="dt-eyebrow">City actions and personal projects</p>
      <h2><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Downtime Workspace</h2>
      <p>{{#if guided}}Assign downtime, let players choose and roll, then review their results and send reports.{{else}}Assign productive hours, collect each character's queue, then preview and apply one immutable plan.{{/if}}</p>
    </div>
    <div class="dt-head__actions">
      <span class="dt-phase dt-phase--{{workflowTone}}">{{workflowStatusLabel}}</span>
      <button type="button" class="dt-icon-button" data-action="refresh" title="Refresh downtime" aria-label="Refresh downtime" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <nav class="dt-tabs" aria-label="Downtime workspace views">
    <button type="button" data-action="setView" data-view="current" {{#if viewCurrent}}class="is-active" aria-current="page"{{/if}} {{#unless dataAvailable}}disabled{{/unless}}>
      <i class="fa-solid fa-hourglass-start" aria-hidden="true"></i> Current Block
    </button>
    <button type="button" data-action="setView" data-view="activities" {{#if viewActivities}}class="is-active" aria-current="page"{{/if}} {{#unless dataAvailable}}disabled{{/unless}}>
      <i class="fa-solid fa-list-check" aria-hidden="true"></i> Activities
    </button>
    <button type="button" data-action="setView" data-view="projects" {{#if viewProjects}}class="is-active" aria-current="page"{{/if}} {{#unless dataAvailable}}disabled{{/unless}}>
      <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Projects
    </button>
    <button type="button" data-action="setView" data-view="settlements" {{#if viewSettlements}}class="is-active" aria-current="page"{{/if}} {{#unless dataAvailable}}disabled{{/unless}}>
      <i class="fa-solid fa-city" aria-hidden="true"></i> Settlements
    </button>
    <button type="button" data-action="setView" data-view="history" {{#if viewHistory}}class="is-active" aria-current="page"{{/if}} {{#unless dataAvailable}}disabled{{/unless}}>
      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> History
    </button>
  </nav>

  <p class="dt-sr-status" role="status" aria-live="polite" aria-atomic="true">
    {{#if busy}}{{statusMessage}}{{else}}{{#unless hasError}}{{statusMessage}}{{/unless}}{{/if}}
  </p>

  {{#if hasError}}
  <div class="dt-notice dt-notice--danger" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span>{{errorMessage}}</span>
  </div>
  {{/if}}

  {{#if needsRecovery}}
  <div class="dt-notice dt-notice--recovery" role="alert">
    <i class="fa-solid fa-life-ring" aria-hidden="true"></i>
    <div>
      <strong>Recovery checkpoint available</strong>
      <p>{{recoveryMessage}}</p>
    </div>
    <button type="button" class="dt-button {{#if primaryAction.recoverBlock}}dt-button--warning dt-button--next{{/if}}" data-action="recoverBlock" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Verify and recover
    </button>
  </div>
  {{/if}}

  {{#if dataAvailable}}
  <main class="dt-main">
    {{#if viewCurrent}}
      <section class="dt-lifecycle" aria-labelledby="dt-lifecycle-heading">
        <div class="dt-lifecycle__head">
          <div>
            <p class="dt-eyebrow">{{#if guided}}From assignment to results{{else}}Authoritative workflow{{/if}}</p>
            <h3 id="dt-lifecycle-heading">{{#if guided}}Run downtime{{else}}Downtime lifecycle{{/if}}</h3>
          </div>
          {{#unless guided}}<span>Recovery branches only from an interrupted Apply.</span>{{/unless}}
        </div>
        <div class="dt-lifecycle__layout">
          <ol class="dt-lifecycle__steps" aria-label="{{lifecycleLabel}}">
            {{#each lifecycleSteps}}
            <li class="dt-lifecycle__step is-{{state}}" data-step="{{id}}" data-step-state="{{state}}" aria-label="{{label}}: {{stateLabel}}" {{#if current}}aria-current="step"{{/if}}>
              <span class="dt-lifecycle__marker" aria-hidden="true"><i class="fa-solid {{icon}}"></i></span>
              <strong>{{label}}</strong>
              <span class="dt-lifecycle__state">{{stateLabel}}</span>
              <small>{{description}}</small>
              {{#unless @last}}<i class="fa-solid fa-arrow-right dt-lifecycle__arrow" aria-hidden="true"></i>{{/unless}}
            </li>
            {{/each}}
          </ol>
          <aside class="dt-lifecycle__recovery is-{{lifecycleRecovery.state}}" data-step="recovery" data-step-state="{{lifecycleRecovery.state}}" aria-label="Recovery: {{lifecycleRecovery.stateLabel}}" {{#if guided}}{{#unless lifecycleRecovery.current}}hidden{{/unless}}{{/if}} {{#if lifecycleRecovery.current}}aria-current="step"{{/if}}>
            <span class="dt-lifecycle__marker" aria-hidden="true"><i class="fa-solid {{lifecycleRecovery.icon}}"></i></span>
            <div>
              <strong>{{lifecycleRecovery.label}}</strong>
              <span class="dt-lifecycle__state">{{lifecycleRecovery.stateLabel}}</span>
              <small>{{lifecycleRecovery.description}}</small>
            </div>
          </aside>
        </div>
        <p id="dt-next-action" class="dt-next-action infinity-workspace-context {{#unless primaryAction.hasAction}}is-waiting{{/unless}}" role="status">
          <i class="fa-solid {{#if primaryAction.hasAction}}fa-arrow-right{{else}}fa-clock{{/if}}" aria-hidden="true"></i>
          <span><strong>{{#if primaryAction.hasAction}}Next valid action: {{primaryAction.label}}{{else}}{{primaryAction.label}}{{/if}}</strong> {{primaryAction.description}}</span>
        </p>
      </section>

      {{#if hasCurrentBlock}}
      <section class="dt-current" data-block-id="{{currentBlock.id}}" aria-labelledby="dt-current-heading">
        <div class="dt-block-head">
          <div>
            <p class="dt-eyebrow">{{currentBlock.dayLabel}}</p>
            <h3 id="dt-current-heading">{{currentBlock.locationName}}</h3>
            <p>{{#if guided}}Player-controlled hour allocation{{else}}{{#if currentBlock.hasSettlement}}Settlement downtime{{else}}Away from a settlement{{/if}}{{/if}}</p>
            <p>Every eligible character has <strong>{{currentBlock.hours}} hours</strong>. {{#if guided}}They may split it among activity blocks; unallocated time is forfeited.{{else}}Unused time is allowed.{{/if}}</p>
          </div>
          <span class="dt-phase dt-phase--{{currentBlock.statusTone}}">{{currentBlock.statusLabel}}</span>
        </div>

        <div class="dt-command-bar" aria-label="Downtime workflow actions">
          <button type="button" class="dt-button {{#if primaryAction.openForPlayers}}dt-button--primary dt-button--next{{/if}}" data-action="openForPlayers" {{#if guided}}{{#unless currentBlock.canOpenForPlayers}}hidden{{/unless}}{{/if}} {{#if primaryAction.openForPlayers}}aria-describedby="dt-next-action"{{/if}} {{#unless currentBlock.canOpenForPlayers}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Open for players
          </button>
          {{#if guided}}
          <button type="button" class="dt-button {{#if primaryAction.prepareParticipant}}dt-button--primary dt-button--next{{/if}}" data-action="prepareParticipant" data-actor-id="{{currentBlock.firstReadyActorId}}" {{#if primaryAction.prepareParticipant}}aria-describedby="dt-next-action"{{/if}} {{#unless currentBlock.canPrepareAny}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-user-check" aria-hidden="true"></i> Review next submission
          </button>
          {{/if}}
          <button type="button" class="dt-button {{#if primaryAction.lockBlock}}dt-button--primary dt-button--next{{/if}}" data-action="lockBlock" {{#if guided}}hidden{{/if}} {{#if primaryAction.lockBlock}}aria-describedby="dt-next-action"{{/if}} title="{{currentBlock.lockReason}}" {{#unless currentBlock.canLock}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-lock" aria-hidden="true"></i> {{#if guided}}Review results{{else}}Lock submissions{{/if}}
          </button>
          <button type="button" class="dt-button {{#if primaryAction.planBlock}}dt-button--primary dt-button--next{{/if}}" data-action="planBlock" {{#if guided}}hidden{{/if}} {{#if primaryAction.planBlock}}aria-describedby="dt-next-action"{{/if}} title="{{currentBlock.planReason}}" {{#unless currentBlock.canPlan}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-dice-d20" aria-hidden="true"></i> {{#if guided}}Prepare results{{else}}Generate preview{{/if}}
          </button>
          <button type="button" class="dt-button {{#if primaryAction.applyBlock}}dt-button--success dt-button--next{{/if}}" data-action="applyBlock" {{#if guided}}{{#unless currentBlock.canApply}}hidden{{/unless}}{{/if}} {{#if primaryAction.applyBlock}}aria-describedby="dt-next-action"{{/if}} title="{{currentBlock.applyReason}}" {{#unless currentBlock.canApply}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-check-double" aria-hidden="true"></i> {{#if guided}}Apply results &amp; send reports{{else}}Apply exact plan{{/if}}
          </button>
          <button type="button" class="dt-button dt-button--danger dt-command-bar__cancel" data-action="cancelBlock" title="{{currentBlock.cancelReason}}" {{#if guided}}{{#unless currentBlock.canCancel}}hidden{{/unless}}{{/if}} {{#unless currentBlock.canCancel}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-ban" aria-hidden="true"></i> Cancel
          </button>
          {{#if currentBlock.canFinish}}
          <button type="button" class="dt-button" data-action="finishBlock" {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Finish without waiting
          </button>
          {{/if}}
          {{#if currentBlock.canStartNext}}
          <button type="button" class="dt-button {{#if primaryAction.beginNextBlock}}dt-button--primary dt-button--next{{/if}}" data-action="beginNextBlock" {{#if primaryAction.beginNextBlock}}aria-describedby="dt-next-action"{{/if}} {{#if busy}}disabled{{/if}}>
            <i class="fa-solid fa-forward-step" aria-hidden="true"></i> Start next block
          </button>
          {{/if}}
        </div>

        <section class="dt-section" aria-labelledby="dt-submissions-heading">
          {{#if currentBlock.lockReason}}<p class="dt-notice" role="status">{{currentBlock.lockReason}}</p>{{/if}}
          <div class="dt-section__head">
            <div>
              <p class="dt-eyebrow">{{#if guided}}Player choices{{else}}Player queues{{/if}}</p>
              <h3 id="dt-submissions-heading">Submissions</h3>
            </div>
            <span>{{#if guided}}{{currentBlock.resolvedCount}} resolved · {{currentBlock.readyCount}} ready{{else}}{{currentBlock.submittedCount}} / {{currentBlock.participants.length}} submitted{{/if}}</span>
          </div>
          {{#if currentBlock.hasParticipants}}
          <div class="dt-participant-grid">
            {{#each currentBlock.participants}}
            <article class="dt-participant {{#if submitted}}is-submitted{{/if}} {{#if resolved}}is-resolved{{/if}}">
              <header>
                <img src="{{img}}" alt="" />
                <div>
                  <h4>{{name}}</h4>
                  <span>{{#if ../guided}}{{resolutionLabel}}{{else}}{{submissionLabel}}{{/if}} · {{usedHours}} / {{budgetHours}} hours</span>
                </div>
                <strong>{{remainingHours}}h left</strong>
              </header>
              {{#if hasQueue}}
              <ol class="dt-compact-list">
                {{#each queue}}
                <li>
                  <span><strong>{{label}}</strong>{{#if detail}} <small>{{detail}}</small>{{/if}}</span>
                  <span>{{hours}}h{{#if hasOutcome}} · <em class="dt-result dt-result--{{tone}}">{{outcome}}</em>{{/if}}</span>
                </li>
                {{/each}}
              </ol>
              {{else}}
              <p class="dt-inline-empty">No activities queued.</p>
              {{/if}}
              {{#if hasReceipt}}<p class="dt-receipt-summary">{{receipt}}</p>{{/if}}
              {{#if canPrepare}}<button type="button" class="dt-button dt-button--primary" data-action="prepareParticipant" data-actor-id="{{actorId}}" {{#if ../busy}}disabled{{/if}}><i class="fa-solid fa-user-check" aria-hidden="true"></i> Review {{name}}</button>{{/if}}
            </article>
            {{/each}}
          </div>
          {{else}}
          <p class="dt-empty">No eligible characters were assigned to this block.</p>
          {{/if}}
        </section>

        {{#if currentBlock.hasPlan}}
        <section class="dt-section dt-preview" aria-labelledby="dt-preview-heading">
          <div class="dt-section__head">
            <div>
              <p class="dt-eyebrow">{{#if guided}}Recorded player checks{{else}}Immutable write plan {{#if currentBlock.planId}}· {{currentBlock.planId}}{{/if}}{{/if}}</p>
              <h3 id="dt-preview-heading" tabindex="-1">{{#if guided}}{{#if currentBlock.completed}}Completed reports{{else}}Review player results{{/if}}{{else}}GM Preview{{/if}}</h3>
            </div>
            {{#if currentBlock.plannedAt}}<span>Generated {{currentBlock.plannedAt}}</span>{{/if}}
          </div>
          <div class="dt-preview__warning">
            <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
            {{#if guided}}{{#if currentBlock.completed}}These results have been applied and the player reports delivered. Start the next block when the party is ready.{{else if currentBlock.canApply}}Choose a result for each character, then edit the report if needed. Apply results &amp; send reports saves your edits and delivers the results. Player checks are not rolled again.{{else}}These saved results are read-only while application or recovery is in progress.{{/if}}{{else}}Hidden rolls and settlement DCs shown here are GM-only. Applying uses this exact saved plan and never rerolls.{{/if}}
          </div>
          <div class="dt-plan-list">
            {{#each currentBlock.planCharacters}}
            <article>
              <header><h4>{{name}}</h4><span>{{status}}</span></header>
              <ol class="dt-compact-list">
                {{#each operations}}
                <li>
                  <span><strong>{{label}}</strong>{{#if hasRoll}} <small>{{rollLabel}}</small>{{/if}}</span>
                  <em class="dt-result dt-result--{{tone}}">{{outcome}}</em>
                  {{#if workSummary}}<p class="dt-operation-cost" data-work-summary>{{workSummary}}</p>{{/if}}
                  {{#if benefitSummary}}<p class="dt-operation-cost" data-benefit-summary>{{benefitSummary}}</p>{{/if}}
                  {{#if hasOutcomeOptions}}
                  {{#if ../../currentBlock.canApply}}
                  <div class="dt-chip-grid" data-operation-id="{{id}}" data-outcome-index="{{selectedOutcomeIndex}}" aria-label="Choose result for {{label}}">
                    {{#if needsBenefitTarget}}
                    <label class="dt-field dt-field--wide"><span>Patient and injury</span>
                      <select data-benefit-target data-saved-target="{{benefitTarget}}" {{#if ../../busy}}disabled{{/if}}>
                        <option value="">Choose a timed injury</option>
                        {{#each benefitTargets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                      </select>
                    </label>
                    {{/if}}
                    {{#each outcomeOptions}}
                    <button type="button" class="dt-button {{#if selected}}dt-button--primary{{/if}}" data-action="chooseGuidedOutcome" data-operation-id="{{../id}}" data-outcome-index="{{index}}" title="{{report}}" {{#unless ../../../currentBlock.canApply}}disabled{{/unless}} {{#if ../../../busy}}disabled{{/if}} {{#if selected}}aria-pressed="true"{{else}}aria-pressed="false"{{/if}}>{{label}} · {{rewardLabel}}</button>
                    {{/each}}
                    <label class="dt-field dt-field--wide"><span>Player report</span><textarea data-guided-report data-saved-report="{{savedReport}}" rows="3" maxlength="800" aria-label="Player report for {{label}}" {{#unless ../../currentBlock.canApply}}readonly{{/unless}} {{#if ../../busy}}disabled{{/if}}>{{report}}</textarea><small>Choosing another result loads its report. Edits are saved when you apply, or with Save report.</small></label>
                    <button type="button" class="dt-button" data-action="saveGuidedReport" {{#unless ../../currentBlock.canApply}}disabled{{/unless}} {{#if ../../busy}}disabled{{/if}}>Save report</button>
                  </div>
                  {{/if}}
                  {{/if}}
                </li>
                {{/each}}
              </ol>
            </article>
            {{/each}}
          </div>
        </section>
        {{/if}}
      </section>
      {{else}}
      <section class="dt-empty-panel" aria-labelledby="dt-new-block-heading">
        <div class="dt-empty-panel__intro">
          <i class="fa-solid fa-hourglass-start" aria-hidden="true"></i>
          <div>
            <p class="dt-eyebrow">No active block</p>
            <h3 id="dt-new-block-heading">Open a downtime block</h3>
            <p>This assigns the same productive-hour budget to every selected character. Campaign time and Quartermaster upkeep are unchanged.</p>
          </div>
        </div>
        {{#if showQuickStart}}
        <aside class="dt-quick-start" aria-labelledby="dt-quick-start-heading">
          <div class="dt-quick-start__head">
            <div>
              <p class="dt-eyebrow">Quick start</p>
              <h4 id="dt-quick-start-heading">Run the first downtime block</h4>
            </div>
            <button type="button" class="dt-icon-button" data-action="dismissQuickStart" aria-label="Dismiss downtime quick start" title="Dismiss quick start">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>
          <ol>
            <li><strong>Set up:</strong> choose a location, hours, characters, and activities.</li>
            <li><strong>Player allocation:</strong> open the window for players; each splits their hours, rolls any required checks, and submits.</li>
            <li><strong>GM review:</strong> review and apply each submitted character on their own. The block stays open for everyone else.</li>
          </ol>
          <p><i class="fa-solid fa-life-ring" aria-hidden="true"></i> Use Recovery only when this workspace reports an interrupted Apply. Restore this guide from Infinity Settings.</p>
        </aside>
        {{/if}}
        <form class="dt-form" data-form="new-block">
          <label class="dt-field"><span>Settlement</span><select name="settlementId" aria-label="Downtime settlement" {{#if busy}}disabled{{/if}}><option value="">No saved settlement</option>{{#each blockSettlementOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small>A saved settlement supplies its own allowed activities and linked shops.</small></label>
          <label class="dt-field"><span>Location preset</span><select name="locationPresetId" aria-label="Location preset" {{#if blockHasSettlement}}disabled{{/if}} {{#if busy}}disabled{{/if}}>{{#each locationPresetOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>Unavailable activities cannot be selected. Use Custom to define a different situation, or edit the saved settlement.</small></label>
          {{#if blockShopNames}}<p>Linked shops: {{blockShopNames}}</p>{{/if}}
          <label class="dt-field">
            <span>Location</span>
            <input type="text" name="locationName" value="{{newBlockLocation}}" maxlength="120" placeholder="Camp, forest, roadside, ship..." aria-label="Downtime location" {{#if busy}}disabled{{/if}} />
            <small>This is player-facing context for the downtime report.</small>
          </label>
          <div class="dt-field">
            <span id="dt-new-block-hours-label">Productive hours per character</span>
            <div class="dt-hours-row">
              <input type="number" name="hours" min="1" max="240" step="1" value="{{newBlockHours}}" required aria-labelledby="dt-new-block-hours-label" {{#if busy}}disabled{{/if}} />
              <button type="button" data-action="setHourPreset" data-hours="8" {{#if busy}}disabled{{/if}}>1 day</button>
              <button type="button" data-action="setHourPreset" data-hours="16" {{#if busy}}disabled{{/if}}>2 days</button>
              <button type="button" data-action="setHourPreset" data-hours="40" {{#if busy}}disabled{{/if}}>5 days</button>
            </div>
            <small>Day presets use 8 productive hours per day.</small>
          </div>
          <fieldset class="dt-fieldset dt-actor-selector" data-actor-selector aria-describedby="dt-actor-selector-help">
            <legend>Characters for this block</legend>
            {{#if hasActors}}
            <div class="dt-actor-selector__head">
              <p id="dt-actor-selector-help">Player-owned characters are selected by default. Search and filters change only what is shown; hidden selections stay selected until you clear them or restore defaults.</p>
              <div class="dt-actor-counts" role="status" aria-live="polite" aria-atomic="true">
                <strong data-actor-selected-count>{{actorSelector.selectedCount}} selected</strong>
                <span data-actor-visible-count>{{actorSelector.visibleCount}} shown of {{actorSelector.totalCount}} characters</span>
              </div>
            </div>

            <div class="dt-actor-scope" role="group" aria-label="Character groups">
              <button type="button" class="dt-button" data-action="setActorScope" data-actor-scope="player-owned" aria-pressed="{{#if actorSelector.scopePlayerOwned}}true{{else}}false{{/if}}" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-user-group" aria-hidden="true"></i> Player-owned <span>({{actorSelector.playerOwnedCount}})</span>
              </button>
              <button type="button" class="dt-button" data-action="setActorScope" data-actor-scope="other" aria-pressed="{{#if actorSelector.scopeOther}}true{{else}}false{{/if}}" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i> Other <span>({{actorSelector.otherCount}})</span>
              </button>
              <button type="button" class="dt-button" data-action="setActorScope" data-actor-scope="selected" aria-pressed="{{#if actorSelector.scopeSelected}}true{{else}}false{{/if}}" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-circle-check" aria-hidden="true"></i> Selected
              </button>
              <button type="button" class="dt-button" data-action="setActorScope" data-actor-scope="all" aria-pressed="{{#if actorSelector.scopeAll}}true{{else}}false{{/if}}" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-users" aria-hidden="true"></i> All characters <span>({{actorSelector.totalCount}})</span>
              </button>
            </div>

            <div class="dt-actor-controls">
              <label class="dt-actor-filter dt-actor-filter--search">
                <span>Search</span>
                <span class="dt-actor-search">
                  <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                  <input type="search" value="{{actorSelector.query}}" placeholder="Character, owner, or folder" autocomplete="off" aria-label="Search downtime characters" aria-controls="dt-actor-grid" data-actor-query {{#if busy}}disabled{{/if}} />
                </span>
              </label>
              <label class="dt-actor-filter">
                <span>Owner</span>
                <select aria-controls="dt-actor-grid" data-actor-owner-filter {{#if busy}}disabled{{/if}}>
                  <option value="all" {{#if actorSelector.ownerAll}}selected{{/if}}>All owners</option>
                  {{#if actorSelector.hasUnowned}}<option value="unowned" {{#if actorSelector.ownerUnowned}}selected{{/if}}>No player owner</option>{{/if}}
                  {{#each actorSelector.ownerOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                </select>
              </label>
              <label class="dt-actor-filter">
                <span>Folder</span>
                <select aria-controls="dt-actor-grid" data-actor-folder-filter {{#if busy}}disabled{{/if}}>
                  <option value="all" {{#if actorSelector.folderAll}}selected{{/if}}>All folders</option>
                  {{#if actorSelector.hasUnfiled}}<option value="unfiled" {{#if actorSelector.folderUnfiled}}selected{{/if}}>No folder</option>{{/if}}
                  {{#each actorSelector.folderOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                </select>
              </label>
              <label class="dt-actor-filter">
                <span>Sort</span>
                <select aria-controls="dt-actor-grid" data-actor-sort {{#if busy}}disabled{{/if}}>
                  <option value="name-asc" {{#if actorSelector.sortNameAsc}}selected{{/if}}>Name A–Z</option>
                  <option value="name-desc" {{#if actorSelector.sortNameDesc}}selected{{/if}}>Name Z–A</option>
                  <option value="owner" {{#if actorSelector.sortOwner}}selected{{/if}}>Owner, then name</option>
                  <option value="folder" {{#if actorSelector.sortFolder}}selected{{/if}}>Folder, then name</option>
                  <option value="selected-first" {{#if actorSelector.sortSelectedFirst}}selected{{/if}}>Selected first</option>
                </select>
              </label>
            </div>

            <div class="dt-actor-actions" role="group" aria-label="Character selection actions">
              <button type="button" class="dt-button" data-action="restoreActorDefaults" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Restore player defaults
              </button>
              <button type="button" class="dt-button" data-action="selectShownActors" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-check-double" aria-hidden="true"></i> Select shown
              </button>
              <button type="button" class="dt-button" data-action="clearShownActors" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear shown
              </button>
            </div>

            <div class="dt-actor-list" role="region" tabindex="0" aria-label="Available downtime characters">
              <div class="dt-check-grid" id="dt-actor-grid" data-actor-grid>
                {{#each actors}}
                <label
                  class="dt-check {{#unless eligible}}is-disabled{{/unless}}"
                  title="{{reason}}"
                  data-actor-option
                  data-actor-name="{{name}}"
                  data-actor-owner-ids="{{ownerIdsValue}}"
                  data-actor-owner-label="{{ownerLabel}}"
                  data-actor-folder-id="{{folderId}}"
                  data-actor-folder-name="{{folderName}}"
                  data-actor-search="{{searchText}}"
                  data-actor-player-owned="{{#if playerOwned}}true{{else}}false{{/if}}"
                  {{#unless visible}}hidden{{/unless}}
                >
                  <input type="checkbox" name="actorIds" value="{{id}}" data-actor-order="{{order}}" {{#if checked}}checked{{/if}} {{#unless eligible}}disabled{{/unless}} {{#if ../busy}}disabled{{/if}} />
                  <img src="{{img}}" alt="" />
                  <span class="dt-check__copy">
                    <strong class="dt-check__name">{{name}}</strong>
                    <span class="dt-check__meta">
                      <span><i class="fa-solid fa-user" aria-hidden="true"></i> {{ownerLabel}}</span>
                      <span><i class="fa-solid fa-folder" aria-hidden="true"></i> {{#if folderName}}{{folderName}}{{else}}No folder{{/if}}</span>
                    </span>
                    {{#if reason}}<small>{{reason}}</small>{{/if}}
                  </span>
                </label>
                {{/each}}
              </div>
              <p class="dt-inline-empty dt-actor-filter-empty" data-actor-filter-empty {{#if actorSelector.visibleCount}}hidden{{/if}}>No characters match these filters. Change a filter or restore player defaults; your hidden selections are unchanged.</p>
            </div>
            {{else}}
            <p class="dt-inline-empty" id="dt-actor-selector-help">No character Actors are available. Add a character Actor in Foundry, then refresh this workspace.</p>
            {{/if}}
          </fieldset>
          <fieldset class="dt-fieldset" aria-describedby="dt-template-help">
            <legend>Applicable activities</legend>
            <p id="dt-template-help">Players split their assigned hours among these activities in each activity's saved time blocks. Unallocated hours are forfeited when they submit.</p>
            {{#if hasGuidedTemplates}}
            <div class="dt-chip-grid">
              {{#each guidedTemplates}}
              <label class="dt-chip"><input type="checkbox" name="templateIds" value="{{id}}" {{#if checked}}checked{{/if}} {{#if unavailable}}disabled{{/if}} {{#if ../busy}}disabled{{/if}} /><span>{{name}}{{#if unavailable}} — unavailable here{{/if}}</span></label>
              {{/each}}
            </div>
            {{else}}
            <p class="dt-inline-empty">No guided activity templates are available.</p>
            {{/if}}
          </fieldset>
          <fieldset class="dt-fieldset" aria-describedby="dt-project-help">
            <legend>Long-term projects</legend>
            <p id="dt-project-help">Any selected character can allocate one or more saved contribution blocks to the same project. Each allocated hour counts once after the GM applies the result.</p>
            {{#if hasGuidedProjects}}
            <div class="dt-chip-grid">
              {{#each guidedProjects}}
              <label class="dt-chip {{#if complete}}is-disabled{{/if}}" title="{{progressLabel}}">
                <input type="checkbox" name="projectIds" value="{{id}}" {{#if checked}}checked{{/if}} {{#if complete}}disabled{{/if}} {{#if ../busy}}disabled{{/if}} />
                <span>{{name}} <small>{{progressLabel}}</small></span>
              </label>
              {{/each}}
            </div>
            {{else}}
            <p class="dt-inline-empty">No long-term projects yet. Create one in the Projects tab.</p>
            {{/if}}
          </fieldset>
          {{#if createBlockReason}}<p class="dt-form-reason">{{createBlockReason}}</p>{{/if}}
          <footer class="dt-form__actions">
            <button type="button" class="dt-button" data-action="setView" data-view="settlements" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-city" aria-hidden="true"></i> Manage settlements
            </button>
            <button type="button" class="dt-button {{#if primaryAction.createBlock}}dt-button--primary dt-button--next{{/if}}" data-action="createBlock" data-requires-actor-selection data-create-enabled="{{#if canCreateBlock}}true{{else}}false{{/if}}" data-create-busy="{{#if busy}}true{{else}}false{{/if}}" data-base-title="{{createBlockReason}}" aria-describedby="dt-actor-selector-help {{#if primaryAction.createBlock}}dt-next-action{{/if}}" title="{{createBlockReason}}" {{#unless canCreateBlock}}disabled{{/unless}} {{#unless actorSelector.hasSelection}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-hourglass-start" aria-hidden="true"></i> Open block
            </button>
          </footer>
        </form>
      </section>
      {{/if}}
    {{/if}}

    {{#if viewActivities}}
    <section class="dt-settlement-layout" aria-labelledby="dt-activities-editor-heading">
      <aside class="dt-rail">
        <div class="dt-rail__head">
          <div><p class="dt-eyebrow">Your campaign library</p><h3 id="dt-activities-editor-heading">Activities</h3></div>
          <button type="button" class="dt-icon-button" data-action="newGuidedTemplate" title="New activity" aria-label="New activity" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
        </div>
        <ul class="dt-rail__list">
          {{#each guidedTemplates}}
          <li><button type="button" data-action="selectGuidedTemplate" data-template-id="{{id}}" {{#if selected}}class="is-selected" aria-current="true"{{/if}} {{#if ../busy}}disabled{{/if}}><strong>{{name}}</strong><span>{{description}}</span></button></li>
          {{/each}}
        </ul>
      </aside>
      <form class="dt-form" data-form="guided-template" aria-labelledby="dt-template-editor-heading">
        <div class="dt-form__head">
          <div><p class="dt-eyebrow">{{#if templateEditor.id}}Edit activity{{else}}New activity{{/if}}</p><h3 id="dt-template-editor-heading">{{#if templateEditor.id}}{{templateEditor.name}}{{else}}Create an activity{{/if}}</h3></div>
          <p>Changes apply to future blocks. Activities already assigned to players keep their original details and rewards.</p>
        </div>
        <input type="hidden" name="id" value="{{templateEditor.id}}" />
        <label class="dt-field dt-field--wide"><span>Activity name</span><input name="name" value="{{templateEditor.name}}" maxlength="80" required {{#if busy}}disabled{{/if}} /></label>
        <label class="dt-field dt-field--wide"><span>Player description</span><textarea name="description" aria-label="Player description" rows="3" maxlength="400" {{#if busy}}disabled{{/if}}>{{templateEditor.description}}</textarea></label>
        <label class="dt-field dt-field--wide"><span>Activity image (optional)</span><input name="image" value="{{templateEditor.image}}" maxlength="500" placeholder="Image path or URL" {{#if busy}}disabled{{/if}} /><small>Leave blank to use the default activity icon.</small></label>
        <div data-work-output="none arrows bolts needles sling-bullets item scroll learn-spell" {{#if templateEditor.work.isField}}hidden{{/if}}>
        <label class="dt-field"><span>Hours per allocation block</span><input type="number" name="blockHours" min="1" max="240" step="1" value="{{#if (lookup templateEditor "blockHours")}}{{lookup templateEditor "blockHours"}}{{else}}8{{/if}}" required {{#if busy}}disabled{{/if}} /><small>Players may allocate one or more whole blocks. Other crafting recipes use 8-hour workdays.</small></label>
        <fieldset class="dt-fieldset"><legend>Applicable skills</legend><p>Players choose one of these skills. Leave all unchecked for an activity without a roll.</p><div class="dt-chip-grid">{{#each templateEditor.skillOptions}}<label class="dt-chip"><input type="checkbox" name="skills" value="{{id}}" {{#if checked}}checked{{/if}} {{#if ../busy}}disabled{{/if}} /><span>{{label}}</span></label>{{/each}}</div></fieldset>
        </div>
        <fieldset class="dt-fieldset"><legend>Costs, supplies &amp; crafting</legend>
          <p>Review costs, progress and the player's report before applying. Field ammunition uses the Drakmor recipe catalogue below; other outputs use their saved costs and materials.</p>
          <label class="dt-field dt-field--wide"><span>Crafting result</span><select name="workOutput" {{#if busy}}disabled{{/if}}>{{#each templateEditor.work.outputOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <div data-work-output="field-ammunition" {{#unless templateEditor.work.isField}}hidden{{/unless}}>
            <p>Drakmor v1: arrows and bolts produce 5 per 2h; needles and sling bullets produce 5 per 1h. Players use one-hour allocations and choose abstract GP, carried bundles, a mixture, or one hour of wilderness gathering. Each recipe requires a carried tool; confirm proficiency and a working area. Sleight of Hand or Survival resolves crafting; gathering uses Survival.</p>
            <label class="dt-field"><span>Gathering complication chance per hour (%)</span><input type="number" name="fieldRiskPercent" aria-label="Gathering complication chance per hour (%)" min="0" max="100" step="0.01" value="{{#if (lookup templateEditor.work "isField")}}{{lookup templateEditor.work "fieldRiskPercent"}}{{else}}5{{/if}}" {{#if busy}}disabled{{/if}} /></label>
            <p>Players see the final percentage. Gathering is available in Wilderness or Adventuring presets. Camp crafting has 0% exposure. A failure by 1–4 grants half progress and keeps unused funded materials; failure by 5+ consumes only that attempt's time and materials. Gathering discounts: 0 / 25 / 50 / 75%; exceptional means beating the gathering DC by at least 5. Crafting difficulty: arrows/bolts Moderate (13), needles Hard (16), sling bullets Easy (10); gathering Easy (10). Players see difficulty labels only. Complications generate a report prompt for the GM.</p>
          </div>
          <div data-work-output="none arrows bolts needles sling-bullets item scroll learn-spell" {{#if templateEditor.work.isField}}hidden{{/if}}>
          <label class="dt-field"><span>Fee per block (gp)</span><input type="number" name="workGpPerBlock" min="0" max="100000" step="0.01" value="{{templateEditor.work.gpPerBlock}}" required {{#if busy}}disabled{{/if}} /></label>
          <label class="dt-field"><span>Additional cost per workday (gp)</span><input type="number" name="workGpPerDay" min="0" max="100000" step="0.01" value="{{templateEditor.work.gpPerDay}}" required {{#if busy}}disabled{{/if}} /></label>
          <div data-work-output="arrows bolts needles sling-bullets item" {{#unless templateEditor.work.isBatch}}hidden{{/unless}}>
            <label class="dt-field"><span>Hours per batch</span><input type="number" name="workBatchHours" min="1" max="10000" step="1" value="{{templateEditor.work.batchHours}}" required {{#if busy}}disabled{{/if}} /></label>
            <label class="dt-field"><span>Base materials cost per batch (gp)</span><input type="number" name="workBatchGp" min="0" max="100000" step="0.01" value="{{templateEditor.work.batchGp}}" required {{#if busy}}disabled{{/if}} /><small>Paid gradually as hours are worked. Add inventory materials below only if they are additional to this GP cost.</small></label>
          </div>
          <div data-work-output="item" {{#unless templateEditor.work.isItem}}hidden{{/unless}}>
            <label class="dt-field dt-field--wide"><span>Finished item UUID</span><input type="text" name="workItemUuid" aria-label="Finished item UUID" value="{{templateEditor.work.itemUuid}}" maxlength="300" placeholder="Compendium.module.pack.Item.id" {{#if busy}}disabled{{/if}} /><small>Copy the UUID of a world or compendium item.</small></label>
            <label class="dt-field"><span>Items per batch</span><input type="number" name="workQuantity" min="1" max="1000" step="1" value="{{templateEditor.work.quantity}}" required {{#if busy}}disabled{{/if}} /></label>
          </div>
          <p data-work-output="scroll" {{#unless templateEditor.work.isScroll}}hidden{{/unless}}>Scrolls use the 2024 time and base GP cost for their spell level, paid as work progresses. The player picks an owned spell or scroll; the original is kept. Confirm spell preparation, proficiency, material components, and permission to copy an existing scroll. Add any consumed spell components below. Higher-level scrolls can span multiple blocks.</p>
          <fieldset data-work-output="learn-spell" {{#unless templateEditor.work.isLearning}}hidden{{/unless}}><legend>Wizard spellbook learning</legend>
            <p>Choose one discovered Wizard spell per activity. Saving approves access to this source and confirms Wizard-list eligibility. Allocation blocks become 1 hour. Copying costs 2 hours and 50 gp per spell level; 2014 school Savant halves both. Other special features need GM review. Do not add another ink/material charge unless it is extra.</p>
            <label class="dt-field dt-field--wide"><span>Spell UUID (world or compendium spell)</span><input type="text" name="learningUuid" aria-label="Spell UUID (world or compendium spell)" value="{{templateEditor.work.learning.uuid}}" maxlength="300" placeholder="Compendium.module.pack.Item.id" {{#if busy}}disabled{{/if}} /><small>Copy the spell's UUID, not its scroll item's UUID. Saving loads and verifies the spell and its rules edition.</small></label>
            <label class="dt-field dt-field--wide"><span>Study source</span><select name="learningSourceType" {{#if busy}}disabled{{/if}}>{{#each templateEditor.work.learningSources}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="dt-field dt-field--wide"><span>Source name / exact carried scroll name</span><input type="text" name="learningSourceName" aria-label="Source name / exact carried scroll name" value="{{templateEditor.work.learning.sourceName}}" maxlength="100" {{#if busy}}disabled{{/if}} /><small>For a scroll, confirm that this exact inventory name contains the chosen spell and edition. Completion uses Arcana DC 10 + spell level; the scroll is consumed even on failure. Written notes need no roll.</small></label>
            <label class="dt-field dt-field--wide"><span>Required spellbook inventory name (kept)</span><input type="text" name="learningBookName" value="{{templateEditor.work.learning.bookName}}" maxlength="100" {{#if busy}}disabled{{/if}} /></label>
          </fieldset>
          <p>Partial crafting hours carry forward for that character and recipe. Changing the recipe's costs, materials, or output starts separate progress. Ammunition requires appropriate tools in inventory; confirm proficiency before approving.</p>
          <label class="dt-field dt-field--wide"><span>Required tools (all selected are kept)</span><select name="workRequiredTools" aria-label="Required tools (all selected are kept)" aria-describedby="dt-required-tools-help" multiple size="6" {{#if busy}}disabled{{/if}}>{{#each templateEditor.work.toolOptions}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small id="dt-required-tools-help">Select up to eight tools. Hold Ctrl (Command on Mac) to select more than one. The character must carry every selected tool; another character or the party stash does not count. Selected tools replace the default ammunition tool choices. With none selected, ammunition uses its default tools.</small></label>
          <label class="dt-field dt-field--wide"><span>Additional custom tool (kept)</span><input type="text" name="workTool" aria-label="Additional custom tool (kept)" value="{{templateEditor.work.tool}}" maxlength="100" placeholder="Exact inventory item name" {{#if busy}}disabled{{/if}} /></label>
          <details><summary>Inventory materials to consume (optional)</summary>
            <p>Select materials from the item compendium, or choose a custom inventory item. The character must carry enough; matching stacks are combined. Materials are consumed when the GM applies the work. Depleted stacks stay on the sheet with quantity zero.</p>
            {{#each templateEditor.work.materials}}
            <fieldset class="dt-fieldset" data-material-row><legend>Material {{number}}</legend>
              <label class="dt-field dt-field--wide"><span>Material name</span><select name="materialName" aria-label="Material {{number}} name" {{#if ../busy}}disabled{{/if}}>{{#each nameOptions}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="dt-field dt-field--wide" data-custom-material {{#unless isCustom}}hidden{{/unless}}><span>Custom inventory name</span><input type="text" name="materialCustomName" aria-label="Material {{number}} custom inventory name" value="{{customName}}" maxlength="100" {{#if ../busy}}disabled{{/if}} /><small>Match the exact item name on the character's sheet.</small></label>
              <label class="dt-field"><span>Quantity</span><input type="number" name="materialQuantity" value="{{quantity}}" min="1" max="10000" step="1" required {{#if ../busy}}disabled{{/if}} /></label>
              <label class="dt-field"><span>Consume</span><select name="materialPer" {{#if ../busy}}disabled{{/if}}>{{#each perOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </fieldset>
            {{/each}}
          </details>
          </div>
        </fieldset>
        <div class="dt-form__head"><h4>Possible results</h4><p>Field ammunition fixes three result tiers from the saved check, without extra rewards or benefits; its narrative reports remain editable. Other activities use the configured results and rewards per submitted allocation.</p></div>
        {{#each templateEditor.outcomes}}
        <fieldset class="dt-fieldset" data-template-outcome><legend>Result {{number}}</legend>
          <label class="dt-field dt-field--wide"><span>Result label</span><input name="outcomeLabel" value="{{label}}" maxlength="80" required {{#if ../templateEditor.work.isField}}readonly{{/if}} {{#if ../busy}}disabled{{/if}} /></label>
          <label class="dt-field dt-field--wide"><span>Player report</span><textarea name="outcomeReport" aria-label="Player report for result {{number}}" rows="3" maxlength="800" required {{#if ../busy}}disabled{{/if}}>{{report}}</textarea></label>
          <div data-work-output="none arrows bolts needles sling-bullets item scroll learn-spell" {{#if ../templateEditor.work.isField}}hidden{{/if}}>
          <label class="dt-field"><span>Reward (gp)</span><input type="number" name="outcomeReward" min="0" max="100000" step="0.01" value="{{rewardGp}}" required {{#if ../busy}}disabled{{/if}} /></label>
          <label class="dt-field dt-field--wide"><span>Extra benefit</span><select name="outcomeBenefit" aria-label="Extra benefit for result {{number}}" {{#if ../busy}}disabled{{/if}}>
            {{#each benefitOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          </div>
        </fieldset>
        {{/each}}
        <footer class="dt-form__actions"><button type="button" class="dt-button dt-button--primary" data-action="saveGuidedTemplate" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save activity</button></footer>
      </form>
    </section>
    {{/if}}

    {{#if viewProjects}}
    <section class="dt-settlement-layout" aria-labelledby="dt-projects-heading">
      <aside class="dt-rail">
        <div class="dt-rail__head">
          <div><p class="dt-eyebrow">Reusable player choices</p><h3 id="dt-projects-heading">Projects</h3></div>
          <button type="button" class="dt-icon-button" data-action="newGuidedProject" title="New project" aria-label="New project" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
        </div>
        {{#if hasGuidedProjects}}
        <ul class="dt-rail__list">
          {{#each guidedProjects}}
          <li><button type="button" data-action="selectGuidedProject" data-project-id="{{id}}" {{#if selected}}class="is-selected" aria-current="true"{{/if}} {{#if ../busy}}disabled{{/if}}><strong>{{name}}</strong><span>{{progressLabel}}{{#if complete}} · Complete{{/if}}</span></button></li>
          {{/each}}
        </ul>
        {{else}}
        <p class="dt-inline-empty">Pick a preset or create a project, then include it in a downtime block.</p>
        {{/if}}
        <div class="dt-form__actions dt-project-presets" aria-label="Project presets">
          {{#each projectPresets}}<button type="button" class="dt-button" data-action="projectPreset" data-preset="{{id}}" {{#if ../busy}}disabled{{/if}}>Use {{label}}</button>{{/each}}
        </div>
      </aside>
      <form class="dt-form" data-form="guided-project" aria-labelledby="dt-project-create-heading">
        <input type="hidden" name="id" value="{{projectEditor.id}}" />
        <div class="dt-form__head">
          <div><p class="dt-eyebrow">{{#if projectEditor.id}}Edit project{{else}}New project{{/if}}</p><h3 id="dt-project-create-heading">{{#if projectEditor.name}}{{projectEditor.name}}{{else}}Set the requirements{{/if}}</h3></div>
          <p>Players pay the GP gradually as hours are completed. A check at or above the DC adds one success. Failed checks still use the assigned downtime and pay that contribution's GP.</p>
        </div>
        <label class="dt-field dt-field--wide"><span>Project name</span><input type="text" name="name" value="{{projectEditor.name}}" maxlength="80" required placeholder="Learn Draconic, rebuild the watchtower..." {{#if busy}}disabled{{/if}} /></label>
        <label class="dt-field dt-field--wide"><span>Player description</span><textarea name="description" aria-label="Project description" rows="3" maxlength="400" placeholder="What the characters are working toward." {{#if busy}}disabled{{/if}}>{{projectEditor.description}}</textarea></label>
        <label class="dt-field"><span>Hours per contribution block</span><input type="number" name="blockHours" aria-label="Hours per contribution block" min="1" max="240" step="1" value="{{#if (lookup projectEditor "blockHours")}}{{lookup projectEditor "blockHours"}}{{else}}8{{/if}}" required {{#if busy}}disabled{{/if}} /><small>Eight productive hours is one D&amp;D workday.</small></label>
        <label class="dt-field"><span>Total productive hours</span><input type="number" name="requiredHours" aria-label="Total productive hours" min="1" max="10000" step="1" value="{{projectEditor.requiredHours}}" required {{#if busy}}disabled{{/if}} /><small>Eight productive hours is one workday.</small></label>
        <label class="dt-field"><span>Total project cost (gp)</span><input type="number" name="requiredGp" aria-label="Total project cost (gp)" min="0" max="100000" step="0.01" value="{{projectEditor.requiredGp}}" required {{#if busy}}disabled{{/if}} /><small>This total is divided across the required hours.</small></label>
        <label class="dt-field"><span>Successful checks required</span><input type="number" name="requiredSuccesses" aria-label="Successful checks required" min="0" max="1000" step="1" value="{{projectEditor.requiredSuccesses}}" required {{#if busy}}disabled{{/if}} /><small>Use 0 for a project that only needs time and GP.</small></label>
        <label class="dt-field"><span>Check DC</span><input type="number" name="checkDc" aria-label="Check DC" min="5" max="40" step="1" value="{{projectEditor.checkDc}}" required {{#if busy}}disabled{{/if}} /></label>
        <fieldset class="dt-fieldset"><legend>Applicable skills</legend><p>Players choose one for each contribution. Choose at least one if successes are required.</p><div class="dt-chip-grid">{{#each projectEditor.skillOptions}}<label class="dt-chip"><input type="checkbox" name="skills" value="{{id}}" {{#if checked}}checked{{/if}} {{#if ../busy}}disabled{{/if}} /><span>{{label}}</span></label>{{/each}}</div></fieldset>
        <footer class="dt-form__actions"><button type="button" class="dt-button dt-button--primary" data-action="saveGuidedProject" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{#if projectEditor.id}}Save changes{{else}}Add project{{/if}}</button></footer>
      </form>
    </section>
    {{/if}}

    {{#if viewSettlements}}
    <section class="dt-settlement-layout" aria-labelledby="dt-settlements-heading">
      <aside class="dt-rail">
        <div class="dt-rail__head">
          <div><p class="dt-eyebrow">Saved city profiles</p><h3 id="dt-settlements-heading">Settlements</h3></div>
          <button type="button" class="dt-icon-button" data-action="newSettlement" title="New settlement" aria-label="New settlement">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </div>
        {{#if hasSettlements}}
        <ul class="dt-rail__list">
          {{#each settlements}}
          <li>
            <button type="button" data-action="selectSettlement" data-settlement-id="{{id}}" {{#if selected}}class="is-selected" aria-current="true"{{/if}}>
              <strong>{{name}}</strong>
              <span>{{wealthLabel}} · {{securityLabel}} · {{merchantCount}} merchants</span>
            </button>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="dt-inline-empty">No settlements saved yet.</p>
        {{/if}}
      </aside>

      <div class="dt-editor">
        {{#if hasSelectedSettlement}}
        <form class="dt-form" data-form="settlement-edit">
          <input type="hidden" name="id" value="{{selectedSettlement.id}}" />
          <div class="dt-section__head">
            <div>
              <p class="dt-eyebrow">{{#if selectedSettlement.creating}}New profile{{else}}Settlement profile{{/if}}</p>
              <h3>{{#if selectedSettlement.name}}{{selectedSettlement.name}}{{else}}New Settlement{{/if}}</h3>
            </div>
          </div>
          <div class="dt-form-grid">
            <label class="dt-field dt-field--wide">
              <span>Name</span>
              <input type="text" name="name" value="{{selectedSettlement.name}}" maxlength="100" required />
            </label>
            <label class="dt-field">
              <span>Wealth tier</span>
              <select name="wealthTier">
                {{#each selectedSettlement.wealthOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            <label class="dt-field">
              <span>Security tier</span>
              <select name="securityTier">
                {{#each selectedSettlement.securityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
            <label class="dt-field">
              <span>Market DC</span>
              <input type="number" name="marketDc" min="1" max="40" step="1" value="{{selectedSettlement.marketDc}}" required />
            </label>
            <label class="dt-field">
              <span>Linked faction</span>
              <select name="factionId">
                {{#each selectedSettlement.factionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
          </div>

          <fieldset class="dt-fieldset">
            <legend>Downtime activities at this settlement</legend>
            <label class="dt-field"><span>Start from a preset</span><select name="locationPresetId" aria-label="Location preset">{{#each selectedSettlement.locationPresetOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <div class="dt-chip-grid">{{#each selectedSettlement.guidedActivityOptions}}<label class="dt-chip"><input type="checkbox" name="guidedTemplateIds" value="{{id}}" {{#if checked}}checked{{/if}} /><span>{{label}}</span></label>{{/each}}</div>
          </fieldset>
          <fieldset class="dt-fieldset">
            <legend>Legacy city activities</legend>
            <div class="dt-chip-grid">
              {{#each selectedSettlement.activityOptions}}
              <label class="dt-chip"><input type="checkbox" name="enabledActivities" value="{{id}}" {{#if checked}}checked{{/if}} /><span>{{label}}</span></label>
              {{/each}}
            </div>
          </fieldset>

          <fieldset class="dt-fieldset">
            <legend>Linked merchants</legend>
            <p>These shops belong to this downtime profile. Linking does not move shops in the Shops directory or change their opening status. Legacy shoplifting uses only finite, non-quest stock.</p>
            {{#if selectedSettlement.hasMerchants}}
            <div class="dt-chip-grid">
              {{#each selectedSettlement.merchantOptions}}
              <label class="dt-chip"><input type="checkbox" name="merchantIds" value="{{id}}" {{#if checked}}checked{{/if}} /><span>{{label}}</span></label>
              {{/each}}
            </div>
            {{else}}
            <p class="dt-inline-empty">No merchants are available to link.</p>
            {{/if}}
          </fieldset>

          <footer class="dt-form__actions">
            {{#if selectedSettlement.id}}
            <button type="button" class="dt-button dt-button--danger" data-action="deleteSettlement" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-trash" aria-hidden="true"></i> Delete
            </button>
            {{/if}}
            <button type="button" class="dt-button dt-button--primary" data-action="saveSettlement" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save settlement
            </button>
          </footer>
        </form>
        {{else}}
        <div class="dt-editor__empty">
          <i class="fa-solid fa-city" aria-hidden="true"></i>
          <p>Select a settlement or create a new one.</p>
          <button type="button" class="dt-button dt-button--primary" data-action="newSettlement">New settlement</button>
        </div>
        {{/if}}
      </div>
    </section>
    {{/if}}

    {{#if viewHistory}}
    <section class="dt-history" aria-labelledby="dt-history-heading">
      <div class="dt-section__head">
        <div><p class="dt-eyebrow">Applied and cancelled blocks</p><h3 id="dt-history-heading">Downtime History</h3></div>
        <span>{{history.length}} receipts</span>
      </div>
      {{#if hasHistory}}
      <div class="dt-history__list">
        {{#each history}}
        <article>
          <div>
            <h4>{{locationName}}</h4>
            <p>{{hours}} hours · {{characterCount}} characters{{#if when}} · {{when}}{{/if}}</p>
            {{#if summary}}<small>{{summary}}</small>{{/if}}
          </div>
          <span class="dt-phase dt-phase--{{statusTone}}">{{statusLabel}}</span>
        </article>
        {{/each}}
      </div>
      {{else}}
      <p class="dt-empty">No downtime blocks have been completed or cancelled yet.</p>
      {{/if}}
    </section>
    {{/if}}
  </main>
  {{/if}}
</div>
