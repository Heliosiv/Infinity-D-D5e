{{!-- Infinity D&D5e - player-facing Downtime Activities. --}}
<div class="dt-shell dt-shell--activities" aria-busy="{{#if ariaBusy}}true{{else}}false{{/if}}">
  <header class="dt-head dt-player-head">
    <div class="dt-head__copy">
      <p class="dt-eyebrow">{{#if hasActiveBlock}}{{locationName}}{{else}}Downtime and personal projects{{/if}}</p>
      <h2><i class="fa-solid fa-moon" aria-hidden="true"></i> Downtime Activities</h2>
      <p>Spend only the hours you want. Your queue resolves from top to bottom after the GM locks it.</p>
    </div>
    <div class="dt-head__actions">
      <span class="dt-phase dt-phase--{{statusTone}}">{{statusLabel}}</span>
      <button type="button" class="dt-icon-button" data-action="refresh" title="Refresh downtime" aria-label="Refresh downtime" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <p class="dt-sr-status" role="status" aria-live="polite" aria-atomic="true">
    {{#if busy}}{{statusMessage}}{{else if hasError}}{{else}}{{statusMessage}}{{/if}}
  </p>

  <p class="infinity-session-context" role="status">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    <span><strong>Safe next step:</strong>
      {{#if busy}}wait for the current request to finish before changing the queue.
      {{else if needsRecovery}}wait for the GM's review; do not resubmit this block.
      {{else if noGm}}reconnect, then refresh and verify the saved queue or receipt before repeating anything.
      {{else if hasActiveBlock}}{{#if actor}}review {{actor.name}}'s remaining hours, then add or reorder activities if the block is still open.{{else}}choose an eligible character when the GM has assigned one.{{/if}}
      {{else}}wait for the GM to open a downtime block; no activity was submitted.
      {{/if}}
    </span>
  </p>

  {{#if hasError}}
  <div class="dt-notice dt-notice--danger" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span>{{errorMessage}}</span>
    <button type="button" class="dt-button" data-action="refresh" {{#if busy}}disabled{{/if}}>Try again</button>
  </div>
  {{/if}}

  {{#if needsRecovery}}
  <div class="dt-notice dt-notice--recovery" role="status">
    <i class="fa-solid fa-life-ring" aria-hidden="true"></i>
    <div><strong>The GM is reviewing this block</strong><p>{{recoveryMessage}}</p></div>
  </div>
  {{/if}}

  {{#if noGm}}
  <div class="dt-state-panel">
    <i class="fa-solid fa-plug-circle-xmark" aria-hidden="true"></i>
    <h3>No full GM is online</h3>
    <p>Your last receipt is still shown below. No new request can start. If one was interrupted, refresh after reconnection and verify the saved queue or receipt before repeating it.</p>
    <button type="button" class="dt-button" data-action="refresh" {{#if busy}}disabled{{/if}}>Try again</button>
  </div>
  {{else if hasActiveBlock}}
    {{#if actor}}
      {{#if hasMultipleActors}}
      <nav class="dt-actor-tabs" aria-label="Eligible characters">
        {{#each actors}}
          {{#if eligible}}
          <button type="button" data-action="selectActor" data-actor-id="{{id}}" {{#if selected}}class="is-active" aria-current="true"{{/if}} {{#if ../busy}}disabled{{/if}}>
            <img src="{{img}}" alt="" /> <span>{{name}}</span>
          </button>
          {{/if}}
        {{/each}}
      </nav>
      {{/if}}

      <section class="dt-player-summary" aria-label="Character downtime summary">
        <div class="dt-player-summary__actor">
          <img src="{{actor.img}}" alt="" />
          <div><span class="dt-player-summary__label">Active character</span><strong>{{actor.name}}</strong><span>{{locationName}}</span></div>
        </div>
        <div class="dt-time-meter">
          <div><span>Time budget</span><strong>{{usedHours}} / {{budgetHours}} hours</strong></div>
          <progress max="{{budgetHours}}" value="{{usedHours}}" aria-label="{{usedHours}} of {{budgetHours}} downtime hours used">{{progressPercent}}%</progress>
          <small>{{remainingHours}} hours unassigned · unused time is allowed</small>
        </div>
        {{#if hasSettlement}}
        <div class="dt-heat" title="Heat is personal and applies only in this settlement">
          <span>Local Heat</span>
          <div class="dt-heat__pips" role="img" aria-label="Heat {{heat}} out of 5">
            {{#each heatPips}}<i class="fa-solid fa-fire-flame-curved {{#if active}}is-active{{/if}}" aria-hidden="true"></i>{{/each}}
          </div>
          {{#if heatBlocked}}<small>Crime is blocked until you Lay Low.</small>{{else if heatMessage}}<small>{{heatMessage}}</small>{{else}}<small>{{heat}} / 5</small>{{/if}}
        </div>
        {{else}}
        <div class="dt-heat" title="No settlement is selected for this block">
          <span>Location</span>
          <strong>Outside a settlement</strong>
          <small>Settlement-only activities are unavailable here.</small>
        </div>
        {{/if}}
      </section>

      {{#if editable}}
      <nav class="dt-categories" aria-label="Activity categories">
        {{#each categories}}
        <button type="button" data-action="selectCategory" data-category="{{id}}" {{#if selected}}class="is-active" aria-current="true"{{/if}} {{#if ../busy}}disabled{{/if}}>{{label}}</button>
        {{/each}}
      </nav>
      {{/if}}

      <div class="dt-player-layout">
        <section class="dt-activity-pane" aria-labelledby="dt-activity-heading">
          <div class="dt-section__head">
            <div><p class="dt-eyebrow">Choose work</p><h3 id="dt-activity-heading">Activities</h3></div>
          </div>
          {{#if editable}}
            {{#if hasActivities}}
            <div class="dt-activity-list" data-activity-list tabindex="-1">
              {{#each activities}}
              <article class="dt-activity-card {{#unless available}}is-unavailable{{/unless}}" data-activity-id="{{id}}" data-fixed-hours="{{fixedHours}}" aria-labelledby="dt-activity-{{id}}">
                <header>
                  <span class="dt-activity-card__icon"><i class="{{icon}}" aria-hidden="true"></i></span>
                  <div><span>{{categoryLabel}}</span><h4 id="dt-activity-{{id}}">{{label}}</h4></div>
                  <strong data-selected-hours>{{selectedHoursLabel}}</strong>
                </header>
                <p>{{description}}</p>
                {{#if costLabel}}<small class="dt-activity-card__cost"><i class="fa-solid fa-coins" aria-hidden="true"></i> {{costLabel}}</small>{{/if}}
                {{#if limitLabel}}<small class="dt-activity-card__limit"><i class="fa-solid fa-gauge" aria-hidden="true"></i> {{limitLabel}}</small>{{/if}}

                {{#if available}}
                <div class="dt-activity-fields">
                  {{#if hasHourOptions}}
                  <label class="dt-field">
                    <span>Time</span>
                    <select name="hours" data-activity-input aria-label="Time for {{label}}">
                      {{#each hourOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                  {{else}}
                  <input type="hidden" name="hours" value="{{fixedHours}}" data-activity-input />
                  {{/if}}

                  {{#if hasSkills}}
                  <label class="dt-field">
                    <span>Approach</span>
                    <select name="skill" data-activity-input aria-label="Approach for {{label}}">
                      {{#each skills}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                  {{/if}}

                  {{#if hasTargets}}
                  <label class="dt-field dt-field--wide">
                    <span>{{#if multiTarget}}Goods to fence{{else}}Target{{/if}}</span>
                    {{#if multiTarget}}
                    <select name="targetIds" multiple size="5" data-activity-input required aria-label="Goods to fence for {{label}}" aria-describedby="dt-target-help-{{id}}">
                      {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}{{#if detail}} · {{detail}}{{/if}}</option>{{/each}}
                    </select>
                    <small id="dt-target-help-{{id}}">Select any combination that fits this activity's value capacity. On desktop, use Ctrl or Cmd to select more than one.</small>
                    {{else}}
                    <select name="targetId" data-activity-input aria-label="Target for {{label}}">
                      {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}{{#if detail}} · {{detail}}{{/if}}</option>{{/each}}
                    </select>
                    {{/if}}
                  </label>
                  {{/if}}

                  {{#if hasItems}}
                  <label class="dt-field dt-field--wide">
                    <span>Item</span>
                    <select name="{{targetField}}" data-activity-input aria-label="Item for {{label}}">
                      {{#each items}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}{{#if detail}} · {{detail}}{{/if}}</option>{{/each}}
                    </select>
                  </label>
                  {{/if}}

                  {{#if stakeAllowed}}
                  <label class="dt-field">
                    <span>Stake (gp)</span>
                    <input type="number" name="stakeGp" min="{{stakeStepGp}}" max="{{maxStakeGp}}" step="{{stakeStepGp}}" value="{{stakeValueGp}}" data-activity-input required aria-label="Stake in gold pieces for {{label}}" />
                  </label>
                  {{/if}}
                </div>
                <button type="button" class="dt-button dt-button--primary dt-activity-card__add" data-action="addActivity" aria-label="Add {{label}} to queue" {{#if ../busy}}disabled{{/if}}>
                  <i class="fa-solid fa-plus" aria-hidden="true"></i> Add to queue
                </button>
                {{else}}
                <div class="dt-prerequisite" role="note">
                  <i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{unavailableReason}}
                </div>
                {{/if}}
              </article>
              {{/each}}
            </div>
            {{else}}
            <p class="dt-empty">No activities match this category.</p>
            {{/if}}
          {{else}}
          <div class="dt-state-inline">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
            <p>{{#if canRecall}}Your queue is submitted. Recall it if you need to edit.{{else if submitted}}Your queue is submitted and locked. It will resolve exactly as shown.{{else}}Activity editing is closed while the GM resolves this block.{{/if}}</p>
          </div>
          {{/if}}
        </section>

        <aside class="dt-queue" aria-labelledby="dt-queue-heading">
          <details class="dt-queue__drawer" open>
          <summary id="dt-queue-heading"><span><i class="fa-solid fa-list-check" aria-hidden="true"></i><span><small>Resolves in order</small><strong>Your Queue</strong></span></span><strong>{{usedHours}}h</strong></summary>
          {{#if hasQueue}}
          <ol class="dt-queue__list" data-queue-list tabindex="-1">
            {{#each queue}}
            <li data-queue-entry-id="{{id}}" tabindex="-1">
              <span class="dt-queue__position">{{position}}</span>
              <span class="dt-queue__icon"><i class="{{icon}}" aria-hidden="true"></i></span>
              <div><strong>{{label}}</strong><span class="dt-queue__detail" {{#if detail}}title="{{detail}}"{{/if}}>{{hours}} hours{{#if detail}} · {{detail}}{{/if}}</span></div>
              <div class="dt-queue__actions">
                <button type="button" data-action="moveActivityUp" data-queue-entry-id="{{id}}" title="Move earlier" aria-label="Move {{label}} earlier" {{#unless canMoveUp}}disabled{{/unless}} {{#unless ../editable}}disabled{{/unless}} {{#if ../busy}}disabled{{/if}}>
                  <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="moveActivityDown" data-queue-entry-id="{{id}}" title="Move later" aria-label="Move {{label}} later" {{#unless canMoveDown}}disabled{{/unless}} {{#unless ../editable}}disabled{{/unless}} {{#if ../busy}}disabled{{/if}}>
                  <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="is-danger" data-action="removeActivity" data-queue-entry-id="{{id}}" title="Remove" aria-label="Remove {{label}}" {{#unless ../editable}}disabled{{/unless}} {{#if ../busy}}disabled{{/if}}>
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
            </li>
            {{/each}}
          </ol>
          {{else}}
          <p class="dt-inline-empty">Choose an activity to start your queue.</p>
          {{/if}}

          <footer class="dt-queue__footer">
            {{#if submitReason}}<p>{{submitReason}}</p>{{/if}}
            {{#if submitted}}
              {{#if canRecall}}
              <button type="button" class="dt-button" data-action="recallSubmission" {{#if busy}}disabled{{/if}}>
                <i class="fa-solid fa-pen" aria-hidden="true"></i> Recall and edit
              </button>
              {{else}}
              <span class="dt-submitted"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Submitted</span>
              {{/if}}
            {{else}}
            <button type="button" class="dt-button dt-button--success" data-action="submitQueue" title="{{submitReason}}" {{#unless canSubmit}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Submit queue
            </button>
            {{/if}}
          </footer>
          </details>
        </aside>
      </div>
    {{else}}
    <div class="dt-state-panel" role="status">
      <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
      <h3>No eligible character</h3>
      <p>The GM has not assigned one of your characters to this downtime block.</p>
    </div>
    {{/if}}
  {{else}}
  <div class="dt-state-panel" role="status">
    <i class="fa-solid fa-hourglass" aria-hidden="true"></i>
    <h3>No active downtime block</h3>
    <p>The GM will assign a location, eligible characters, and a productive-hour budget when downtime begins. A settlement is optional.</p>
  </div>
  {{/if}}

  {{#if hasReceipt}}
  <section class="dt-receipt" aria-labelledby="dt-receipt-heading">
    <div class="dt-section__head">
      <div><p class="dt-eyebrow">GM-and-owner receipt</p><h3 id="dt-receipt-heading">Latest Results</h3></div>
      {{#if receipt.completedAt}}<span>{{receipt.completedAt}}</span>{{/if}}
    </div>
    {{#if receipt.summary}}<p>{{receipt.summary}}</p>{{/if}}
    {{#if receipt.hasActivities}}
    <ul>
      {{#each receipt.activities}}
      <li class="dt-result-row dt-result-row--{{tone}}"><strong>{{label}}</strong><span>{{summary}}</span></li>
      {{/each}}
    </ul>
    {{/if}}
  </section>
  {{/if}}
</div>
