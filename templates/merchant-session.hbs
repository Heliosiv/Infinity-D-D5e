{{!--
  Infinity D&D5e — Merchant Session template.
  Pushed to a player's client when the GM opens a session. Player
  browses, bargains, buys, sells.
--}}
<div class="ms-shell">
  <header class="ms-head">
    <span class="ms-head__art" style="background-image:url('{{merchant.art}}');" aria-hidden="true"></span>
    <div class="ms-head__title">
      <h2>{{merchant.name}}</h2>
      {{#if merchant.description}}
      <p class="ms-head__desc">{{merchant.description}}</p>
      {{/if}}
      {{#if merchantGoldLabel}}<span class="ms-head__coffer"><i class="fa-solid fa-vault" aria-hidden="true"></i> Shop Gold: {{merchantGoldLabel}}</span>{{/if}}
      {{#if passiveHaggleLabel}}<span class="ms-head__haggle"><i class="fa-solid fa-comments-dollar" aria-hidden="true"></i> {{passiveHaggleLabel}}</span>{{/if}}
    </div>
    <div class="ms-head__purse">
      {{#if canSwitchActor}}
      <label class="ms-head__actor-picker">
        <span>Shopping character</span>
        <select data-role="merchant-actor" aria-label="Shopping character" {{#if actorSwitchLocked}}disabled{{/if}}>
          {{#if needsActorChoice}}<option value="" selected>Choose a character</option>{{/if}}
          {{#each actorOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      {{else}}
      <span class="ms-head__actor"><img src="{{actorImg}}" alt="" /> {{actorName}}</span>
      {{/if}}
      <span class="ms-head__purse-label">Available wallet</span>
      <strong class="ms-head__purse-value">{{walletLabel}}</strong>
      {{#if canSwitchActor}}<small class="ms-head__purse-help">{{#if actorSwitchLocked}}Finish or confirm the current action before switching.{{else}}Wallet and inventory follow this selection.{{/if}}</small>{{/if}}
    </div>
  </header>

  {{#if previewMode}}
  <div class="ms-preview-banner" role="note">
    <i class="fa-solid fa-eye" aria-hidden="true"></i>
    <span>Preview — nothing real changes. Buy, sell &amp; bargain are simulated and logged{{#if previewNoActor}}; pick a character when opening to try selling or bargaining{{/if}}.</span>
  </div>
  {{/if}}

  <section class="ms-transaction ms-transaction--{{transactionTone}}" role="status" aria-live="polite" aria-atomic="true" aria-busy="{{#if transactionBusy}}true{{else}}false{{/if}}" aria-label="Transaction status">
    <i class="fa-solid {{#if transactionBusy}}fa-hourglass-half{{else if offline}}fa-plug-circle-xmark{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
    <div>
      <strong>{{transactionTitle}}</strong>
      <span>{{transactionMessage}}</span>
    </div>
    <dl class="ms-session-totals" aria-label="Session totals">
      <div><dt>Spent</dt><dd>{{sessionSpentValue}}</dd></div>
      <div><dt>Earned</dt><dd>{{sessionEarnedValue}}</dd></div>
    </dl>
  </section>

  <p class="infinity-session-context" role="status">
    <i class="fa-solid fa-compass" aria-hidden="true"></i>
    <span><strong>Safe next step:</strong>
      {{#if transactionBusy}}wait for the active GM's confirmed result before starting another trade.
      {{else if offline}}reconnect, then refresh this shop; do not repeat an interrupted trade.
      {{else if noActor}}choose a controlled character before buying or selling.
      {{else if buyActive}}select an item and quantity, then review the exact total before buying.
      {{else}}select one of your items, then review the exact total before selling.
      {{/if}}
    </span>
  </p>

  {{#if noActor}}
  <div class="ms-context-warning" role="alert">
    <i class="fa-solid fa-user-clock" aria-hidden="true"></i>
    <span>{{#if needsActorChoice}}Choose one of your controlled characters above before buying or selling.{{else}}No controlled character is available. Ask your GM to assign one or grant Owner permission, then reopen this shop.{{/if}} Nothing has changed.</span>
  </div>
  {{/if}}

  <div class="ms-toolbar">
    <nav class="ms-tabs" role="tablist" aria-label="Trade direction">
      <button type="button" id="ms-tab-buy-{{domId}}" class="ms-tab {{#if buyActive}}is-active{{/if}}" data-action="selectTab" data-tab="buy" role="tab" tabindex="{{#if buyActive}}0{{else}}-1{{/if}}" aria-selected="{{#if buyActive}}true{{else}}false{{/if}}" aria-controls="ms-panel-buy-{{domId}}">
        <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Buy
      </button>
      <button type="button" id="ms-tab-sell-{{domId}}" class="ms-tab {{#if sellActive}}is-active{{/if}}" data-action="selectTab" data-tab="sell" role="tab" tabindex="{{#if sellActive}}0{{else}}-1{{/if}}" aria-selected="{{#if sellActive}}true{{else}}false{{/if}}" aria-controls="ms-panel-sell-{{domId}}">
        <i class="fa-solid fa-coins" aria-hidden="true"></i> Sell
      </button>
    </nav>
    <label class="ms-search" for="ms-search-{{domId}}">
      <span class="ms-visually-hidden">Search {{#if buyActive}}goods for sale{{else}}your sellable items{{/if}}</span>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input id="ms-search-{{domId}}" type="search" data-role="item-search" value="{{searchQuery}}" placeholder="Search {{#if buyActive}}shop goods{{else}}your items{{/if}}" aria-label="Search {{#if buyActive}}goods for sale{{else}}your sellable items{{/if}}" autocomplete="off" />
    </label>
    <p class="ms-visually-hidden" data-role="item-search-status" role="status" aria-live="polite"></p>
  </div>

  {{#unless buyActive}}
  <section id="ms-panel-buy-{{domId}}" role="tabpanel" aria-labelledby="ms-tab-buy-{{domId}}" hidden></section>
  {{/unless}}

  {{#if buyActive}}
  <section class="ms-rows" id="ms-panel-buy-{{domId}}" role="tabpanel" tabindex="0" aria-labelledby="ms-tab-buy-{{domId}}" aria-label="Goods for sale">
    {{#if buyRows.length}}
      {{#each buyRows}}
      <article class="ms-row {{#if rarity}}ms-row--{{rarity}}{{/if}} {{#if outOfStock}}is-out{{/if}} {{#if missing}}is-missing{{/if}}" data-uuid="{{uuid}}" title="Double-click to open sheet">
        <span class="ms-row__icon" style="background-image:url('{{img}}');" aria-hidden="true"></span>
        <div class="ms-row__copy">
          <strong class="ms-row__name">{{name}}</strong>
          <span class="ms-row__meta">
            {{#if rarityLabel}}<span class="ms-rarity ms-rarity--{{rarity}}">{{rarityLabel}}</span>{{/if}}
            {{stockLabel}}
            {{#if sealLabel}}<span class="ms-seal" title="Bargained price">{{sealLabel}}</span>{{/if}}
            {{#if passiveActive}}<span class="ms-haggle" title="Automatic price change from your character's people skills — bargain to roll for more.">{{haggleLabel}}</span>{{/if}}
            {{#if cannotBuyReason}}<span class="ms-row__warn">{{cannotBuyReason}}</span>{{/if}}
          </span>
        </div>
        <div class="ms-row__price">
          {{#if priceDeltaLabel}}
          <span class="ms-row__base">{{baseLabel}}</span>
          <strong class="ms-row__final"><i class="fa-solid fa-coins ms-coin" aria-hidden="true"></i>{{finalLabel}}</strong>
          <span class="ms-row__delta {{deltaClass}}">{{priceDeltaLabel}}</span>
          {{else}}
          <strong class="ms-row__final"><i class="fa-solid fa-coins ms-coin" aria-hidden="true"></i>{{finalLabel}}</strong>
          {{/if}}
        </div>
        <div class="ms-row__actions">
          <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="openItem" data-uuid="{{uuid}}" title="View item details" aria-label="View item details for {{name}}">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          </button>
          <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="bargainBuy" data-uuid="{{uuid}}" {{#if bargainLocked}}disabled{{/if}} title="{{#if bargainPending}}Haggling…{{else}}Bargain — one attempt; failing raises the price{{/if}}" aria-label="{{#if bargainPending}}Haggling in progress on {{name}}{{else}}Bargain on {{name}}{{/if}}">
            <i class="fa-solid {{#if bargainPending}}fa-hourglass-half{{else}}fa-comments-dollar{{/if}}" aria-hidden="true"></i>
          </button>
          <input class="mw-input mw-input--num" type="number" data-role="buyQty" data-uuid="{{uuid}}" min="1" max="{{maxQty}}" value="1" {{#if cannotBuy}}disabled{{else if transactionUncertain}}disabled{{/if}} title="Quantity of {{name}} to buy" aria-label="Quantity of {{name}} to buy" />
          <button type="button" class="mw-btn mw-btn--primary" data-action="buyN" data-uuid="{{uuid}}" aria-label="{{#if transactionUncertain}}Retry confirmation for {{name}}{{else if transactionWaiting}}Confirming purchase of {{name}}{{else}}Buy {{name}}{{/if}}" {{#if cannotBuy}}disabled{{/if}}>
            {{#if transactionUncertain}}Retry confirmation{{else if transactionWaiting}}Confirming…{{else}}Buy{{/if}}
          </button>
        </div>
      </article>
      {{/each}}
      <p class="mw-empty" data-role="item-search-empty" hidden>No shop goods match that search. Clear it to show every item.</p>
    {{else}}
      <p class="mw-empty">This merchant has nothing on display. Nothing changed; check back after the GM restocks the shop.</p>
    {{/if}}
  </section>
  {{/if}}

  {{#unless sellActive}}
  <section id="ms-panel-sell-{{domId}}" role="tabpanel" aria-labelledby="ms-tab-sell-{{domId}}" hidden></section>
  {{/unless}}

  {{#if sellActive}}
  <section class="ms-rows" id="ms-panel-sell-{{domId}}" role="tabpanel" tabindex="0" aria-labelledby="ms-tab-sell-{{domId}}" aria-label="Your sellable items">
    {{#if sellRows.length}}
      {{#each sellRows}}
      <article class="ms-row {{#if rarity}}ms-row--{{rarity}}{{/if}} {{#if stolen}}is-stolen{{/if}}" data-item-id="{{itemId}}" data-uuid="{{uuid}}" title="Double-click to open sheet">
        <span class="ms-row__icon" style="background-image:url('{{img}}');" aria-hidden="true"></span>
        <div class="ms-row__copy">
          <strong class="ms-row__name">{{name}}</strong>
          <span class="ms-row__meta">
            {{#if rarityLabel}}<span class="ms-rarity ms-rarity--{{rarity}}">{{rarityLabel}}</span>{{/if}}
            You have {{ownedQty}}
            {{#if sealLabel}}<span class="ms-seal" title="Bargained payout">{{sealLabel}}</span>{{/if}}
            {{#if passiveActive}}<span class="ms-haggle" title="Automatic payout change from your character's people skills — bargain to roll for more.">{{haggleLabel}}</span>{{/if}}
            {{#if cannotSellReason}}<span class="ms-row__warn">{{cannotSellReason}}</span>{{/if}}
            {{#if goldLimited}}<span class="ms-row__warn">{{affordLabel}}</span>{{/if}}
          </span>
        </div>
        <div class="ms-row__price">
          {{#if stolen}}
          <strong class="ms-row__final"><i class="fa-solid fa-mask-face" aria-hidden="true"></i>Fencing only</strong>
          {{else if priceDeltaLabel}}
          <span class="ms-row__base">{{baseLabel}}</span>
          <strong class="ms-row__final"><i class="fa-solid fa-coins ms-coin" aria-hidden="true"></i>{{finalLabel}}</strong>
          <span class="ms-row__delta {{deltaClass}}">{{priceDeltaLabel}}</span>
          {{else}}
          <strong class="ms-row__final"><i class="fa-solid fa-coins ms-coin" aria-hidden="true"></i>{{finalLabel}}</strong>
          {{/if}}
        </div>
        <div class="ms-row__actions">
          <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="openItem" data-uuid="{{uuid}}" title="View item details" aria-label="View item details for {{name}}">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          </button>
          <button type="button" class="mw-btn mw-btn--ghost mw-btn--icon" data-action="bargainSell" data-item-id="{{itemId}}" {{#if bargainLocked}}disabled{{/if}} title="{{#if bargainPending}}Haggling…{{else}}Bargain — one attempt; failing lowers the payout{{/if}}" aria-label="{{#if bargainPending}}Haggling in progress on {{name}}{{else}}Bargain on {{name}}{{/if}}">
            <i class="fa-solid {{#if bargainPending}}fa-hourglass-half{{else}}fa-comments-dollar{{/if}}" aria-hidden="true"></i>
          </button>
          <input class="mw-input mw-input--num" type="number" data-role="sellQty" data-item-id="{{itemId}}" min="1" max="{{maxSellQty}}" value="1" title="Quantity of {{name}} to sell" aria-label="Quantity of {{name}} to sell" {{#if cannotSell}}disabled{{else if transactionUncertain}}disabled{{/if}} />
          <button type="button" class="mw-btn mw-btn--primary" data-action="sellN" data-item-id="{{itemId}}" aria-label="{{#if transactionUncertain}}Retry confirmation for {{name}}{{else if transactionWaiting}}Confirming sale of {{name}}{{else}}Sell {{name}}{{/if}}" {{#if cannotSell}}disabled{{/if}}>{{#if transactionUncertain}}Retry confirmation{{else if transactionWaiting}}Confirming…{{else}}Sell{{/if}}</button>
        </div>
      </article>
      {{/each}}
      <p class="mw-empty" data-role="item-search-empty" hidden>No sellable items match that search. Clear it to show every item.</p>
    {{else}}
      {{#if noActor}}
      <p class="mw-empty">No character to sell from{{#if previewMode}} — pick one when opening the preview{{else}} — ask your GM to assign a character you own or grant Owner permission{{/if}}.</p>
      {{else}}
      <p class="mw-empty">No sellable items are available on this character. Switch characters outside this session or return after your inventory changes.</p>
      {{/if}}
    {{/if}}
  </section>
  {{/if}}

  {{#if log.length}}
  <footer class="ms-log" aria-label="Transaction log">
    <h4>This session{{#if sessionSpentLabel}} · spent {{sessionSpentLabel}}{{/if}}{{#if sessionEarnedLabel}} · earned {{sessionEarnedLabel}}{{/if}}</h4>
    <ul>
      {{#each log}}
      <li class="{{kind}}">{{text}}</li>
      {{/each}}
    </ul>
  </footer>
  {{/if}}
</div>
