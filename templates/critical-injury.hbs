<div class="ci-shell">
  <header class="ci-hero">
    <img class="ci-portrait" src="{{actorImg}}" alt="" />
    <div>
      <p class="ci-eyebrow">Critical Injury Table V2</p>
      <h2>{{actorName}}</h2>
      <p>Roll approved injuries, follow recovery, and request treatment.</p>
      {{#if hasActorOptions}}
        <label class="ci-actor-picker">
          <span>Active character</span>
          <select
            data-role="critical-injury-actor"
            aria-describedby="ci-actor-help-{{domId}}"
            aria-disabled="{{actorSelectDisabled}}"
            {{actorSelectDisabledAttribute}}
          >
            {{#if needsActorChoice}}<option value="" selected>Choose a character</option>{{/if}}
            {{#each actorOptions}}
              <option value="{{id}}" {{selectedAttribute}}>{{name}}</option>
            {{/each}}
          </select>
          <small id="ci-actor-help-{{domId}}">
            {{#if actorSwitchLocked}}
              Wait for the current action to finish before switching.
            {{else if canSwitchActor}}
              Injury history and treatment actions follow this selection.
            {{else}}
              This is the character you currently control.
            {{/if}}
          </small>
        </label>
      {{/if}}
    </div>
  </header>

  {{#if noActor}}
    <div class="ci-notice ci-notice--danger" role="alert">
      <span><strong>This character is no longer available to you.</strong>
        Nothing changed. Choose a controlled character above, or close this
        window.</span>
    </div>
  {{else}}
    {{#if offline}}
      <div class="ci-notice ci-notice--danger" role="status">
        <i class="fa-solid fa-plug-circle-xmark" aria-hidden="true"></i>
        {{#if outcomeUncertain}}
          <span><strong>Confirmation was interrupted.</strong>
            A roll or treatment may already have changed this character. Do not
            repeat the action. Keep this window open while the GM reconnects.</span>
        {{else}}
          <span><strong>Injury actions are offline.</strong>
            No full GM is connected. No new action can start; approved rolls and
            treatment can resume after reconnection.</span>
        {{/if}}
      </div>
    {{/if}}
    {{#unless integrations.automationReady}}
      <div class="ci-notice">
        Midi-QOL and DAE are recommended for automatic penalties. The injury
        record and recovery rules will still be applied without them.
      </div>
    {{/unless}}
    {{#unless integrations.calendarActive}}
      <div class="ci-notice">
        Simple Calendar is not active, so recovery dates cannot be added to the
        campaign calendar.
      </div>
    {{/unless}}

    <p
      class="ci-status ci-status--{{statusTone}}"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >{{statusMessage}}</p>

    {{#if hasPending}}
      <section
        class="ci-roll-card"
        aria-labelledby="ci-roll-heading-{{domId}}"
        aria-busy="{{waitingForRoll}}"
      >
        <span class="ci-roll-icon"><i
            class="fa-solid fa-dice-d20"
            aria-hidden="true"
          ></i></span>
        <div>
          <p class="ci-eyebrow">GM approved</p>
          <h3 id="ci-roll-heading-{{domId}}">Roll your critical injury</h3>
          <p>
            Your character recovered from 0 hit points or the dead state. The
            active GM securely rolls and applies the d100 result when you click
            below.
          </p>
          {{#if pendingCount}}
            <small>{{pendingCount}} approved roll(s) waiting</small>
          {{/if}}
        </div>
        <button
          type="button"
          class="ci-primary"
          data-action="rollInjury"
          aria-disabled="{{rollActionDisabled}}"
          title="{{rollActionTitle}}"
          {{rollActionDisabledAttribute}}
        >
          {{#if waitingForRoll}}
            <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
            Waiting for GM…
          {{else}}
            <i class="fa-solid fa-dice" aria-hidden="true"></i>
            Roll d100
          {{/if}}
        </button>
      </section>
    {{/if}}

    {{#if hasLatestResult}}
      <section class="ci-result" aria-labelledby="ci-result-heading-{{domId}}">
        <div class="ci-result-roll">{{latestResult.injuryRoll}}</div>
        <div>
          <p class="ci-eyebrow">GM-authoritative result</p>
          <h3 id="ci-result-heading-{{domId}}">{{latestResult.injuryName}}</h3>
          {{#if latestResult.detailLabel}}
            <p><strong>{{latestResult.detailLabel}}</strong></p>
          {{/if}}
          <p>{{latestResult.effect}}</p>
          <p class="ci-recovery">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            {{latestResult.recoveryLabel}}
            {{#if latestResult.dueLabel}} · {{latestResult.dueLabel}}{{/if}}
          </p>
        </div>
      </section>
    {{/if}}

    <section class="ci-list" aria-labelledby="ci-active-heading-{{domId}}">
      <div class="ci-section-heading">
        <div>
          <p class="ci-eyebrow">Character effects</p>
          <h3 id="ci-active-heading-{{domId}}">Active injuries</h3>
        </div>
        <span>{{activeInjuries.length}}</span>
      </div>

      {{#if hasActiveInjuries}}
        {{#each activeInjuries}}
          <article
            class="ci-injury {{permanentClass}}"
            aria-labelledby="{{headingId}}"
          >
            <div class="ci-injury-heading">
              <div>
                <span class="ci-roll-badge">d100 {{roll}}</span>
                <h4 id="{{headingId}}">{{name}}</h4>
              </div>
              {{#if permanent}}
                <span class="ci-tag ci-tag--danger">Permanent</span>
              {{else if stabilized}}
                <span class="ci-tag ci-tag--success">Stabilized</span>
              {{/if}}
            </div>

            {{#if detailLabel}}<p><strong>{{detailLabel}}</strong></p>{{/if}}
            <p>{{effect}}</p>
            <dl class="ci-facts">
              <div>
                <dt>Recovery</dt>
                <dd>{{recoveryLabel}}{{#if dueLabel}} · {{dueLabel}}{{/if}}</dd>
              </div>
              <div>
                <dt>Rule</dt>
                <dd>{{recoveryRule}}</dd>
              </div>
              {{#if automatedChanges}}
                <div>
                  <dt>Automation</dt>
                  <dd>{{automatedChanges}} character penalty change(s)</dd>
                </div>
              {{/if}}
            </dl>

            {{#if canTreat}}
              <div class="ci-treatment" aria-busy="{{treating}}">
                <div>
                  <strong>Healer's Kit: {{kitCharges}} charge(s)</strong>
                  <span>{{treatmentCheck}}</span>
                </div>
                <button
                  type="button"
                  data-action="requestTreatment"
                  aria-label="{{treatmentActionLabel}}"
                  aria-disabled="{{treatmentDisabled}}"
                  title="{{treatmentActionTitle}}"
                  data-injury-id="{{id}}"
                  {{treatmentDisabledAttribute}}
                >
                  {{#if treating}}
                    <i
                      class="fa-solid fa-spinner fa-spin"
                      aria-hidden="true"
                    ></i>
                    Waiting…
                  {{else}}
                    <i class="fa-solid fa-kit-medical" aria-hidden="true"></i>
                    Request treatment
                  {{/if}}
                </button>
              </div>
              {{#if treatmentMessage}}<p
                  class="ci-treatment-message"
                >{{treatmentMessage}}</p>{{/if}}
            {{/if}}
          </article>
        {{/each}}
      {{else}}
        <div class="ci-empty">
          <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
          <p>No active critical injuries. No action is needed.</p>
        </div>
      {{/if}}
    </section>
  {{/if}}

  <footer class="ci-footer">
    <button type="button" data-action="dismiss">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      Close
    </button>
  </footer>
</div>