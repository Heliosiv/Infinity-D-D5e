{
  "id": "infinity-dnd5e",
  "title": "Infinity D&D5e",
  "description": "GM and player toolkit for D&D 5e on Foundry VTT. Generate loot, run merchants, schedule downtime and city actions, track party resources and reputation, consume spell components, and automate Critical Injury Table V2 recovery workflows.",
  "version": "0.3.9",
  "authors": [{ "name": "Heliosiv" }],
